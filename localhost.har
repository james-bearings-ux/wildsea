            "text": "{\r\n  \"ratings\": [\r\n    {\r\n      \"name\": \"Armour\",\r\n      \"description\": \"A measure of your ship's resistance to damage. You'll likely roll your armour rating when a larger creature attacks your ship, when you're fired on by pirates, or when you brute-force the ship through a hazardous area of the sea.\"\r\n    },\r\n    {\r\n      \"name\": \"Seals\",\r\n      \"description\": \"A measure of how well your ship keeps the wildsea out while travelling. You'll likely roll your seals rating when there's a sporestorm, insect swarm, or other potentially invasive presence.\"\r\n    },\r\n    {\r\n      \"name\": \"Speed\",\r\n      \"description\": \"The speed of your ship when the engines are running smoothly. You'll likely roll your speed rating when attempting to outrun a pursuer or weather pattern, or if you somehow find yourself in a race.\"\r\n    },\r\n    {\r\n      \"name\": \"Saws\",\r\n      \"description\": \"How good your ship is at cutting through the denser parts of the sea. You'll likely roll your saws rating when cutting through thicker areas of the sea or trying to ram other ships.\"\r\n    },\r\n    {\r\n      \"name\": \"Stealth\",\r\n      \"description\": \"Your ship's ability to run low, sleek, and undetected. You'll likely roll your stealth rating when trying to minimize the noise of your engine or the trail you leave, or when trying to avoid the notice of distant threats.\"\r\n    },\r\n    {\r\n      \"name\": \"Tilt\",\r\n      \"description\": \"A measure of manoeuvrability, and how well your ship can tackle the sharper dips and rises of the waves. You'll likely roll your tilt rating when tackling one of the larger treetop waves, when diving down into the tangle to evade a pursuer, or when trying to keep steady during a rootquake or storm.\"\r\n    }\r\n  ],\r\n  \"sizes\": [\r\n    {\r\n      \"name\": \"Nano\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Suited for a single sailor and maybe a passenger or two. Perfect for the lone wildsailor, possessed of excess bravery (or a deathwish).\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 1\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Small\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Suited for 2-4 people, cramped but serviceable for double that. Ideal for a first ship.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Standard\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Comfortable for 5-10 people, but can hold double that number if necessary. The majority of ships out on the Wildsea are of standard size, hence the name.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Large\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Can house 10-20 crew with room to spare, many more if necessary, depending on the internal designs and additional fittings. Large ships are most often used to patrol trade-routes around more lawful areas, or to transport settlers and research teams for large factions.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": -1\r\n        }\r\n      ]\r\n    }\r\n  ],\r\n  \"frames\": [\r\n    {\r\n      \"name\": \"Sturdy\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Built to last in a place of temporary things, a sturdy frame helps weather the strongest assaults.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Moulded\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A single unbroken structure running through the ship - quite a feat of safety-conscious engineering.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": 1\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Light\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Made with the lightest possible materials in the smallest possible amounts.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Scything\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Often wedge or blade-shaped, scything frames are constructed specifically to cut as efficiently as possible through the waves.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Saws\",\r\n          \"value\": 1\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Sleek\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Quiet is hard to come by on the wildsea, but a sleek frame ensures that no matter how noisy your bite and engine might be, you'll always be low to the waves.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 1\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Flexible\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Built for adjustability and responsiveness, flexible frames are often multi-segmented or jointed in some way.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 1\r\n        }\r\n      ]\r\n    }\r\n  ],\r\n  \"hulls\": [\r\n    {\r\n      \"name\": \"Reef-Iron\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Metal plating from decommissioned ships, reshaped for your frame. Durable and rust-resistant.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Leviathan Bone\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A hull crafted from one or more pieces of leviathan skeleton. Solid, if a little morbid.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Broadwood\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Wooden planks cut from the more reliable trees of the wildsea. Strong and flexible.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Rough Bark\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Harvested from the ironroots. Irregular and tough to maintain, but easy for others to overlook at distance across the waves.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Chitinous\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Made from the collected shells of the wildsea's larger insects. Smooth, offering little in the way of friction or snags.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Razorscale\",\r\n      \"stakes\": 1,\r\n      \"description\": \"An exterior of interlocking scales sloughed or harvested from a wildsea beast, sharpened for effectiveness.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Saws\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Beastback\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A half-living hull of flesh and bone, flexible and unsettlingly warm.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Ceramic\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A shell of heavy baked clay. Ostentatious and brittle unless *very* carefully maintained.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Chrysalid\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A hull adapted from the cast-off chrysalis of a massive insect, excellent protection against the sea's incursion.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Ghost-Oak\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Pale as death and remarkably flexible, ghost-oak is rarely found growing outside the lightless depths of the drown.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Arachnesque\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Less of a hull and more of a giant insect grown to fit the specifications of your frame, usually something spider-like.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Exile's Copper\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A rare metal that weighs far, far less than it has any right to, prized for racing-ship hulls.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Junk-Strung\",\r\n      \"stakes\": 0,\r\n      \"description\": \"The mark of a ship well-scarred and oft-repaired, a junk-strung hull is barely a hull at all... More a collection of scavenged metal, driftwood, and animal bones; unstable, rusting, and leaky.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": -1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Mark your seals or armour rating to pull a piece of useful salvage from the hull.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Floraflage\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A hull of living vegetation grown purposefully around your frame. Blends easily into the seascape.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 2\r\n        },\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": -1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"A floraflage ship at rest is almost impossible to detect - increase impact when using stealth while motionless.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Monument\",\r\n      \"stakes\": 3,\r\n      \"description\": \"An absurd affectation in a world of flexible branches and endless depth, monument hulls are made of appallingly heavy mountain-stone.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 2\r\n        },\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": 2\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"A ship with a monument hull can't Forge Ahead during a journey.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Husk-Scale\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A flexible, organic hull material made from alchemically altered fruits and mushrooms.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Damage to a ship's Armour and Seals ratings can be repaired using garden-grown specimens, rather than the usual salvage required.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Parasite Planking\",\r\n      \"stakes\": 3,\r\n      \"description\": \"Wood carefully cut from long-used parasite farm branches, treated to resist incoming damage but natural enough that plants can still take root.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Gain two plots on your ship named 'planking rootbeds'. Parasite seeds sown within these plots don't gain the usual extra box on their Grow tracks.\"\r\n      ]\r\n    }\r\n  ],\r\n  \"bite\": [\r\n    {\r\n      \"name\": \"Sawprow\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A wildsea favourite, the sawprow is a chainsaw edge that runs down the curve of the prow. Capable of cutting through most obstructions with ease.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Saws\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive CQ Serrated damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Impellers\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Large jet-like outboard engines that push the ship through the waves with brute force.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive CQ Blast damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Crawler\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Large finger-like mechanisms spread out around the front of the ship, allowing it to move through the waves with a crawling motion.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive CQ Blunt damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Underscales\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Thousands of flexing scales that worm the ship forward with a sly, sinuous motion.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive CQ Keen damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Jag-Tracks\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Motorised grapple tracks along the keel and hull-sides; a slow, solid, and reliable choice.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive CQ Hewing damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Sluicejets\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Pressurised sluice systems filled with phytophobic chemicals, for coating the hull and pushing the ship.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive CQ Acid damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Longjaw\",\r\n      \"stakes\": 2,\r\n      \"description\": \"An underslung chainsaw arrangement that extends from the front of the ship, chewing and pulling forward.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Saws\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive CQ Serrated damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Propeller-Cage\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A cage housing that holds large airboat-style propellers used to push the ship forward.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive CQ Blunt damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Navapede Limbs\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Centipedal limbs lining the hull, letting a ship scuttle through the thrash. If such a vessel could truly now be called a ship, of course.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive CQ Spike damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Voltaic Runners\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Crackling with barely contained lightning, these outboard contraptions let a ship float just above the churning branches of the sea.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": 2\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive CQ Volt damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Mulcher\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Grinding teeth in a lamprey-style mouth. Terribly noisy but dreadfully effective.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Saws\",\r\n          \"value\": 2\r\n        },\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": -1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive CQ Serrated damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Tentaculari\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A living cluster of tendrils or tentacles attached to the ship's hull, carrying it through and across the waves in an unsettlingly alien motion.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 2\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive CQ Salt damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Square Sail\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Taut canvas that relies on a strong breeze, this design harks back to an age of calm, clear waters.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Only effective in favourable winds\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Sleek Sail\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Triangular and manually angled, relying on an attentive crew to catch the right breezes.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Only effective in favourable winds\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Sweat-Sails\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Held low to the waves, unfurled canvases shaped to catch the rising under-canopy heat.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Only effective in warm weather\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Tethered Kites\",\r\n      \"stakes\": 2,\r\n      \"description\": \"An array of kites that catch the stronger winds of the lower air.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 2\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Only effective in favourable winds\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Gecko Sails\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A reinforced multi-sail arrangement designed to tame even the wildest gusts.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Only effective in favourable winds\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Sharpened Prow\",\r\n      \"stakes\": 0,\r\n      \"description\": \"Simple and straightforward, a honed blade running the length of the ship's prow to cut through vegetation.\",\r\n      \"bonuses\": [],\r\n      \"specials\": [\r\n        \"Provides a basic cutting edge, but no motive force. Just about works when paired with oars, but you really should choose something better.\",\r\n        \"Deals massive CQ Keen damage... or it would, if you could get up enough speed.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Beast-Reins\",\r\n      \"stakes\": 1,\r\n      \"description\": \"An arrangement similar to a leash or yoke, allowing well-trained beasts to pull the ship like a chariot.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"When you choose beast-reins, decide what kind of beasts they hold (giant centipedes are a solid choice).\",\r\n        \"A ship with beast-reins doesn't require an engine choice from the next section, but the beasts themselves do require care, feeding, and sleep.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Grappling Array\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Prow-mounted grappling hooks that are fired out to catch on branches and then laboriously wound back in for slow, inexorable progress.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 2\r\n        },\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": -1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"A ship running solely on a grappling array can't Forge Ahead during a journey.\",\r\n        \"Deals massive LR Spike damage.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Threshing Combine\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Rotating blades at the font of the ship, with netting and gathering equipment at their rear.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Saws\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Whenever you Cut a Path, roll a d6. On a 6, you gain a Wild or Rampant seed specimen appropriate for the waves you're passing through.\"\r\n      ]\r\n    }\r\n  ],\r\n  \"engines\": [\r\n    {\r\n      \"name\": \"Chemical Compressor\",\r\n      \"stakes\": 1,\r\n      \"description\": \"The most common engine on the rustling waves, reliably unreliable but extremely easy to fuel.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Fuelled with crushed fruit and insect husks\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Springwork\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Wound exhaustively by hand, springwork engines store and release kinetic energy with surprising efficiency.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Saws\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Fuelled with sweat, labour, and time spent winding\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Parasite Pitcher\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A large pitcher plant coaxed into taking root in an engine housing, vines intermingling with the ship's systems.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Fuelled with organic material (preferably living)\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Steam Piping\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Hellish contraptions of tangled piping, rare chemicals, and scalding steam.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Fuelled with water (the cleaner the better)\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Ratwheel Exchange\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Exactly what you might imagine, a pure transfer of kinetic energy from restless rats to wheel to bite. Ethical engineers tend to give their rats the run of the ship.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"The rats need feeding every now and then, but they're not fussy\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Pulsing Cocoon\",\r\n      \"stakes\": 1,\r\n      \"description\": \"An unknown insect shifts inside, glutting on dreams and spinning them into an ebb of arconautic force. Crews report intensely vivid dreams.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Fueled with the dreams of the crew\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Tamed Hive\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A buzzing organic engine of honeycombs and crawling workers, their movements a complex dance.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Fueled with stolen flowers and unprocessed pollen.\",\r\n        \"Crew can use a task while at sea to gain a resource, 'Fresh Engine-Honey', once per journey.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Reclaimed Burner\",\r\n      \"stakes\": 2,\r\n      \"description\": \"An ancient burner that runs on processed chemical fuel, salvaged from the innards of a pre-verdant ship. Requires excessive ventilation. Don't use this.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 3\r\n        },\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": -1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Runs on processed chemical fuel.\",\r\n        \"Liable to explode if seriously damaged.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Jawbox\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Noisy, wood-fueled engines that create huge clouds of smoke and dust but with minimum chance of flame.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Saws\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": -1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Fueled with wildsea wood\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Solar Compressor\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Made to store, liquefy, and pressurize sunlight.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Naturally fueled on sunny days\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Magnetic Coils\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Spinning cylinders that, ideally, maintain a state of almost perpetual motion.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Fueled with magnetic scrap\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Rope Golem\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A semi-sentient mass of animated ropes running through the rooms and corridors of the ship.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Stealth\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Takes no fuel, but the ropes must be replaced when they begin to fray.\",\r\n        \"Rope golems have an unpredictable will of their own that may manifest at unexpected moments.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Leviathan Heart\",\r\n      \"stakes\": 2,\r\n      \"description\": \"An actual leviathan heart, still beating reflexively, hooked up to the ship. Pumps viscous black fuel through pipes and valves.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Requires no fuel, but in a particularly ominous way.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Ceramic Batteries\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Volt-storing batteries rigged up to regulate and distribute power. Their crackling hum makes nearby insects (and superstitious undercrew) uneasy.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Saws\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Seals\",\r\n          \"value\": 1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Fueled with lightning strikes\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Acid Maw\",\r\n      \"stakes\": 2,\r\n      \"description\": \"An open chemical vat that melts down scrap metal, piping the resulting pressurised slurry around the ship. Potent and almost impossible to interrupt.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Saws\",\r\n          \"value\": 2\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Fueled with salvage and scrap\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Press Piping\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Hardly the most powerful engine around, but one that's extremely easy to fuel for a diligent crew.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Tilt\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Speed\",\r\n          \"value\": 1\r\n        },\r\n        {\r\n          \"rating\": \"Saws\",\r\n          \"value\": -1\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Fuelled with fruit rinds and vegetable skins.\"\r\n      ]\r\n    }\r\n  ],\r\n  \"motifs\": [\r\n    {\r\n      \"name\": \"Transport\",\r\n      \"stakes\": 2,\r\n      \"description\": \"No matter what is happening on the waves, no matter the problems or curiosities its denizens face, there will always be a space for those willing to move passengers from point A to point B. Ships themed around transport will likely have...\",\r\n      \"specials\": [\r\n        \"A clean and professional paint job to attract potential passengers\",\r\n        \"Built-in passenger quarters with varying levels of comfort\",\r\n        \"A sturdily constructed panic room, suitable for holding passengers unwilling to fight in the event the ship is attacked or boarded\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Hauling\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Just as essential as transporting passengers, the movement and trading of cargo is a reliable path to success for dependable types. These ships will likely have...\",\r\n      \"specials\": [\r\n        \"Gangplanks, winches, and bay doors for swift loading and unloading at port\",\r\n        \"An expanded cargo area with extra security and webbing for odd-shaped packages\",\r\n        \"A reliable cargo crane built into the ship's structure for holding and transporting particularly heavy crates and objects\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Hunting\",\r\n      \"stakes\": 2,\r\n      \"description\": \"The oldest wildsea profession, a ship kitted out with a hunting motif will likely have...\",\r\n      \"specials\": [\r\n        \"Trophies of bone, fur, or chitin prominently displayed on the outer hull\",\r\n        \"A modified cargo area complete with animal pens\",\r\n        \"An array of hunting and butchery tools, allowing crew fighting on or below decks easy access to CQ Keen or Spike damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Salvaging\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Useful for scrappers, dredgers, and wreck-wranglers, salvaging ships will likely have...\",\r\n      \"specials\": [\r\n        \"A scratched and dented appearance, making you look almost like a wreck yourself\",\r\n        \"A modified cargo area with work benches and tools for disassembly\",\r\n        \"A grappling crane built into the ship's structure for attaching to large wreckage, allowing it to be hauled onto the deck or towed behind the ship\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Pathfinding\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Pathfinding ships are built with tenacious exploration in mind, and will likely have...\",\r\n      \"specials\": [\r\n        \"Trinkets and gewgaws from various contacted cultures affixed to the hull\",\r\n        \"A reinforced engine room with a secondary set of seals or bulkheads protecting it\",\r\n        \"An array of wilds-clearing tools, allowing crew fighting on or below decks easy access to Hewing or Serrated damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Raiding\",\r\n      \"stakes\": 2,\r\n      \"description\": \"For wildsailors who take to the waves with violence in mind, for noble or not-so-noble reasons. Ships with a raiding motif will likely have...\",\r\n      \"specials\": [\r\n        \"Fortified deck-rails to give the crew cover while shooting (or being shot at)\",\r\n        \"Bulkhead doors that can be closed and locked to isolate boarding parties\",\r\n        \"An armoury lockbox containing weapons taken as spoils from previous encounters, allowing crew fighting on or below decks easy access to Blunt or Blast damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Rescue\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Yours is the kind of ship people call on when other ships don't make it back to port. Ships with a rescue motif will likely have...\",\r\n      \"specials\": [\r\n        \"Emergency medicine for some of the more common maladies of the waves\",\r\n        \"A photoscope for picking out glints of wreckage or distress flares at a great distance\",\r\n        \"An isolation room packed with soft amber resin, for keeping the crew insulated from and slowing the progress of illnesses during a journey\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Research\",\r\n      \"stakes\": 2,\r\n      \"description\": \"The mysteries of the rustling waves are an egg waiting to hatch, and a research vessel is just the right sort of tool to crack them right open. Research ships will likely have...\",\r\n      \"specials\": [\r\n        \"A higher level of general technology on show than average\",\r\n        \"A library for recording new findings and delving into secrets and lore\",\r\n        \"A snapograph arrangement, a complex deck-mounted photography system for catching images of the waves and printing them on light-sensitive paper\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Entertainment\",\r\n      \"stakes\": 2,\r\n      \"description\": \"For actors, musicians, performers, and travelling circuses, those that make their living by entrancing the public. Ships with an entertainment motif will likely have...\",\r\n      \"specials\": [\r\n        \"A gaudy appearance that catches the eye\",\r\n        \"A theatrical stage built into the main deck\",\r\n        \"Costuming supplies for the representation of various creeds and characters\"\r\n      ]\r\n    }\r\n  ],\r\n  \"generalAdditions\": [\r\n    {\r\n      \"name\": \"Anchor System\",\r\n      \"stakes\": 0,\r\n      \"description\": \"Lengths of chain with heavy curved hooks, used to anchor ships to the branches of the Wildsea. Almost every ship comes with this as standard.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Rig-Ropes\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Ropes strung up above the deck for various purposes, often climbed, used as safety lines for trips over the edge of the ship, or hung with drying washing.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Firefly Lanterns\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A network of lanterns, their glowing inhabitants woken or sent to sleep with a tap on the glass, ready to illuminate any part of the ship.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Luminous Blooms\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Patches of moss or flowering plants that shed pale light in the darker hours.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Chemical Spotlight\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Illuminates surrounding areas with day-like clarity.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Survival Station\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Containing flares, flags, grapples, wraps, and emergency rations.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Cargo Crane\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A sturdy crane for loading and unloading cargo, capable of carrying extremely heavy objects without overbalancing the ship.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Wrecker's Magnet\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A curious electromagnetic crane, often used by salvagers. Controls on the crane can increase, decrease, or cut the magnetism entirely.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Signal Flares\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Colour-coded flares meant to be fired up into the heavens to communicate findings, threats, and positioning. At least a smattering of the Signalling language is required to use or understand them effectively.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Shutter-Lamps\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A bank of lights and shutters for blinking visual signals across vast distances. At least a smattering of the Signalling language is required to use or understand them effectively.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Steam Whistle\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A shrill, piercing whistle used to announce your presence or scare the more skittish denizens of the sea.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Vox-Horn\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A deep, blaring horn that can also be used as an effective voice amplifier.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Tethered Kitesail\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A glider tethered to the deck with a long rope, allowing aerial exploration on windy days.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Trained Messengers\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Flying creatures trained to seek out distant landmasses (or nearby ships), deliver messages to them, and return with replies. When choosing trained messengers, specify the type of creature you're using (such as dragonflies or crows).\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Fixed-Band Radio\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A short-range radio system capable of sending and receiving static-laden signals, based on recently rediscovered pre-verdant technology. Allows instantaneous communication, but relies on fragile antennae affixed to the uppermost portion of the ship.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Irrigation Array\",\r\n      \"stakes\": 1,\r\n      \"description\": \"The observant might suggest that this is little more than a series of buckets and pipes jumbled together with leaf-rubber seals. And they'd be right.\",\r\n      \"specials\": [\r\n        \"Arid conditions don't negatively affect plant growth within the ship-garden (unless they last for multiple journeys in a row without access to water).\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Windvane Rabir\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Tailor-made to spin with the winds, producing a musical drone that keeps all but the most unusual garden pests at bay.\",\r\n      \"specials\": [\r\n        \"All plants within your plots have a resistance to insect predation and insect-borne diseases.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Catapault Track\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A spring-loaded section of deck used for catapulting outriders onto the waves at speed. Great for taking other ships by surprise, but the logistics of reloading an outrider for another launch are... tricky.\"\r\n    },\r\n    {\r\n      \"name\": \"Wicker Baskets\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Free-swinging containers that always seem to survive whatever might damage the rest of the ship.\",\r\n      \"specials\": [\r\n        \"All plants grown within the wicker baskets are immune to damage taken by the wider ship (but can still suffer negative effects aimed directly at them).\"\r\n      ]\r\n    }\r\n  ],\r\n  \"bounteousAdditions\": [\r\n    {\r\n      \"name\": \"Fruiting Tree\",\r\n      \"stakes\": 1,\r\n      \"description\": \"An ancient tree rooted to your deck, laden with fast-growing fruit.\",\r\n      \"specials\": [\r\n        \"Automatically acquire a fruit-based specimen when you use a task to tend to the fruiting tree.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Night Farm\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A dark, covered soilpit for growing mushrooms.\",\r\n      \"specials\": [\r\n        \"Automatically acquire a mushroom-based specimen when you use a task to tend to the night farm.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Lightning Rod\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A multi-pronged metal array for attracting lightning and storing it in ceramic batteries.\",\r\n      \"specials\": [\r\n        \"Automatically acquire a charged ceramic battery whenever your ship enters a lightning storm.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Water Purifier\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A funnel filtration system.\",\r\n      \"specials\": [\r\n        \"Automatically acquire a barrel of fresh water with the 'Pure' tag whenever you drop anchor or cut a path in rainy conditions.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Trawler Nets\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Reinforced nets meant to be draped over the sides of the ship during relaxed journeys, catching larger insects and small mammals before they're hauled back in.\",\r\n      \"specials\": [\r\n        \"Automatically acquire one normal specimen when you cut a path.\"\r\n      ]\r\n    }\r\n  ],\r\n  \"rooms\": [\r\n    {\r\n      \"name\": \"Galley\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A space for gathering, cooking, and eating, filled with pans, cookware, and usually a chemical stove.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Medical Bay\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A clean space with tables and soft beds for the wounded and their carers.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Workshop\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A (probably cluttered) room with smithing and repair tools, as well as a mechanical workbench.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Navigational Suite\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A room devoted to the storage and usage of maps, charts, and navigational equipment.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Butchery\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A clean space for rendering and preserving specimens.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Tap-Room\",\r\n      \"stakes\": 1,\r\n      \"description\": \"For the creation, storage, and consumption of ales, mead, and spirits (the alcoholic kind). Usually furnished with comfortable seating, and maybe card tables.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Panic Room\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A small room stocked with salted supplies and bedrolls, able to be triple-locked from the inside and extremely hard to break into.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Cooling Facility\",\r\n      \"stakes\": 1,\r\n      \"description\": \"An insulated room where breath mists in the air, perfect for storing perishables and escaping the sun's glare.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Luxury Quarters\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Individual spaces for each crewmember to sleep, complete with soft furnishings and tasteful decoration.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Lens Room\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A room of telescopes and ocular magnifiers offering a commanding view, a good interior alternative to an observation platform.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Brig\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A hammock. A bucket. A lockable door and a set of iron bars. The cramped conditions of most ships rarely allow for much more.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Cargo Bay Extension\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A larger space with cargo webbing, wall racks, and reinforced sections for more dangerous items.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Underdeck Gymnasium\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A set of weights, ropes, and fitness equipment for keeping yourself in shape without braving the treetops.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Lounger's Tent\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A rest area on the deck of the ship, the canvas providing shade and a break from the wind without being cooped up belowdecks.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Observation Platform\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A strut-like protuberance giving an unparalleled view of the surrounding waves, usually with some kind of line of communication to the pilot's cabin.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Underthrash Platform\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A sturdy door leading to an open platform at the base of the ship, usually at the rear, below the riding-line.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Cupola\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A blister of glass or amber, usually at the side or rear of the ship, with a small seat inside.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Deckside Shed\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Even more cluttered than the average workshop, sheds come stocked with a variety of simple tools used for the maintenance and preparation of ship-garden plots.\",\r\n      \"specials\": []\r\n    },\r\n    {\r\n      \"name\": \"Internal Seed Bank\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A room not only dedicated to safely storing seeds, but to leeching them of crezzerin contamination through painfully slow but reliable methods used by generations of parasite farmers.\",\r\n      \"specials\": [\r\n        \"At the beginning of a journey, choose a single set of seeds with the Wild or Rampant tag. At the end of the journey, those seeds lose their original tag and gain the Parasite tag instead.\"\r\n      ]\r\n    }\r\n  ],\r\n  \"armaments\": [\r\n    {\r\n      \"name\": \"Trebuchet\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Lobs stones, chunks of wood, or salvage clusters.\",\r\n      \"specials\": [\r\n        \"Deals massive LR Blunt damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Harpoon Turret\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Fires barbed spears for piercing the hulls of ships and the hides of larger creatures.\",\r\n      \"specials\": [\r\n        \"Deals massive LR Spike damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Shrapnel Cannon\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Fires clouds of tearing metal, usually just armfuls of scrap offcuts tossed into the barrel.\",\r\n      \"specials\": [\r\n        \"Deals massive LR Serrated damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Viper's Tooth\",\r\n      \"stakes\": 2,\r\n      \"description\": \"An unstable weapon that fires corrosive liquid.\",\r\n      \"specials\": [\r\n        \"Deals massive LR Acid damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Grand Blastbow\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A crossbow-like emplacement that fires explosive bolts.\",\r\n      \"specials\": [\r\n        \"Deals massive LR Blast damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Storm-Rail\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Two huge brass rods wrapped with poorly shielded cables, attached to a voltaic generator.\",\r\n      \"specials\": [\r\n        \"Deals massive LR Volt damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Winch-Claws\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A bank of short-range grappling claws on the sides of your ship, used to draw enemy vessels close for boarding.\",\r\n      \"specials\": [\r\n        \"A tool to aid in close-range encounters rather than a weapon in its own right\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Broadside Cannons\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A blast from the half-forgotten past, these banks of cannons can only fire at targets to either side of you.\",\r\n      \"specials\": [\r\n        \"Deals massive LR Blunt or Blast damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Ramming Prow\",\r\n      \"stakes\": 1,\r\n      \"description\": \"Allows you to ram creatures (and ships) without danger to your own hull.\",\r\n      \"specials\": [\r\n        \"Deals massive CQ Blunt damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Spearing Prow\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A set of reinforced spikes jutting from the front of your ship, for ramming others without danger to your own hull.\",\r\n      \"specials\": [\r\n        \"Deals massive CQ Spike damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Bladed Prow\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A wedge-like cutting edge for slicing into enemy ships without danger to your own hull.\",\r\n      \"specials\": [\r\n        \"Deals massive CQ Hewing damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Ripsaw Prow\",\r\n      \"stakes\": 1,\r\n      \"description\": \"A serrated leading edge for cutting through enemy ships without danger to your own hull.\",\r\n      \"specials\": [\r\n        \"Deals massive CQ Serrated damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Limited Armoury Rack\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A rack stocked with simple weapons.\",\r\n      \"specials\": [\r\n        \"When leaving or defending the ship, crewmembers can take a temporary piece of gear with the LR or CQ tag and a single damage type (either Blunt, Keen or Spike). This temporary weapon comes with a two-track and can't be repaired.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Wrecker's Armoury Rack\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A rack stocked with less straightforward weapons.\",\r\n      \"specials\": [\r\n        \"When leaving or defending the ship, crewmembers can take a temporary piece of gear with the LR or CQ tag and a single damage type (either Hewing, Serrated or Blast). This temporary weapon comes with a two-track and can't be repaired.\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Son of Teeth\",\r\n      \"stakes\": 2,\r\n      \"description\": \"A microwave cannon. Acts as an energy shield when not shooting. Each shot reduces available shield by 1, recharging 1/day.\",\r\n      \"bonuses\": [\r\n        {\r\n          \"rating\": \"Armour\",\r\n          \"value\": 3\r\n        }\r\n      ],\r\n      \"specials\": [\r\n        \"Deals massive LR Salt damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Crezzercannon\",\r\n      \"stakes\": 2,\r\n      \"description\": \"Trying to grow things the old fashioned way? May as well get some use out of all that excess crezzerin...\",\r\n      \"specials\": [\r\n        \"Deals massive LR Toxin damage\"\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Badass Outrider\",\r\n      \"stakes\": 3,\r\n      \"description\": \"A workhorse with overburner and weapon housing. \",\r\n      \"specials\": [\r\n        \"Ratings: Armor 2, Seals 1, Speed 4, Saws 2, Stealth 3, Tilt 2.\",\r\n        \"Deals Massive LR Spike damage.\",\r\n        \"A chemical battery for adding extra power to the engines. Used, hopefully, with great caution.\",\r\n        \"Two personal modifications via workhorse (improved stealth, speed, and tilt).\"\r\n      ]\r\n    }\r\n  ],\r\n  \"undercrew\": {\r\n    \"officers\": [\r\n      {\r\n        \"name\": \"Skillful Officer [3-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"A seasoned wildsailor, likely on the verge of leaving the undercrew and setting out to find a main crew position of their own.\",\r\n        \"specials\": [\r\n          \"2 ranks in any skill\",\r\n          \"1 rank in any other skill\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Well-Travelled Officer [3-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"An eager contributor to discussions and font of lore, wise in the ways of the wider waves.\",\r\n        \"specials\": [\r\n          \"2 ranks in any languages\",\r\n          \"1 rank in any other language\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Experienced Officer [X-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"A seasoned wildsailor, likely on the verge of leaving the undercrew and setting out to find a full crew position of their own.\",\r\n        \"specials\": [\r\n          \"Any one aspect\",\r\n          \"An experienced officer's track is equal to the track of the aspect they have access to\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Howling Scarecrow [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"It's amazing what you can do with old clothes, a stick, and some stuffing. And terrifying what you can achieve by adding a hungry whisper to the mix.\",\r\n        \"specials\": [\r\n          \"All of your plots have resistance to predation from beasts.\"\r\n        ]\r\n      }\r\n    ],\r\n    \"gangs\": [\r\n      {\r\n        \"name\": \"Spear-Fishers [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Tasked with plucking insects and small mammals from the sea as they travel.\",\r\n        \"specials\": [\r\n          \"Automatically acquire one normal specimen when you drop anchor\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Magnet-Fishers [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Laconic scavengers that prefer the comfort of the deckside to the embrace of the waves.\",\r\n        \"specials\": [\r\n          \"Automatically acquire one normal piece of salvage when you drop anchor\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Stargazers [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Sky-watching tale-spinners.\",\r\n        \"specials\": [\r\n          \"Automatically acquire one normal whisper when you drop anchor\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Cartographers [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Navigator-adjuncts tasked with keeping a record of the ship's journeys and surroundings.\",\r\n        \"specials\": [\r\n          \"Automatically acquire one normal chart when you drop anchor\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Deck Engineers [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Tasked with keeping the ship in working condition.\",\r\n        \"specials\": [\r\n          \"Automatically clear one mark from any damaged ship's rating when you drop anchor\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Bonesaw Troupe [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Amateur surgeons eager to keep the crew in some semblance of good health.\",\r\n        \"specials\": [\r\n          \"A single crewmember can heal a mark from any damaged trait or injury when you drop anchor\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Tinker Troupe [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Amateur metalworkers and clothiers, maintaining the crew's possessions as best they can.\",\r\n        \"specials\": [\r\n          \"A single crewmember can repair a mark from any gear when you drop anchor\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Scholars [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Students working on unlocking the mysteries of the sea.\",\r\n        \"specials\": [\r\n          \"You learn a secret of the surrounding waves whenever you drop anchor, supplied by the Firefly\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Marauders [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Rough sorts that take the protection of the ship (and the celebrations after a fight) extremely seriously.\",\r\n        \"specials\": [\r\n          \"They fight in close combat to defend the ship, gaining focus every now and then to deal CQ Blunt, Keen or Spike damage\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Picaros [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Adventurous slingers armed with crossbows, pistols, and blunderbusses.\",\r\n        \"specials\": [\r\n          \"They fight at range to defend the ship, gaining focus every now and then to deal LR Blunt, Keen or Spike damage\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Greenthumbs [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Apprentice agronauts taking their first steps on a journey of ship-based farming. They're not quite ready for more advanced methods, but they're a dab hand at planting.\",\r\n        \"specials\": [\r\n          \"Adding seeds to a ship-garden plot doesn't use a task.\"\r\n        ]\r\n      }\r\n    ],\r\n    \"packs\": [\r\n      {\r\n        \"name\": \"Lemur Pack [3-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"A group of nimble helpers that keep the ship clear of smaller insects.\",\r\n        \"specials\": []\r\n      },\r\n      {\r\n        \"name\": \"Spring-Foxes [3-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"A pod of spring-foxes that dance and leap through the waves around your ship as you travel. Their behaviour can warn of dangers from the deeper canopy.\",\r\n        \"specials\": []\r\n      },\r\n      {\r\n        \"name\": \"A Stretch of Slinks [3-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"Semi-spectral cats usually found in dockyards and spit-city alleyways, ship-born slinks spend most of their time hunting down rats and finding ways to get into the most absurdly awkward spaces.\",\r\n        \"specials\": []\r\n      },\r\n      {\r\n        \"name\": \"A Brace of Hounds [3-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"Perhaps not best friend material, these dogs are at least fiercely protective of their ship (despite having few other uses than comfort and the ability to play a great game of fetch).\",\r\n        \"specials\": []\r\n      },\r\n      {\r\n        \"name\": \"Rig-Ferrets [3-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"Used to tie and untie knots far above deck on ships that evoke the feeling of the old salt sea.\",\r\n        \"specials\": []\r\n      },\r\n      {\r\n        \"name\": \"Whirling Bats [3-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"Lend an appreciably gothic look to your ship from a distance, but are unexpectedly friendly up close.\",\r\n        \"specials\": []\r\n      },\r\n      {\r\n        \"name\": \"Frenzy-Parrot [3-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"Possessed of a shrill and annoying squawk, but tolerated as an early warning system for dangerous predators roaming nearby.\",\r\n        \"specials\": []\r\n      },\r\n      {\r\n        \"name\": \"Trained Pinwolf [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"One of the most dangerous predators of the wildsea, raised from birth to regard a ship as its home and the crew as its pack.\",\r\n        \"specials\": [\r\n          \"They fight in close combat to defend the ship, gaining focus every now and then to deal CQ Blunt, Keen or Spike damage\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Squirrel Flingers [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Tiny but ferocious, a pack of squirrels armed with miniature slings.\",\r\n        \"specials\": [\r\n          \"They fight at range to defend the ship, gaining focus every now and then to deal LR Blunt, Keen or Spike damage\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Geist Octopus [5-Track]\",\r\n        \"stakes\": 3,\r\n        \"description\": \"A little bit of everything in one cool cephalopackage.\",\r\n        \"specials\": [\r\n          \"Once per journey, the geist octopus allows a single crewmember to roll 6d6 in place of their usual dice pool on any task it could conceivably help with\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Dragon-Tail Butterflies [5-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"Butterflies with beautiful, elongated wings. Don't do anything useful, but are regarded by many as a good-luck charm.\",\r\n        \"specials\": []\r\n      },\r\n      {\r\n        \"name\": \"Spider Colony [3-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"Once a tzelicrae, now barely holding it together, a spider colony can achieve little on a ship other than keeping insects and rodents away.\",\r\n        \"specials\": []\r\n      },\r\n      {\r\n        \"name\": \"Glass-Shell Snails [3-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"Crews with glass-shell snails on board learn to tread lightly, especially at night.\",\r\n        \"specials\": []\r\n      },\r\n      {\r\n        \"name\": \"Scorpion Set [3-Track]\",\r\n        \"stakes\": 1,\r\n        \"description\": \"Surly, patient, and venomous, often found sunning themselves on railings or hiding inside boots.\",\r\n        \"specials\": []\r\n      },\r\n      {\r\n        \"name\": \"Medical Mosquitoes [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"An annoyance for sure, but a useful one - carry a symptomless infection that increases a crew's resistance to other infections.\",\r\n        \"specials\": [\r\n          \"Infections and viruses don't naturally transfer from crewmember to crewmember\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Glowbug Parade [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"A horde of fireflies that follow crewmembers around as they traverse decks and corridors.\",\r\n        \"specials\": [\r\n          \"Gives all crew members their own dim lantern-like light while they're on the ship (unless shooed away)\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Mantis Sentries [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Stone-still sentries that let their prey come to them, waiting for the perfect moment to strike.\",\r\n        \"specials\": [\r\n          \"Automatically acquire one normal specimen when you dock at port.\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Rust-Roaches [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Feeding off of rust and metallic impurities, these tenacious little things tend to root out forgotten pieces of scrap for their meals.\",\r\n        \"specials\": [\r\n          \"Automatically acquire one normal piece of salvage when you dock at port.\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Etterescu [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Lurking centipedes that prefer darker places, listening to secrets and fragments of lore.\",\r\n        \"specials\": [\r\n          \"Automatically acquire one normal whisper when you dock at port.\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Library Boatmen [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Spider-like creatures that have a habit of making their homes in discarded paper plucked from the waves.\",\r\n        \"specials\": [\r\n          \"Automatically acquire one normal chart when you dock at port.\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Golden Ladybugs [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"Many years of trial and error have taught these hungry little things to target new-grown weeds above all else.\",\r\n        \"specials\": [\r\n          \"All of your plots have resistance to weeds.\"\r\n        ]\r\n      },\r\n      {\r\n        \"name\": \"Kleptothermic Dromats [3-Track]\",\r\n        \"stakes\": 2,\r\n        \"description\": \"A horde of thumb-sized bats with incredible control over their own body temperature, and the ability to store and expel water to keep their environment suitably stable for their young. Trained to nest within plots.\",\r\n        \"specials\": [\r\n          \"All of your plots have resistance to weather hazards.\"\r\n        ]\r\n      }\r\n    ]\r\n  }\r\n}"
          },
