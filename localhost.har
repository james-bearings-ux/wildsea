            "mimeType": "text/javascript",
            "compression": 0,
            "text": "import.meta.env = {\"BASE_URL\": \"/wildsea/\", \"DEV\": true, \"MODE\": \"development\", \"PROD\": false, \"SSR\": false, \"VITE_SUPABASE_ANON_KEY\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZoYnlmb29sZXNmeG1mbmNoc2F2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjA1ODA2MjUsImV4cCI6MjA3NjE1NjYyNX0.fZc9Sw3q-tM8js0Z3MjEB0kxHMvV5rbNBmdFoFtYEHE\", \"VITE_SUPABASE_URL\": \"https://vhbyfoolesfxmfnchsav.supabase.co\"};/**\r\n * Supabase client configuration\r\n */\r\n\r\nimport { createClient } from \"/wildsea/node_modules/.vite/deps/@supabase_supabase-js.js?v=935ab2ca\";\r\n\r\nconst supabaseUrl = import.meta.env.VITE_SUPABASE_URL;\r\nconst supabaseAnonKey = import.meta.env.VITE_SUPABASE_ANON_KEY;\r\n\r\nif (!supabaseUrl || !supabaseAnonKey) {\r\n  throw new Error('Missing Supabase environment variables. Check your .env file.');\r\n}\r\n\r\nexport const supabase = createClient(supabaseUrl, supabaseAnonKey, {\r\n  auth: {\r\n    persistSession: true,\r\n    autoRefreshToken: true,\r\n  },\r\n  realtime: {\r\n    params: {\r\n      eventsPerSecond: 10\r\n    }\r\n  }\r\n});\r\n\n//# sourceMappingURL=data:application/json;base64,"
