          "content": {
            "size": 145186,
            "mimeType": "application/json",
            "text": "{\r\n  \"Ardent\": [\r\n    {\r\n      \"name\": \"Tough as Nails\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You're a natural survivor. Rolls made to treat or heal an injury you're suffering from treat conflicts as triumphs.\"\r\n    },\r\n    {\r\n      \"name\": \"Ghostsight\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can clearly see spirits and the spectral realm.\"\r\n    },\r\n    {\r\n      \"name\": \"Strong Stomach\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Reduce the impact of poisons, diseases and sickness.\"\r\n    },\r\n    {\r\n      \"name\": \"Ironclad Mind\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You are immune to hallucinations, mesmerics and mental compulsions.\",\r\n      \"damageTypes\": [\r\n        {\r\n          \"category\": \"immunity\",\r\n          \"selectionType\": \"fixed\",\r\n          \"options\": [\r\n            \"Hallucinations\",\r\n            \"Mesmerics\",\r\n            \"Mental compulsions\"\r\n          ]\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Guide My Hands\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Burn to borrow a measure of an ancestor's competency, gaining two ranks in any skill for the duration of a scene, gaining two ranks in any skill for the duration of a scene.\"\r\n    },\r\n    {\r\n      \"name\": \"Sporescarf\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Thickly-woven fibres sealed with tar. Resist the effects of bad air and airborne spores.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"bad air\",\r\n          \"airborne spores\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Pre-Verdant Heirloom\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A vestige of the long-buried past. When you would mark mire you can choose to mark this instead.\"\r\n    },\r\n    {\r\n      \"name\": \"Segmented Torc\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Crafted from reclaimed wreckage, said to hold the luck that others lack. Whenever you gain a temporary benefit, increase that benefit's track by one box\"\r\n    },\r\n    {\r\n      \"name\": \"Ajna\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A stringed instrument designed to be played by a duo, one using a bow and one plucking with spectral fingers. Mark to allow all present to see spirits and the spectral realm for the duration of a song.\"\r\n    },\r\n    {\r\n      \"name\": \"Scimitar\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A curved blade that deals CQ keen damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Machete\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"A trusty blade used as a tool as often as it is a weapon. Deals CQ hewing damage. Increase impact when clearing vegetation with this gear.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Hewing\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Hand Crossbow\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A compact crossbow. Deals LR spike damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Ragged Longcoat\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Keen, Spike, Hewing, Serrated\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Keen\",\r\n          \"Spike\",\r\n          \"Hewing\",\r\n          \"Serrated\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Ancestral Spirit\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"You're haunted by a benevolent spirit. Mark to learn a secret from the spectral realm (once per scene).\"\r\n    },\r\n    {\r\n      \"name\": \"Watch-Wolf\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A loyal lupine companion that will defend you to the death. Deals CQ spike damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Grizzled Ratter\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A sly ship-born feline, adept at pursuing tiny creatures. Mark to create a resource, Hunter's Offering.\"\r\n    },\r\n    {\r\n      \"name\": \"Haughty Grandling\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A possessive ancestor hunched spectrally on your shoulders. The interior of any ship you crew resists wandering spirits while you're on board.\"\r\n    }\r\n  ],\r\n  \"Ektus\": [\r\n    {\r\n      \"name\": \"Towering\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"You stand head and shoulders above most others.\"\r\n    },\r\n    {\r\n      \"name\": \"1000 Needles\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Deal spike damage to any creature that attacks you with their own body in close quarters (such as with tail or bite attacks).\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Iris Blossom\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"You can see heat the way others see colour.\"\r\n    },\r\n    {\r\n      \"name\": \"Heliovore\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Heal a mark of damage on any one of your traits after spending a day in strong sunlight.\"\r\n    },\r\n    {\r\n      \"name\": \"Cactus-Flesh Filtration\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Use a task to give any liquid resource the 'Pure' tag.\"\r\n    },\r\n    {\r\n      \"name\": \"Longspine\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Your body is covered in iron-hard spines that deal CQ spike damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Tar-Scrawl Tattoos\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Resist the effects of bad air and airborne spores.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"bad air\",\r\n          \"airborne spores\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Solid Footing\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Treat conflicts as triumphs when attempting to avoid being tripped, pushed or forcefully moved.\"\r\n    },\r\n    {\r\n      \"name\": \"Grafted Limb\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"An ancient seal of a trade and fealty. Burn to call attention to this trophy and request a favour from another nonhostile ektus - it should not be refused.\"\r\n    },\r\n    {\r\n      \"name\": \"Stone-Bound Histories\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A tattered tome of ancient stories handed down by the eldest ektus survivors of the pre-verdant days. Use a task to gain a sliver of Pre-V information.\"\r\n    },\r\n    {\r\n      \"name\": \"Zephyrskin Drums\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A set of hip-drums decorated with saprekk-influenced patterns. Zephyrskin drums heat the air around them when played.\"\r\n    },\r\n    {\r\n      \"name\": \"Tower Shield\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 5,\r\n      \"description\": \"An immense shield of wood and iron, built to last.\"\r\n    },\r\n    {\r\n      \"name\": \"Wedge-Axe\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A long-handled axe that deals CQ hewing damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Hewing\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Heavy Chakram\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A set of weighty throwing blades, dealing LR keen or hewing damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\",\r\n          \"Hewing\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Desert Harness\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Spike, Hewing, Serrated, Frost, Flame.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Spike\",\r\n          \"Hewing\",\r\n          \"Serrated\",\r\n          \"Frost\",\r\n          \"Flame\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Catekora\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A quilled, fibrous feline with a penchant for firing spines when provoked. Deals LR spike damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Burrowing Bees\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"Flightless desert bees that crawl across your body. You are immune to damage and effects caused by swarms.\"\r\n    },\r\n    {\r\n      \"name\": \"Flexneedle\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Your spines flex in an endless dance. Mark to ascend or descend a difficult surface without rolling, at impressive speed, without using your limbs to climb.\"\r\n    }\r\n  ],\r\n  \"Gau\": [\r\n    {\r\n      \"name\": \"Luminous Patches\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You can shed light at will.\"\r\n    },\r\n    {\r\n      \"name\": \"Unfurling Flare\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"A flexing mantle of myconic flesh that unfurls to increase your physical size. Treat conflicts as triumphs when intimidating smaller targets.\"\r\n    },\r\n    {\r\n      \"name\": \"Camouflage Mottle\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Increase impact when using hiding or moving stealthily in either a natural or urban environment (choose which environment when you take this trait).\"\r\n    },\r\n    {\r\n      \"name\": \"Fungal Tendril\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You have an additional tendril-like limb, allowing you to hold and manipulate more objects than usual.\"\r\n    },\r\n    {\r\n      \"name\": \"Mycofiltration\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"You can see perfectly within sporeclouds, and you resist the effects of bad air and airborne spores.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"bad air\",\r\n          \"airborne spores\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Spore-Sacs\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to obscure your current area with a dense cloud of spores.\"\r\n    },\r\n    {\r\n      \"name\": \"Naturally Hallucinogenic\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Your sheddings have mild psychotropic properties. Mark to create a rare resource, Hallucinogenic Spores.\"\r\n    },\r\n    {\r\n      \"name\": \"Fungal Fortress\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Keen, Hewing, Toxin, Acid, Frost.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Keen\",\r\n          \"Hewing\",\r\n          \"Toxin\",\r\n          \"Acid\",\r\n          \"Frost\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Proliferation\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Burn to grant an ally a copy of any one of your aspects (other than this one) as a temporary benefit. The benefit's track is equal to the original aspect's track.\"\r\n    },\r\n    {\r\n      \"name\": \"Medicine Pouch\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Others rarely ask where the medicines are collected. Use a task to create a rare resource, Medicinal Herbs.\"\r\n    },\r\n    {\r\n      \"name\": \"Nurturing Pitch-Jar\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"A blackened glass jar that holds an eager colony of ironroot mold. Use a task to create a specimen copy of any piece of salvage you own, with the 'fungal' tag.\"\r\n    },\r\n    {\r\n      \"name\": \"Jag-Lash\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A leather cord studded with teeth or salvaged metal. Deals CQ serrated damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Serrated\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Spore-Slinger\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A sling-like contraption for lobbing spore-bombs, dealing LR toxin or blast damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Toxin\",\r\n          \"Blast\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Pangoshroom\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"A slow-moving but well-armoured fungal companion that wants nothing more than to keep you safe.\"\r\n    },\r\n    {\r\n      \"name\": \"Sporehund\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A loyal companion that deals CQ toxin damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Toxin\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Cordysect\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A slow-flying beetle riddled with fungal growths. Mark to gain a burst of dense sensory information from its surroundings, revealing oddities and secrets.\"\r\n    },\r\n    {\r\n      \"name\": \"Mycomelding\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can use a task to absorb spores from the air around you, gaining a single temporary rank in two different skills of your choice. These ranks last until you next use the Mycomelding aspect.\"\r\n    }\r\n  ],\r\n  \"Ironbound\": [\r\n    {\r\n      \"name\": \"Titanic\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"You're an imposing presence, a weight on the world.\"\r\n    },\r\n    {\r\n      \"name\": \"Ghost-Heart\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You count as fluent when communicating with ghosts, spirits and other ironbound, regardless of languages used.\"\r\n    },\r\n    {\r\n      \"name\": \"Monument to Travel\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Whenever you gain a chart, mark to gain a related whisper as well.\"\r\n    },\r\n    {\r\n      \"name\": \"Fruiting Limb\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Use a task to create a resource, Keel-Fruit.\"\r\n    },\r\n    {\r\n      \"name\": \"Attenuate\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Your animating spark can leave your body for a short time, becoming ghost-like and insubstantial but still capable of movement.\"\r\n    },\r\n    {\r\n      \"name\": \"Structural Integration\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Once per journey you may repair a mark of damage on your ship without rolling.\"\r\n    },\r\n    {\r\n      \"name\": \"Vocal Recovery\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can dredge up the voices of sailors long-lost, changing your pitch, tone and accent on a whim. Burn to speak the truth of a lost sailor.\"\r\n    },\r\n    {\r\n      \"name\": \"Spotlight Lantern\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Flameless, but terribly bright nonetheless. Consume a resource as fuel to allow your entire crew to see perfectly in darkness, sporeclouds and general murk.\"\r\n    },\r\n    {\r\n      \"name\": \"Ancient Tar-Seals\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"You're immune to the effects of crezzerin.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"immunity\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"crezzerin effects\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Living Workshop\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Your own wreck-salvaged body contains an array of useful tools - your presence gives an automatic advantage on rolls taken to create temporary gear and machinery to all crewmates.\"\r\n    },\r\n    {\r\n      \"name\": \"Prowhammer\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A ship's prow, refashioned into a massive bludgeoning weapon. Deals CQ blunt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Ornate Cannon\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"A huge ships's cannon loaded with explosive shells. Deals LR blast damage. Increase impact when targeting a horde or swarm of targets.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blast\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Broadwood Carapace\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Keen, Serrated, Acid, Volt.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Keen\",\r\n          \"Serrated\",\r\n          \"Acid\",\r\n          \"Volt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Reef-Iron Plating\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Spike, Hewing, Serrated, Frost, Flame.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Spike\",\r\n          \"Hewing\",\r\n          \"Serrated\",\r\n          \"Frost\",\r\n          \"Flame\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Shipside Symbiote\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"When your ship would take damage to any of its ratings you may mark boxes equal to that damage on this companion instead.\"\r\n    },\r\n    {\r\n      \"name\": \"Sailghast\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"A mass of living canvas capable of flight. Mark to have it tangle around a target, restricting their movement.\"\r\n    },\r\n    {\r\n      \"name\": \"Delver's Drill\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A huge drill, designed for boring through ironroot bark. You cut when attempting deft movements, but can deal high-impact CQ Serrated damage.\"\r\n    }\r\n  ],\r\n  \"Ketra\": [\r\n    {\r\n      \"name\": \"Gelatinous Form\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"You have an inherent weakness to salt damage, but can squeeze and compress your body enough to move through spaces much smaller than expected.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"weakness\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Salt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Sensory Stalks\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"A rare mutation that hones your sight. You can see clearly without light.\"\r\n    },\r\n    {\r\n      \"name\": \"Crawling Pattern\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"The glowing patches on your flesh crawl at your command, even onto others nearby. Mark this track to create a dim but lasting light on you or a nearby target.\"\r\n    },\r\n    {\r\n      \"name\": \"Tunnel-Wise\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Treat conflicts as triumphs when navigating or moving through enclosed areas.\"\r\n    },\r\n    {\r\n      \"name\": \"Whispers in the Dark\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"While in a dimly lit or unlit area, mark to learn a secret from the darkness (once per scene).\"\r\n    },\r\n    {\r\n      \"name\": \"Scrapper Enzymes\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can use salvage as a component when concocting a potion or chemical mixture, no matter its form.\"\r\n    },\r\n    {\r\n      \"name\": \"Voltaic Mantle\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"The tendrils of your mantle crackle with lightning as they strike, dealing CQ volt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Volt\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Driftwood Core\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Spike, Toxin, Frost, Volt.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Spike\",\r\n          \"Toxin\",\r\n          \"Frost\",\r\n          \"Volt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Rebreather Mask\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You have a short supply of clean air you can tap into when you need to, and you also resist the effects of bad air and airborne spores.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"bad air\",\r\n          \"airborne spores\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Climbing Hooks\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Attached to a harness or embedded in your gelatinous flesh. Ignore cut while climbing, as long as you're moving with care.\"\r\n    },\r\n    {\r\n      \"name\": \"Driving-Chain\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A rusted chain from a long-dead machine, now wielded as a weapon dealing blunt damage at CQ or LR.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\"\r\n        ],\r\n        \"range\": \"CQ/LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Scrap-Metal Skeleton\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"The internal structures you've collected can store biovoltaic energy. Use a task to create a resource, Scrap-Bone Battery.\"\r\n    },\r\n    {\r\n      \"name\": \"Old Ore Piercings\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 1,\r\n      \"description\": \"You're immune to the usual effects of crezzerin. Concentrated sources of crezzerin heal rather than harm you.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"immunity\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"crezzerin effects\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Oiljelly\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"A slick, symbiotic slime-like creature bonded with your body.\"\r\n    },\r\n    {\r\n      \"name\": \"Drone Attendant\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 5,\r\n      \"description\": \"A simple punchcard-driven repair construct. Increase impact when repairing or tinkering with other machines.\"\r\n    },\r\n    {\r\n      \"name\": \"Plasmic Form\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Your flesh is malleable and regenerative, even by Ketra standards. Mark Mire to gain a rare resource, Living Protoplasmic Flesh.\"\r\n    }\r\n  ],\r\n  \"Mothryn\": [\r\n    {\r\n      \"name\": \"Dust and Paper\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"Your form is slim, light, and deceptively difficult to land a solid hit on.\"\r\n    },\r\n    {\r\n      \"name\": \"Elegant Wings\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Though most mothryn wings now serve as decoration, yours are uncommonly strong. You can glide with ease, or mark for a short burst of elegant flight\"\r\n    },\r\n    {\r\n      \"name\": \"Scatterscale\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Mark to create a cloud of fine dust that refracts light and distorts perception - your own senses are unaffected\"\r\n    },\r\n    {\r\n      \"name\": \"Thick Fur\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You're weak to Flame, but resist the effects of bad air and airborne spores.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"bad air\",\r\n          \"airborne spores\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Elaborate Beard-Braids\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Your beard is a rich, intertwining mass of fur and braids, perfect for concealing small objects. Burn to gain a new piece of salvage or specimen from within it (that you might conceivably have stashed there).\"\r\n    },\r\n    {\r\n      \"name\": \"Prismatic Antennae\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Dense clusters of sensory fronds grow from your antennae, letting you see clearly without light and through clouds of dust or spores.\"\r\n    },\r\n    {\r\n      \"name\": \"I Used to Know This\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can treat a conflict as a triumph when rolling for an action without a skill adding to your dice pool (once per scene).\"\r\n    },\r\n    {\r\n      \"name\": \"Chaos Dancing\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"A fighting style that makes use of wing-edges and scything kicks. Deals CQ keen or spike damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\",\r\n          \"Spike\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Ceremonial Patterning\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Your wings are a riot of colour and style. Mark to increase impact when trying to impress or convince.\"\r\n    },\r\n    {\r\n      \"name\": \"Marks of Where We've Been\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Chart-like decorations cover your wings and fur. Mark to use this aspect in place of a chart, but only when travelling through an area you've visited before.\"\r\n    },\r\n    {\r\n      \"name\": \"Flowing Fabrics\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Keen, Blast, Acid, Frost, Salt.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Keen\",\r\n          \"Blast\",\r\n          \"Acid\",\r\n          \"Frost\",\r\n          \"Salt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Wing-Studs\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Can be launched like shrapnel with a deft twist, dealing LR blunt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Silkspire Byx\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"A living golem of beautifully spun silks, usually in vaguely lupine shape.\"\r\n    },\r\n    {\r\n      \"name\": \"Tolycat\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"A domesticated felinesque insect that sheds medicinally potent scale-dust. Your entire crew has resistance against infections and diseases.\"\r\n    },\r\n    {\r\n      \"name\": \"Mutterdust\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Your wings vibrate softly, the air around you shimmering with natural dust. This cloud doesn't impede vision, but does allow any individuals within it to communicate silently in any language they know.\"\r\n    }\r\n  ],\r\n  \"Tzelicrae\": [\r\n    {\r\n      \"name\": \"Arachnid Mobility\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"You never cut for difficulty when climbing.\"\r\n    },\r\n    {\r\n      \"name\": \"The Lottery of Skin\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Choose either Ardent, Ektus or Gau. You can pass as a member of this species under casual inspection.\"\r\n    },\r\n    {\r\n      \"name\": \"Ersatz Limbs\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You have one or more additional arms, allowing you to hold and manipulate many objects at once.\"\r\n    },\r\n    {\r\n      \"name\": \"Tremorsense\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"You can feel even the smallest vibrations in the air and ground around you.\"\r\n    },\r\n    {\r\n      \"name\": \"Gossamercraft\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to produce a resource, Silk-Like Web (either dry or sticky).\"\r\n    },\r\n    {\r\n      \"name\": \"Manifold Linguist\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You count as fluent when communicating with intelligent insects, hive-minds and other tzelicrae, regardless of languages used.\"\r\n    },\r\n    {\r\n      \"name\": \"Spiderbite\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You have a set of fangs that can deal CQ toxin damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Toxin\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Shirk the Skin\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"Burn to leave your skin for a short period. When outside your skin you are a mass of moving spiders, and can easily move through small spaces and climb any surface.\"\r\n    },\r\n    {\r\n      \"name\": \"Shroom Hookah\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Keen, Spike, Serrated, Hewing, Toxin.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Keen\",\r\n          \"Spike\",\r\n          \"Serrated\",\r\n          \"Hewing\",\r\n          \"Toxin\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Motley Carapace\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 5,\r\n      \"description\": \"You've incorporated an assortment of discarded armour pieces into your skin.\"\r\n    },\r\n    {\r\n      \"name\": \"Hush-Silk Garments\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Your clothes are woven of fine silk that naturally dampens sound, making even your dramatic movements almost entirely silent.\"\r\n    },\r\n    {\r\n      \"name\": \"Iron Satchel\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A secure, wearable lockbox that can only be opened by a single specific spider within you.\"\r\n    },\r\n    {\r\n      \"name\": \"Blade of Husks\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A ritual weapon made from the chitin of lost colonymembers. Deals CQ keen or salt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\",\r\n          \"Salt\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Swarm-Scout\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A single spider you can send ahead as a scout, allowing you to see and hear at a distance.\"\r\n    },\r\n    {\r\n      \"name\": \"Rogue Doomsayer\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"An unsettled fragment of personality. Mark to request a dark and unbidden (but likely pertinent) thought from the Firefly.\"\r\n    },\r\n    {\r\n      \"name\": \"Bidingweb\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Slim filaments surround you, almost impossible to see. When an event would take you by surprise, mark to hijack focus.\"\r\n    }\r\n  ],\r\n  \"Amberclad\": [\r\n    {\r\n      \"name\": \"Endless Golden Age\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"You didn't age throughout your imprisonment, and you don't seem to be aging now you're free either. A blessing, but a curious one.\"\r\n    },\r\n    {\r\n      \"name\": \"All So Familiar\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Muscle memory takes over. Treat conflicts as triumphs when interacting with newly uncovered pre-Verdant artefacts.\"\r\n    },\r\n    {\r\n      \"name\": \"Unbroken Family Line\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You may have been asleep for hundreds of years, but some of your kin have been thriving. Burn to tie an individual or settlement to your family in some way.\"\r\n    },\r\n    {\r\n      \"name\": \"Ambervein\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You're weak to Blunt damage, but immune to the harmful effects of crezzerin.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"immunity\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"crezzerin effects\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Dream-Dredge\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"There are impressions of a forest-less world, but grasping them is like holding onto a dream. Use a task to gain a sliver of Pre-V information.\"\r\n    },\r\n    {\r\n      \"name\": \"Resokinesis\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to gain a measure of control over sap, resins, and amber.\"\r\n    },\r\n    {\r\n      \"name\": \"Just a Scratch\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to produce a resource, Warm Amber Shards or Dripping Resin.\"\r\n    },\r\n    {\r\n      \"name\": \"Shattered Eye\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Something you usually use to see is broken, ambered and still lingering in sleep. You can see glimpses of a person's recent dreams clinging to them if you concentrate.\"\r\n    },\r\n    {\r\n      \"name\": \"Fragmented Limb\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Cracked and floating just free of your body. When you take this gear, decide whether it deals CQ Blunt, Keen, or Spike damage (you can change this damage type by using a task).\"\r\n    },\r\n    {\r\n      \"name\": \"Heart of Resin\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 1,\r\n      \"description\": \"Burn to create a perfect copy of yourself in living amber and drift into a deep sleep. You control the copy until it dies or you choose to destroy it, upon which time you wake with its memories and experiences as dreams.\"\r\n    },\r\n    {\r\n      \"name\": \"Half-Clogged Firearm\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A double-barreled pre-verdant shotgun, one of the firing chambers hopelessly clogged. Deals LR Blast damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blast\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Shard-Cloak\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 5,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Keen, Spike, Serrated, Hewing, Salt.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Keen\",\r\n          \"Spike\",\r\n          \"Serrated\",\r\n          \"Hewing\",\r\n          \"Salt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Pre-V Pet\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"A faithful friend from the old times that was trapped, and freed, alongside you. Not particularly suited to the wild world, but most likely revelling in it.\"\r\n    },\r\n    {\r\n      \"name\": \"Closer to the Past\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Choose a skill you have zero ranks in. When under the effects of Pressure, this skill has ranks equal to the current Pressure Level (maximum three).\"\r\n    }\r\n  ],\r\n  \"Anchored\": [\r\n    {\r\n      \"name\": \"By a Thread\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 1,\r\n      \"description\": \"Your grip on the world is tentative, but that does come with certain benefits. You are weak to salt and volt damage, but immune to blunt, keen and spike.\",\r\n      \"damageTypes\": [\r\n        {\r\n          \"category\": \"weakness\",\r\n          \"selectionType\": \"fixed\",\r\n          \"options\": [\r\n            \"Salt\",\r\n            \"Volt\"\r\n          ]\r\n        },\r\n        {\r\n          \"category\": \"immunity\",\r\n          \"selectionType\": \"fixed\",\r\n          \"options\": [\r\n            \"Blunt\",\r\n            \"Keen\",\r\n            \"Spike\"\r\n          ]\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Spectral Variance\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to become insubstantial for a short time, allowing you to float and pass through solid objects.\"\r\n    },\r\n    {\r\n      \"name\": \"Mortal Needs\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Though you can do so if you choose, you have no real need to eat, drink, sleep or breathe.\"\r\n    },\r\n    {\r\n      \"name\": \"Ethereal Healing\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"When being healed or having your gear repaired, resources used are not consumed as normal - instead they degrade, giving them a negative tag (if they already have a negative tag, they're consumed as normal).\"\r\n    },\r\n    {\r\n      \"name\": \"Touch of the Beyond\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Once per scene, when your crew gains a resource, you can choose to give it the Spectral tag.\"\r\n    },\r\n    {\r\n      \"name\": \"Geist Hand\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can manipulate nearby objects without touching them, though the heavier they are the harder it is.\"\r\n    },\r\n    {\r\n      \"name\": \"Death Mask\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Some anchored prefer to hide their face, letting the memories of their time among the living fade. Treat conflicts as triumphs when attempting to unnerve or unsettle.\"\r\n    },\r\n    {\r\n      \"name\": \"Siphoning Fork\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Whenever your crew gains a piece of cargo, gain a whisper related to it (or its previous owners) for yourself.\"\r\n    },\r\n    {\r\n      \"name\": \"Phantom Blade\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"The ghost of a sword hovering at your hip. Deals CQ salt damage, and doesn't have to be held to be used.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Salt\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Anchor Fragment\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A smaller piece hewed from a greater whole. Burn to immediately and completely heal any one of your injuries.\"\r\n    },\r\n    {\r\n      \"name\": \"Resonant Tether\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Spirits and the spectral realm become more visible and tangible to your entire crew in your presence.\"\r\n    },\r\n    {\r\n      \"name\": \"Battered Ajna\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A stringed instrument meant to be played in tandem by the living and the dead, but you can play both parts. Empowers nearby spirits when played.\"\r\n    },\r\n    {\r\n      \"name\": \"Tempered Anchor\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 5,\r\n      \"description\": \"Your anchor to the world is reinforced against damage and tampering, a wise move for a fleeting ghost.\"\r\n    },\r\n    {\r\n      \"name\": \"Faithful Spirit\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"Loyal to the grave, and beyond. Mark to ignore the effects of an active mire for the rest of the scene.\"\r\n    },\r\n    {\r\n      \"name\": \"Reavolver\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A six-shooter with permanently empty chambers, smelling of darkness and wandering ghosts. Deals LR Salt damage, and any spirit struck by this weapon is dragged into complete corporeality for a short time.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Salt\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    }\r\n  ],\r\n  \"Ridgeback\": [\r\n    {\r\n      \"name\": \"Barrel-Chested\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"You may not be built fancy, but you are built sturdy.\"\r\n    },\r\n    {\r\n      \"name\": \"Stone Hearted\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Once per scene, increase impact on any successful action taken whilst on ancient ground.\"\r\n    },\r\n    {\r\n      \"name\": \"Search for Omens\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to ask a question and receive an omen to interpret in return (supplied by the Firefly).\"\r\n    },\r\n    {\r\n      \"name\": \"Thick Skin\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Toxin, Cold, Salt, Volt.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Toxin\",\r\n          \"Salt\",\r\n          \"Volt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Crushing Blows\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Your fists and feet are the only weapons you need. They deal CQ blunt and salt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Salt\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Fragments Like Gods\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Whenever you gain a stone-based resource, give it the Sacred tag.\"\r\n    },\r\n    {\r\n      \"name\": \"Archaeodermis\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Your skin (or whatever you have as an outer covering) mimics the mountain you were raised on. You're immune to keen damage, as well as bites and stings from small creatures.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"immunity\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Chipping Tools\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Treat conflicts as triumphs when altering or working with stone or bone\"\r\n    },\r\n    {\r\n      \"name\": \"Leviathan Furs\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"You never mark mire when confronted with an unknown or terrifying beast, no matter the size.\"\r\n    },\r\n    {\r\n      \"name\": \"Ritual Mask\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You can clearly see spirits and the spectral realm.\"\r\n    },\r\n    {\r\n      \"name\": \"Whispering Charm\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Consume a whisper to learn a secret about a nearby individual (supplied by the Firefly).\"\r\n    },\r\n    {\r\n      \"name\": \"Hexed Tooth\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to levitate and control exposed bone.\"\r\n    },\r\n    {\r\n      \"name\": \"Great Beast Horns\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"These might have deep ceremonial meaning, or just cut an impressive silhouette - either way these horns deal CQ spike damage, and you ignore cut when defending yourself against charging opponents.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Shamanic Idol\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Holds a sliver of power from a not-quite-god. Deals LR salt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Salt\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Swift Hawk\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"A surly, vicious bird that can deal LR keen damage. Once per scene, hijack to temporarily blind or distract an attacking opponent.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Mountain Snouter\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"An ill-tempered boar with cruel tusks. Deals CQ spike damage, and is large enough to ride.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Surface Stone\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Not somethign to be worshipped, but most definitely something to be remembered. Burn to reduce the Pressure Level by one.\"\r\n    }\r\n  ],\r\n  \"Rootless\": [\r\n    {\r\n      \"name\": \"Family Ties\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"When you make a discovery during a journey, mark to tie it to your family in some way (such as a blood relative, fleetfamily member or family friend).\"\r\n    },\r\n    {\r\n      \"name\": \"Hull Hearted\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Once per scene, increase impact on any successful action taken whilst aboard a ship you own or crew.\"\r\n    },\r\n    {\r\n      \"name\": \"Wild Words\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to remember a rumour or folktale pertinent to your situation (supplied by the Firefly).\"\r\n    },\r\n    {\r\n      \"name\": \"Needs Must\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You never mark mire for consuming food or drink, no matter the source or condition.\"\r\n    },\r\n    {\r\n      \"name\": \"Born to Sail\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You always know true North, and ignore cut on movement-related actions caused by adverse seas or damage to your ship.\"\r\n    },\r\n    {\r\n      \"name\": \"Sundew Senses\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can instantly identify the presence and potential dangers of nearby predatory plants, no matter how well they're camouflaged.\"\r\n    },\r\n    {\r\n      \"name\": \"Fleetfamily Scarf\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A beautifully made sporescarf passed from traveller to seasoned traveller. You're immune to the effects of bad air and airborne spores.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"immunity\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"bad air\",\r\n          \"airborne spores\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Nomad's Phrasebook\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Whenever you take a montage you can study your phrasebook (in addition to your usual task), gaining a smattering of any one language until your next montage.\"\r\n    },\r\n    {\r\n      \"name\": \"Mechanical Limb\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 5,\r\n      \"description\": \"A rusting prosthetic that feels no pain.\"\r\n    },\r\n    {\r\n      \"name\": \"Fishing Lure\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Add a positive tag to any living specimen you acquire while fishing.\"\r\n    },\r\n    {\r\n      \"name\": \"Patterned Sash\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Treat conflicts as triumphs when using social skills to affect animals.\"\r\n    },\r\n    {\r\n      \"name\": \"Shortspear\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Traditionally used for deckside defence. Deals CQ spike damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Slingshot\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A simple slingshot, loaded with anything from stones to scrap to seeds. Deals LR blunt or blast damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Blast\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Tarscale Armour\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Resist the hazardous effects of crezzerin exposure (searing, hallucinations, mutation).\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"crezzerin effects\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Springfox\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A nimble wildsea vulpine known to dance in the wake of larger ships. Once per journey you may treat the outcome of a watch roll as Peace, no matter the result.\"\r\n    },\r\n    {\r\n      \"name\": \"Ring-Tailed Rabble-Rouser\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"A pugnacious lemur companion with a natural curiosity when it comes to the running of a wildsea vessel.\"\r\n    },\r\n    {\r\n      \"name\": \"Adaptive Ratter\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"A long-whiskered cat with a taste for chitin. The interior of any ship you crew resists insect incursions while you're on board, as does the deck (even without a pressure shell).\"\r\n    }\r\n  ],\r\n  \"Shankling\": [\r\n    {\r\n      \"name\": \"Head for Heights\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You're immune to vertigo, nausea and mire caused by heights and precarious positions.\"\r\n    },\r\n    {\r\n      \"name\": \"Skybridge Step\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"An elegant defensive dance that keeps you out of harm's way.\"\r\n    },\r\n    {\r\n      \"name\": \"High Ground\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Once per scene, increase impact on any successful action taken whilst you have the high ground.\"\r\n    },\r\n    {\r\n      \"name\": \"Rising Meteor\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to sprint up a surface that would usually require you to climb it, even if it's unstable.\"\r\n    },\r\n    {\r\n      \"name\": \"From Bough to Brain\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"Use a task to study a tree (of any size) and learn its secrets, age and condition (supplied by the Firefly).\"\r\n    },\r\n    {\r\n      \"name\": \"Hawksight\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You can see much further and in greater clarity than the typical wildsailor.\"\r\n    },\r\n    {\r\n      \"name\": \"Grappling Hook\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"When the hook is thrown and anchored it allows you to swing over chasms and climb sheer surfaces. Treat conflicts as triumphs when climbing or swinging.\"\r\n    },\r\n    {\r\n      \"name\": \"Glider's Cloak\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You can land safely after any prepared fall.\"\r\n    },\r\n    {\r\n      \"name\": \"Balancing Staff\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Both a weapon and an acrobatic aid. Deals CQ blunt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Raptor's Claw\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A talon-like gauntlet inspired by the hunting patterns of wingless birds. Deals CQ hewing damage, and can be used to make controlled descents down vertical surfaces.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Hewing\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Broadwood Bow\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Exquisitely crafted. Deals LR spike or toxin damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\",\r\n          \"Toxin\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Feathered Mantle\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Serrated, Toxin, Frost, Salt.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Serrated\",\r\n          \"Toxin\",\r\n          \"Frost\",\r\n          \"Salt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Sentinel Skywing\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"A watchful bird, often used for scouting remote areas. Mark to learn a secret of the surrounding waves.\"\r\n    },\r\n    {\r\n      \"name\": \"Bark-Peeling Ferret\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"Expert at routing hidden bugs, even from the mighty ironroots. Mark or use a task to gain an insect specimen from a nearby branch or tree trunk.\"\r\n    },\r\n    {\r\n      \"name\": \"Feathered Raptor\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A beautifully-feathered lizard, the result of generations of careful breeding to engender a modicum of sociability (still not quite there yet). Deals CQ hewing damage, and is large enough to ride.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Hewing\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Flutter-Lamps\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A set of moth-lanterns on a string, carrying both light and cheer to fight the encroaching dark. Sheds a gentle glow, and nearby crew ignore any mire that would be marked due to darkness (living or otherwise).\"\r\n    }\r\n  ],\r\n  \"Spit-Born\": [\r\n    {\r\n      \"name\": \"Pit-Fight Survivor\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"You learnt how to take a beating and stay standing.\"\r\n    },\r\n    {\r\n      \"name\": \"Urban Exploration\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to discover a friendly lead on services or information when in a port or city.\"\r\n    },\r\n    {\r\n      \"name\": \"Cobble Hearted\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Once per scene, increase impact on any successful action taken whilst in a port or city.\"\r\n    },\r\n    {\r\n      \"name\": \"Every Street Tells a Story\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to learn a secret of a port or city you're docked at.\"\r\n    },\r\n    {\r\n      \"name\": \"Through the Throng\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Treat conflicts as successes when moving through crowds, herds and swarms.\"\r\n    },\r\n    {\r\n      \"name\": \"Shrewd Marketeer\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Treat conflict as triumphs when haggling over an exchange of cargo or resources.\"\r\n    },\r\n    {\r\n      \"name\": \"Spit & Polish\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Use a task to remove a negative tag (such as rusted or broken) from any piece of salvage.\"\r\n    },\r\n    {\r\n      \"name\": \"Life of Scraps\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"When gaining a benefit from a meal or alchemical concoction, ignore any associated negative effects.\"\r\n    },\r\n    {\r\n      \"name\": \"Scrutineer Eyepiece\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"You can tell a fake, forgery or counterfeit item at a glance.\"\r\n    },\r\n    {\r\n      \"name\": \"Acrid Long-Stem\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A spice-filled pipe made to burn its contents with acid rather than flame. Injury tracks you become subject to are one box shorter than normal.\"\r\n    },\r\n    {\r\n      \"name\": \"Docker Threads\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Resist the hazardous effects of crezzerin exposure (searing, hallucinations, mutation).\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"crezzerin effects\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Brass Knucle\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A brute but reliable weapon for street fights. Deals CQ blunt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Black-Market Pistol\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A firearm sourced from unsavoury types. Deals LR blast damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blast\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Trained Ratroach\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 1,\r\n      \"description\": \"A gutter-scavenger by nature, now working on your behalf. Once per montage gain a small salvage or specimen resource with a negative tag (in addition to your usual task).\"\r\n    },\r\n    {\r\n      \"name\": \"Calico Slink\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A semi-spectral cat winds its way around your legs. You have the ability to see clearly without light.\"\r\n    },\r\n    {\r\n      \"name\": \"Pangopod\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"Half pangolin, half squid. Surprisingly cute.\"\r\n    },\r\n    {\r\n      \"name\": \"Pilferer\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Whenever your crew gains a piece of cargo, gain a resource related to it for yourself (either salvage or specimen, whichever is most appropriate).\"\r\n    }\r\n  ],\r\n  \"Alchemist\": [\r\n    {\r\n      \"name\": \"Component Scrounger\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"When one of your crewmates acquires an alchemically useful specimen, gain a copy of that specimen for yourself (once per scene).\"\r\n    },\r\n    {\r\n      \"name\": \"Alchemical Unearthing\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Whenever you discover a new location, choose a unique property (represented by a tag) to be easily found on specimens or salvage there.\"\r\n    },\r\n    {\r\n      \"name\": \"Ulcerous Alembic\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You can swallow two alchemical components, keeping them safely in your stomach. You can concoct them internally when you choose, benefitting immediately from the results or spitting the resulting solution out.\"\r\n    },\r\n    {\r\n      \"name\": \"The Old Ways\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Increase impact when concocting using only bone, organs or insect parts as components.\"\r\n    },\r\n    {\r\n      \"name\": \"Pestle-Pound\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Use a task to grind a specimen into a powder, changing its form to a dust or salt and giving it the 'Pure' tag.\"\r\n    },\r\n    {\r\n      \"name\": \"Baseline\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to briefly ignore any positive or negative effects stemming from a temporary benefit or injury. You are always immune to the negative effects of crezzerin.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"immunity\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"crezzerin effects\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Heady Vapours\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Mark to ruminate on a question and receive a confusing yet accurate answer. Burn instead to receive instant clarity from that answer.\"\r\n    },\r\n    {\r\n      \"name\": \"Chemicokinesis\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to levitate and control impure liquids.\"\r\n    },\r\n    {\r\n      \"name\": \"Metabolize\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Consume a specimen to gain a brief burst of sensory information related to the specimen consumed (such as tremorsense by consuming a spider's web, for example).\"\r\n    },\r\n    {\r\n      \"name\": \"Catalyst Belt\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A heavy work-pack containing reagents and catalysts, tried and tested. Mark to use a chemical from the belt in place of a specimen when concocting.\"\r\n    },\r\n    {\r\n      \"name\": \"Explosive Vials\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Not an endless supply, but potent and disorienting. Mark to deal LR blast, salt, acid or toxin damage to multiple nearby foes.\"\r\n    },\r\n    {\r\n      \"name\": \"Dilution Agent\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"When you create a concoction, the entire crew can gain the benefit it offers as a one-track temporary aspect.\"\r\n    },\r\n    {\r\n      \"name\": \"Pressure-Sealed Linkage\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Treat conflicts as triumphs when using at least one liquid as a resource for a concoction.\"\r\n    },\r\n    {\r\n      \"name\": \"Accelerant Vial\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Consume an additional specimen to create a lasting concoction as an action (rather than the usual task).\"\r\n    },\r\n    {\r\n      \"name\": \"Living Liquid\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"Winds its way around your form, studded with broken glass. Deals CQ acid or keen damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Acid\",\r\n          \"Keen\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Syringiosquito\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"A diminutive alchemical construct designed to hold and drain fluids without being detected.\"\r\n    },\r\n    {\r\n      \"name\": \"Extraction Techniques\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Consume a crezzer-tainted specimen. In its place you gain two new specimens, the first a sample of Extracted Crezzerin, and the second based on the remains of the consumed resource.\"\r\n    },\r\n    {\r\n      \"name\": \"Broke-Mirror Mist\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Burn to spread a perception-altering clous through your current area for the duration of a scene that prevents cut results being counted for Scrutiny. Individuals in this cloud also gain resistance against precise incoming attacks, but cut when targeting their own attacks.\"\r\n    }\r\n  ],\r\n  \"Char\": [\r\n    {\r\n      \"name\": \"Only the Best\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Mark when gathering a specimen to give it the 'Pure' tag.\"\r\n    },\r\n    {\r\n      \"name\": \"Ingredient Scrounger\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"When one of your crewmates acquires a potentially delicious specimen, gain a copy of that specimen for yourself (once per scene).\"\r\n    },\r\n    {\r\n      \"name\": \"Golden Nose\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to identify a rare ingredient in your vicinity by scent alone.\"\r\n    },\r\n    {\r\n      \"name\": \"Bountiful Discovery\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Whenever you discover a new location, choose a single specimen type to be easily found there.\"\r\n    },\r\n    {\r\n      \"name\": \"Deep in the Barrel\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Increase impact when cooking with rotten or otherwise tainted ingredients. Meals made with these ingredients won't sicken your crew.\"\r\n    },\r\n    {\r\n      \"name\": \"Enough for Everybody\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"When you create a lasting meal the entire crew can gain the benefit it offers as a one-track temporary aspect.\"\r\n    },\r\n    {\r\n      \"name\": \"Taste Test\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You're immune to poisons, and can determine their presence and characteristics by taste alone.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"immunity\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"poisons\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Acid-Etched Cookpot\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 5,\r\n      \"description\": \"A hefty pot of near-unbreakable construction, used to prepare and store food or hide under in a tense situation.\"\r\n    },\r\n    {\r\n      \"name\": \"Mechanical Grinder\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Consume an additional specimen to create a lasting meal as an action (rather than the usual task).\"\r\n    },\r\n    {\r\n      \"name\": \"Flavour Engineer\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can treat salvage as specimens when creating meals. The results are still oddly edible.\"\r\n    },\r\n    {\r\n      \"name\": \"Spice Bandoleer\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A bandoleer containing your own secret blend of spices that never seems to run dry. Mark to create a rare resource, either Wilds Pepper, Hangman's Blend or Smouldergrit.\"\r\n    },\r\n    {\r\n      \"name\": \"Trademark Herbs\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"The right seasoning can make anything taste good. Mark to treat conflict results as triumphs while cooking..\"\r\n    },\r\n    {\r\n      \"name\": \"Seasoned Cleaver\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"As useful on the battlefield as it is in the galley. Deals CQ hewing damage. Increase impact when acquiring dangerous or disruptive specimens.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Hewing\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Reef-Iron Pan\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A colossal implement. Deals CQ blunt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Husk-Leather Apron\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Toxin, Acid, Blast, Salt, Flame.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Toxin\",\r\n          \"Acid\",\r\n          \"Blast\",\r\n          \"Salt\",\r\n          \"Flame\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Sous Squirrel\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"A red-furred bundle of activity. Once per montage gain a common insect specimen appropriate to the region (in addition to your usual task).\"\r\n    },\r\n    {\r\n      \"name\": \"The Only Knife\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Shaped, honed, perfectly balanced. Deals CQ Keen damage, and lets you increase impact when creating a dish using raw meat. Raw meat dishes prepared in this way never sicken you or your crewmembers.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    }\r\n  ],\r\n  \"Corsair\": [\r\n    {\r\n      \"name\": \"Steel-Step Dance\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"The key to survival is mobility. They can't hurt you if they can't hit you.\"\r\n    },\r\n    {\r\n      \"name\": \"Stamp-Down Samba\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"The key to survival is solidity. You can take whatever they throw your way and stay standing.\"\r\n    },\r\n    {\r\n      \"name\": \"Dirty Fighter\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Treat conflicts as triumphs when attempting to trip, knock down, blind or stun opponents.\"\r\n    },\r\n    {\r\n      \"name\": \"Surgical Strike\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can target attacks precisely (such as when aiming for a weak point) without cutting for difficulty.\"\r\n    },\r\n    {\r\n      \"name\": \"Prowess\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to increase impact when attacking at close quarters.\"\r\n    },\r\n    {\r\n      \"name\": \"Dangersense\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to hijack focus from a trap or ambush as it triggers.\"\r\n    },\r\n    {\r\n      \"name\": \"Chain Attack\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You can deal damage to multiple nearby opponents with a successful CQ attack.\"\r\n    },\r\n    {\r\n      \"name\": \"Scars That Tell Stories\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to gain a whisper based on damage or an injury you've just taken, supplied by the Firefly\"\r\n    },\r\n    {\r\n      \"name\": \"Protective Beacon\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 5,\r\n      \"description\": \"Treat conflicts as triumphs when attempting to prevent harm being done to a member of the undercrew.\"\r\n    },\r\n    {\r\n      \"name\": \"Berserker\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You're immune to mire while in combat, or any mire that would be caused by witnessing violence.\"\r\n    },\r\n    {\r\n      \"name\": \"Flashpowder Pouches\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Shake gently to produce temporary torchlight, or mark to produce a blinding flash.\"\r\n    },\r\n    {\r\n      \"name\": \"Corsair's Sabre\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A classic wildsea blade. Deals CQ keen damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Boarding Axe\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"A savage weapon used to chop through foes. Deals CQ hewing damage. Increase impact when attacking ships, objects and structures.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Hewing\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Slinghammer\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A versatile weighted hammer with a fabric tether. Deals blunt damage at CQ or LR.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\"\r\n        ],\r\n        \"range\": \"CQ/LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Throwing Knives\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Perfectly weighted. Deals LR keen or spike damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\",\r\n          \"Spike\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Dragonfly Mantle\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Keen, Spike, Hewing, Blast.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Keen\",\r\n          \"Spike\",\r\n          \"Hewing\",\r\n          \"Blast\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Hooded Crow\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A loyal bird trained to distract opponents in close-range combat. Mark to hijack focus from a nearby enemy as they attempt to attack, once per scene.\"\r\n    },\r\n    {\r\n      \"name\": \"Metzaka Feathers\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A feathered charm made from the remains of a spectral crow. When wrapped around the hilt of a CQ weapon, it allows that weapon to deal LR damage instead. It can also deal damage without being physically held, freeing your hands for other tasks.\"\r\n    },\r\n    {\r\n      \"name\": \"Comet-Forged Sabre\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 1,\r\n      \"description\": \"A fragile blade made for precise, debilitating strikes. Deals CQ Keen damage. When attacking, a triumph allows you to reduce a slashed target's immunity or resistance to a single type of damage by one step.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    }\r\n  ],\r\n  \"Crash\": [\r\n    {\r\n      \"name\": \"Thick Skin\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"A history of breaking yourself while breaking other things has toughened you up.\"\r\n    },\r\n    {\r\n      \"name\": \"Zero Days\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Once per scene, ignore any damage to yourself that comes as a result of your own destructive actions.\"\r\n    },\r\n    {\r\n      \"name\": \"The Seam Bear Secrets\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Ancient buildings remember. Receive a whisper when you destroy an ancient structure.\"\r\n    },\r\n    {\r\n      \"name\": \"Load-Bearing Wall\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Use a task to identify hidden elements essential to the integrity of a structure.\"\r\n    },\r\n    {\r\n      \"name\": \"Cannonball Dreams\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You jump headfirst into destruction. Literally. You can use your own body as a projectile, dealing LR Blunt damage. You end up wherever you land.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Padded Boilersuit\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Spike, Hewing, Blast, Volt.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Spike\",\r\n          \"Hewing\",\r\n          \"Blast\",\r\n          \"Volt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Broken Points\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Increase impact when you break something as a show of strength or intimidation.\"\r\n    },\r\n    {\r\n      \"name\": \"Crude Tools\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Your solutions may not be clever, but they work. You may use the Break skill to construct simple tools.\"\r\n    },\r\n    {\r\n      \"name\": \"Canis Box Detonator\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A simple detonator used to set off explosives from a (presumably) safe distance.\"\r\n    },\r\n    {\r\n      \"name\": \"Crash Mask\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"A mask favoured by those who work in dusty environments. You can see clearly through dust and smoke, and resist the effects of spores and bad air.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"airborne spores\",\r\n          \"bad air\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Baby Bombs\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Handheld explosives waiting to be thrown. Deals LR Blast damage to multiple nearby targets at once.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blast\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Demolisher\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"An over-sized weapon, usually a hammer or pickaxe. Deals CQ Blunt or Spike damage. Increase impact when destroying architecture.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Spike\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Wrecker's Globe\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A large, heavy ball on the end of a chain. Deals CQ Blunt damage. Useful for knocking foes back.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Torteaver\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"A small creature with a hard shell known for gnawing through wood and stone.\"\r\n    },\r\n    {\r\n      \"name\": \"Burrowhip Colony\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"A small colony of burrowing insects. Mark to weaken a structure without destroying it.\"\r\n    },\r\n    {\r\n      \"name\": \"Blitceros\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A quadruped large enough to be ridden. Tends to bring down barriers by charging into them horn-first.\"\r\n    },\r\n    {\r\n      \"name\": \"The Joy of Direct Paths\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Whenever your ship rams or cuts through a particularly difficult obstacle using a ratings roll, you gain a piece of salvage or specimen with the Broken tag related to the obstacle.\"\r\n    },\r\n    {\r\n      \"name\": \"Torpedo Mallet\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Yes, this was once an armament for a submersible. No, there really aren't many safety precautions in place. Deals CQ Blunt or Blast damage, or burn to deal Massive CQ Blast damage to multiple nearby targets (including yourself).\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Blast\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    }\r\n  ],\r\n  \"Dredger\": [\r\n    {\r\n      \"name\": \"Seared Skin\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Resist the hazardous effects of crezzerin exposure (searing, hallucinations, mutation).\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"crezzerin effects\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Master Salvager\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 1,\r\n      \"description\": \"Add a positive tag of your choice to any salvage you acquire from wrecks, reefs and ruins.\"\r\n    },\r\n    {\r\n      \"name\": \"Mental Catalogue\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to discern the use or history of something ancient.\"\r\n    },\r\n    {\r\n      \"name\": \"Lurid Cartography\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can use charts to find shipwrecks and disasters as well as the usual islands and oddities.\"\r\n    },\r\n    {\r\n      \"name\": \"Devil May Care\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Treat conflicts as triumphs when avoiding traps and environmental hazards.\"\r\n    },\r\n    {\r\n      \"name\": \"Arborafathometer\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A complex depth-gauge for measuring your precise distance from the Darkness-Under-Eaves. Increase your ship's Tilt rating by one when you're aboard\"\r\n    },\r\n    {\r\n      \"name\": \"Scrounge\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Whenever your crew gains a piece of cargo, gain a resource (likely salvage, but perhaps a specimen or whisper) related to that cargo for yourself.\"\r\n    },\r\n    {\r\n      \"name\": \"Cramped Conditioning\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"Ignore cut that would be imposed for taking actions in enclosed or architecturally unstable spaces.\"\r\n    },\r\n    {\r\n      \"name\": \"Silkwire Coil\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A near-unbreakable coil of thick wire that is somehow soft to the touch. Can be re-coiled with a simple flick after being unwound.\"\r\n    },\r\n    {\r\n      \"name\": \"Amber Lenses\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Goggles that allow you to see perfectly through smoke, mists and sporeclouds.\"\r\n    },\r\n    {\r\n      \"name\": \"Moth Lantern\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Uses luminous moths to illuminate a small area around you.\"\r\n    },\r\n    {\r\n      \"name\": \"Springheel Boots\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to make a prodigious leap and land safely without having to roll.\"\r\n    },\r\n    {\r\n      \"name\": \"Tomb Hammer\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"As much a tool as it is a weapon. Deals CQ blunt damage. Increase impact when smashing stonework and structures.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Key-Tail Scorpion\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"A curious little beast with a skeleton-key stinger. Once per scene you may open any mundane lock.\"\r\n    },\r\n    {\r\n      \"name\": \"Sanctipede\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"Drawn to history and forgotten things. Consume a chart to identify and retrieve a piece of ancient and valuable salvage in your vicinity if possible.\"\r\n    },\r\n    {\r\n      \"name\": \"Tickerclick\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"A punchcard intelligence in a noisy construct body, the whirring and clanking of this mouse-like companion is useful for drawing attention away from your position.\"\r\n    },\r\n    {\r\n      \"name\": \"Arc Lamp\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A bright source of directed light. Mark to overcharge the lamp, allowing it to deal LR Salt damage for the duration of a scene.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Salt\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Roving Shadow\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"Something intangible from the depths treats your shadow as a home. Burn to detach your shadow, sending it ahead to explore for you for a brief time. Your shadow has no weight or thickness, but can't stand bright light.\"\r\n    }\r\n  ],\r\n  \"Hacker\": [\r\n    {\r\n      \"name\": \"Scars Remember\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"The wildsea teaches harsh, but useful, lessons.\"\r\n    },\r\n    {\r\n      \"name\": \"Trailblazer\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Increase impact when finding routes and clearing paths through vegetation.\"\r\n    },\r\n    {\r\n      \"name\": \"Living Antidote\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Use a task to create a rare resource, Pure Spit or Pure Sweat.\"\r\n    },\r\n    {\r\n      \"name\": \"Wild Harvest\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Treat conflicts as triumphs when attacking or defending against plant-type hazards.\"\r\n    },\r\n    {\r\n      \"name\": \"Crezzercomo\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to become undetectable to plant-type hazards and creatures for the duration of a scene.\"\r\n    },\r\n    {\r\n      \"name\": \"Hard-Won Instincts\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can tell which branches will break and which will hold at a glance. Increase your ship's Saws rating by one when you're aboard.\"\r\n    },\r\n    {\r\n      \"name\": \"Petalcrusher\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You ignore mire caused by plant-based hazards and horrors, and are resistant to acids, toxins and hallucinatory effects caused by predatory plants\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Acid\",\r\n          \"Toxin\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Rusting-Leaf Ale\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Becomes more flavourful the more it gets jostled and shaken. Whenever you gain a benefit from a concoction or meal, increase its track by two boxes.\"\r\n    },\r\n    {\r\n      \"name\": \"Grappling Chain\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Designed to find quick purchase in bark and boughs. treat conflicts as triumphs when traversing the sea.\"\r\n    },\r\n    {\r\n      \"name\": \"Chemical Censer\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to create a small area of smoke that repels insects and lowers visibility.\"\r\n    },\r\n    {\r\n      \"name\": \"Wavestrider Jacket\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Resist the hazardous effects of crezzerin exposure, insect bites and poisons.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"crezzerin effects\",\r\n          \"bites and stings\",\r\n          \"poisons\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Jagserry\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"The archetypal hacker weapon, a sawtooth sabre that deals CQ hewing or serrated damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Hewing\",\r\n          \"Serrated\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Sawtooth Chakram\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A set of sharpened circular blades made for throwing, dealing LR keen or serrated damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\",\r\n          \"Serrated\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Defoliant Grenades\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Explosive packets that burst when lobbed with force. Deals LR acid or salt damage\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Acid\",\r\n          \"Salt\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Gyrewing Moths\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 5,\r\n      \"description\": \"A trained swarm of ragged insects. Burn to neutralize the effects of bad air and airborne spores for your crew for the rest of a scene.\"\r\n    },\r\n    {\r\n      \"name\": \"Prow-Nose Porcupine\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"Not the easiest creature to pet, but you learn to live with it. Ignore cut caused by pain or discomfort.\"\r\n    },\r\n    {\r\n      \"name\": \"Mockserry\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"A blade that looks like a normal jagserry, until it unfolds with an insectile shudder. Deals CQ Serrated damage, and allows the wielder to detect the smallest vibrations in the ground and air around them.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Serrated\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Gnashing Sawskull\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"For the hands-off hacker, this grisly spectral relic of some unnamed undercanopy predator has teeth strong enough to turn wood to splinters. Deals CQ Hewing damage, with increased impact while under Pressure.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Hewing\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    }\r\n  ],\r\n  \"Horizoneer\": [\r\n    {\r\n      \"name\": \"First Impressions\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Increase impact when communicating with an individual for the first time.\"\r\n    },\r\n    {\r\n      \"name\": \"Silver Tongue\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"When communicating with a friendly individual in their natural language treat conflict results as triumphs.\"\r\n    },\r\n    {\r\n      \"name\": \"Hyperadaptive\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to learn a smattering of any language you hear and have no ranks in. This knowledge remains until you choose to mark and replace it with a new language.\"\r\n    },\r\n    {\r\n      \"name\": \"Wealth of Knowledge\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Consume a whisper to learn a secret of the sea.\"\r\n    },\r\n    {\r\n      \"name\": \"Nothing Stays Buried\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to identify a hidden or forgotten space in your vicinity by gut feeling alone.\"\r\n    },\r\n    {\r\n      \"name\": \"Bait Bandoleer\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Intoxicating to certain species. Treat conflicts as triumphs when trying to distract, divert or drive off a wildsea creature.\"\r\n    },\r\n    {\r\n      \"name\": \"Open Hands, Open Hearts\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Whenever you or your crew successfully defuse a situation that was heading toward a fight, clear a mark of mire.\"\r\n    },\r\n    {\r\n      \"name\": \"Exports Tell Stories\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Whenever your crew gains a piece of cargo, gain a whisper related to that cargo for yourself.\"\r\n    },\r\n    {\r\n      \"name\": \"Watch and Learn\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Use a task to tag along with one of your crewmates, gaining a temporary rank in any skill they display. This rank lasts until you next use watch and learn.\"\r\n    },\r\n    {\r\n      \"name\": \"Spike Wine\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"An ektus delicacy that sharpens the palette. Whenever you or a crewmate gains a benefit from a meal or beverage, increase the track for tha benefit by one box.\"\r\n    },\r\n    {\r\n      \"name\": \"Tuning Fork\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Once per scene increase impact when engaged in a performance of some kind.\"\r\n    },\r\n    {\r\n      \"name\": \"Padded Gauntlet\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Used to help train the wild creatures of the sea. You're resistant to bite attacks, no matter the damage type.\"\r\n    },\r\n    {\r\n      \"name\": \"Sheaf of a Hundred Stories\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Gain a whisper whenever you encounter a spectacle, horror or new port during a journey\"\r\n    },\r\n    {\r\n      \"name\": \"Bundled Correspondence\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"When you enter a new port, mark to find a friendly contact you've exchanged letters with in the past\"\r\n    },\r\n    {\r\n      \"name\": \"Sturdy Instrument\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Anything from a guitar to maracas, a hip drum to an accordion, a sitar to an ocarina. Can be played, but also acts as a CQ blunt weapon in a pinch\"\r\n    },\r\n    {\r\n      \"name\": \"Worth Telling Twice\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"When a crewmate or opponent uses a whisper, take a single word from it and start a 3-box Project track, marking the first box. If you already have an existing project track from this trait, add the chosen word and mark another box. When all three boxes are marked, gain the three collected words as a new whisper.\"\r\n    },\r\n    {\r\n      \"name\": \"Wavecutter's Ravito\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 1,\r\n      \"description\": \"A beautiful long-necked instrument, the tones of which bring to mind calming memories of the rustling waves. Burn to reduce the Pressure level by one, or to clear a mark or burn from a watchful eye.\"\r\n    }\r\n  ],\r\n  \"Hunter\": [\r\n    {\r\n      \"name\": \"Ghost of the Wilds\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Choose either wild or urban areas. You leave barely any trace, and are almost impossible to track, when moving through your chosen area.\"\r\n    },\r\n    {\r\n      \"name\": \"From Nowhere\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Increase impact when attacking from a hidden position, or attacking an unaware target.\"\r\n    },\r\n    {\r\n      \"name\": \"Whisper on the Wind\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Consume a whisper to gain cryptic information on a target's whereabouts and actions.\"\r\n    },\r\n    {\r\n      \"name\": \"Bloodhound\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Your sense of smell is highly developed, allowing you to hunt and track by scent alone.\"\r\n    },\r\n    {\r\n      \"name\": \"Running Quiet\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Your guidance allows your vessel to keep a lower profile, disturbing fewer creatures and leaving less of a tell-tale trail. Increase your ship's Stealth rating by one when you're aboard.\"\r\n    },\r\n    {\r\n      \"name\": \"Rare Musk\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Collected from sleeping leviathans, apparently. Burn to drive a beast or insect of the waves into an intense instictual behaviour (such as fear, hunger or frenzy).\"\r\n    },\r\n    {\r\n      \"name\": \"Slacker's Line\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"A fishing rod designed to be left unattended. Once per journey gain a live specimen appropriate to the area you're travelling through.\"\r\n    },\r\n    {\r\n      \"name\": \"Butchery Kit\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You can butcher dangerous specimens without risk or cutting for difficulty, and increase impact when gathering resources from a creature you've hunted.\"\r\n    },\r\n    {\r\n      \"name\": \"Snare Set\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Count conflicts as triumphs when readying traps, snares or ambushes.\"\r\n    },\r\n    {\r\n      \"name\": \"Venomous Trophy\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Use a task to create a resource, Paralyzing Venom.\"\r\n    },\r\n    {\r\n      \"name\": \"Masterwork Leathers\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"When you take this trait choose either beasts, plants or insects. You're resistant to all damage from your chosen source.\"\r\n    },\r\n    {\r\n      \"name\": \"Boat-Knife\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Deal keen damage to any creature that attacks you with their own body in close quarters (such as with tail or bite attacks).\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Jawspear\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A long-bladed spear with cruelly curving teeth. Deals CQ serrated damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Serrated\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Manifold Bow\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"finely-crafted bow paired with an expansive quiver. Can deal LR damage of three types chosen from the following list: Spike, Toxin, Blast, Volt, Salt\"\r\n    },\r\n    {\r\n      \"name\": \"Target Dragonfly\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"Every moment of its life is a hunt. Mark to identify a weak point or weakness of a creature you can see.\"\r\n    },\r\n    {\r\n      \"name\": \"Bloodscrawl Markings\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 1,\r\n      \"description\": \"These patterns are a hard-won warning to lesser game that it should steer clear. Any ship you crew is immune to insect incursions and wandering spirits while delving.\"\r\n    },\r\n    {\r\n      \"name\": \"Necklace of Claws\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Treat disasters as conflicts when attacking or defending against a creature that you have bested before.\"\r\n    }\r\n  ],\r\n  \"Navigator\": [\r\n    {\r\n      \"name\": \"In the Firefly's Glow\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You know the secret paths of the fireflies. Mark to discover a location without using a chart (once per scene).\"\r\n    },\r\n    {\r\n      \"name\": \"Years at Sea\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to request an omen of the future (supplied by the Firefly).\"\r\n    },\r\n    {\r\n      \"name\": \"Wildlung\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Resist the effects of bad air and airborne spores.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"bad air\",\r\n          \"airborne spores\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Revelatory\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"When you discover a new route or location, uncover a secret about that area as well.\"\r\n    },\r\n    {\r\n      \"name\": \"Hullsight\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"While aboard your ship you can see as though you had eyes at any point across the outer hull.\"\r\n    },\r\n    {\r\n      \"name\": \"At the Right Moment\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Whenever your crew take a montage during a journey, choose one crewmember to perform an extra task of their choice (you can't choose yourself).\"\r\n    },\r\n    {\r\n      \"name\": \"Journeys Unfinished\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to learn the never-reached destination or port of origin for any wreck you come across. Burn to learn it for a ship still travelling.\"\r\n    },\r\n    {\r\n      \"name\": \"Skoinesis\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"You have uncanny control over nearby ropes and rigging, which twist and move according to your will.\"\r\n    },\r\n    {\r\n      \"name\": \"Gale Flute\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A simple musical instrument at first glance, playing the gale flute has the curious property of bringing favourable winds your way.\"\r\n    },\r\n    {\r\n      \"name\": \"Cartographika\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A map-maker's ordinator. Use a task to create a rare resource, Chart of the Rustling Waves.\"\r\n    },\r\n    {\r\n      \"name\": \"Bundled Charts\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"When you uncover a new route or location you can mark this aspect. If you do so the Firefly will inform you of a second route or location at the same time.\"\r\n    },\r\n    {\r\n      \"name\": \"Ornate Spyglass\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A spyglass that allows you to see much further and in greater clarity than the average wildsailor. When you have a commanding view, mark to learn a secret of the surrounding waves.\"\r\n    },\r\n    {\r\n      \"name\": \"Flare Pistol\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"A small sidearm loaded with chemical flares. Deals LR acid damage. Can also be used to shed light over extremely large areas at will.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Acid\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Scout Falcon\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"Once per journey allows a crewmember to roll 2d6 when on watch, then pick the preferred result. Also deals LR keen damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Keen\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Weatherbug\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to accurately predict the weather for the next few days.\"\r\n    },\r\n    {\r\n      \"name\": \"Fractured Discipline\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Whenever a watchful eye is marked or burned, or the Pressure Level increases, gain a whisper related to one of your existing charts.\"\r\n    },\r\n    {\r\n      \"name\": \"Jyorachling Pair\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"Two feathered spiders that seem to despise each other. Use a task to gain two charts, one related to the skies above your position  and one related to the depths below.\"\r\n    }\r\n  ],\r\n  \"Rattlehand\": [\r\n    {\r\n      \"name\": \"Mastercraft\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Choose wood, metal or bone. Increase impact when crafting or repairing with your chosen material.\"\r\n    },\r\n    {\r\n      \"name\": \"Made to Last\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"When you craft, the resulting creation's track is three boxes longer than usual.\"\r\n    },\r\n    {\r\n      \"name\": \"Multitasker\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can use a task to work on repairing up to three pieces of gear or mechanical companions at a time.\"\r\n    },\r\n    {\r\n      \"name\": \"Surefire Smith\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Count conflicts as triumphs when repairing gear and mechanical companions.\"\r\n    },\r\n    {\r\n      \"name\": \"Deckside Engineer\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Tiny, incremental adjustments that you make without thinking keep your vessel's hull and superstructure in remarkable shape. Increase your ship's Armour rating by one when you're aboard.\"\r\n    },\r\n    {\r\n      \"name\": \"Breakdown Specialist\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"When a crafted benefit's track is fully marked, gain a piece of salvage related to it before removing the benefit\"\r\n    },\r\n    {\r\n      \"name\": \"Inkstamp Mechanism\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Consume a chart to quickly create a set of schematics for a machine or mechanism you can see (represented by new chart). All actions to create such a machine yourself gain increased impact while you have this new chart.\"\r\n    },\r\n    {\r\n      \"name\": \"Toolbelt\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Once per scene, swiftly craft a one-track creation without needing to roll.\"\r\n    },\r\n    {\r\n      \"name\": \"Salvage Kit\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Contains salvage useful for crafting. Mark to use the contents in place of a resource when crafting\"\r\n    },\r\n    {\r\n      \"name\": \"Multi-Lens Goggles\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You gain ferrosight, the ability to see electric and magnetic fields.\"\r\n    },\r\n    {\r\n      \"name\": \"Wolf-Skin Gloves\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"You never cut for difficulty when including specimens in your crafting, no matter how grisly or unpalatable the process is.\"\r\n    },\r\n    {\r\n      \"name\": \"Volt-Rail\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"An insulated grip around a crackling, rudimentary cattleprod. Deals CQ volt damage, and you're immune to volt damage yourself.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"immunity\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Volt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Hazard Suit\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Spike, Acid, Blast, Volt, Flame.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Spike\",\r\n          \"Acid\",\r\n          \"Blast\",\r\n          \"Volt\",\r\n          \"Flame\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Artillery Spider\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A self-made automaton designed to offer fire support. Deals LR blast damage\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blast\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Autocrawler\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"A nimble little scavenging construct. Once per scene, add a positive tag of your choice onto any piece of salvage you acquire.\"\r\n    },\r\n    {\r\n      \"name\": \"Steam-Scarab\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"A self-made automaton, large enough to ride.\"\r\n    },\r\n    {\r\n      \"name\": \"Emergency Repairs\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"When your ship's lift system, baffler, pressure shell, or scrubber would take structural damage, consume two pieces of salvage to prevent it.\"\r\n    },\r\n    {\r\n      \"name\": \"Rewiring Reality\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 1,\r\n      \"description\": \"Consume a whisper to fundamentally change the function of a single mechanism you can see to directly benefit you (with the aid of the Firefly for specifics).\"\r\n    }\r\n  ],\r\n  \"Screw\": [\r\n    {\r\n      \"name\": \"Ferrokinesis\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to control or reshape exposed metal.\"\r\n    },\r\n    {\r\n      \"name\": \"Heart of Ore\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Choose a single type of metal (such as iron or copper). Increase impact when repairing, crafting or using arconautics with your metal of choice.\"\r\n    },\r\n    {\r\n      \"name\": \"Ironsight\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can sense nearby metals, see magnetic fields and always know the direction of true north.\"\r\n    },\r\n    {\r\n      \"name\": \"Smart Repulsion\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Treat conflicts as triumphs when dodging or blocking attacks from constructs or metal weapons.\"\r\n    },\r\n    {\r\n      \"name\": \"Magnetic Levitation\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can manipulate your own magnetic field, allowing you to fly for short periods when close to dense masses of metal (such as a ship's hull or kinetic anchor).\"\r\n    },\r\n    {\r\n      \"name\": \"Reactive Riveter\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Deal spike damage to any creature that attacks you with their own body in close quarters (such as with tail or bite attacks).\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Field Charge\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Once per scene give any piece of salvage you acquire the Magnetic tag.\"\r\n    },\r\n    {\r\n      \"name\": \"Pre-V Ingot\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Worn as a simple decoration, but holds incredible magnetic potential. Burn to briefly move a massive amount of metal, up to the size of a ship\"\r\n    },\r\n    {\r\n      \"name\": \"Deconstructor\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Ignore cut when attempting to damage, break or deconstruct a machine or mechanism made of metal.\"\r\n    },\r\n    {\r\n      \"name\": \"Iron-Ring Jacket\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Spike, Serrated, Toxin, Volt.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Spike\",\r\n          \"Serrated\",\r\n          \"Toxin\",\r\n          \"Volt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Chaff Pouch\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to produce a cloud of metal fragments, obscuring vision around you.\"\r\n    },\r\n    {\r\n      \"name\": \"Kinetic Anchor\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A large mass of metal shaped to make it easy to carry, often used to enable ferrokinesis in places otherwise empty of metal. Deals CQ blunt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Rivet Swarm\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"A cloud of floating debris you can direct with a flick of the wrist. Deals LR spike or keen damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\",\r\n          \"Keen\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Distant Repulsion\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Your arconautic abilities seep into any vessel you call home. Any ship you crew gains the Hover style, in addition to any existing styles offered by its lift systems.\"\r\n    },\r\n    {\r\n      \"name\": \"Crisis Bolts\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Deal Blast damage to any creature that attacks you with their own body in close quarters (such as with tail or bite attacks).\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blast\"\r\n        ]\r\n      }\r\n    }\r\n  ],\r\n  \"Slinger\": [\r\n    {\r\n      \"name\": \"Gunslinger's Poise\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"You're hard to shake, no matter what comes your way.\"\r\n    },\r\n    {\r\n      \"name\": \"Trigger Discipline\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"When attacking at long range, mark to count a conflict result as a triumph.\"\r\n    },\r\n    {\r\n      \"name\": \"Deadeye\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can target attacks precisely (such as when aiming for a weak point) without cutting for difficulty.\"\r\n    },\r\n    {\r\n      \"name\": \"From On High\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Increase impact when attacking from an elevated position.\"\r\n    },\r\n    {\r\n      \"name\": \"Thunder\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to increase impact when attacking at long range.\"\r\n    },\r\n    {\r\n      \"name\": \"Trick Shot\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"Burn to attack a target you can't see or don't have line of sight to.\"\r\n    },\r\n    {\r\n      \"name\": \"Amateur Gunsmith\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Extend the track of any temporary LR weapon you craft for yourself by two boxes.\"\r\n    },\r\n    {\r\n      \"name\": \"Toe to Toe\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You can use LR weapons in close quarters combat and tight engagements without cutting for difficulty.\"\r\n    },\r\n    {\r\n      \"name\": \"Essence Grinder\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Consume a specimen to add a thematically appropriate damage type to one of your existing LR weapons. This added damage type persists until you use essence grinder again.\"\r\n    },\r\n    {\r\n      \"name\": \"Precision Denial\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Once per scene you may instantly hijack focus when targeted by a ranged attack.\"\r\n    },\r\n    {\r\n      \"name\": \"Barrage\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You can deal damage to multiple distant opponents with a successful LR attack.\"\r\n    },\r\n    {\r\n      \"name\": \"Smoke Bombs\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to produce a cloud of smoke, obscuring vision in your area for others, but not for you.\"\r\n    },\r\n    {\r\n      \"name\": \"Hammerpin Revolver\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A heavy revolver with a rotating cylinder. Deals LR blunt or blast damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\",\r\n          \"Blast\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Bolt-Action Rifle\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"A long-barrelled rifle with an amber-lensed scope. Deals LR blast damage. Increase impact when attacking from a hidden position.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blast\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Copper Sawn-Off\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A sawn-off shotgun that can be loaded with shrapnel or salt rounds. Deals LR blast or salt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blast\",\r\n          \"Salt\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Experimental Accelerator\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 1,\r\n      \"description\": \"Deals LR Spike damage. With each shot, decide if you want to increase your impact without cutting or affect multiple nearby targets at once.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Yardtongue Anteater\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"Trained over long years to whip missed shots out of the air before they disappear into the waves. Treat disasters as conflicts when using LR attackes against a nearby target.\"\r\n    }\r\n  ],\r\n  \"Steep\": [\r\n    {\r\n      \"name\": \"Anima Presence\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Spirits can always see and hear you, just as you can see and hear them\"\r\n    },\r\n    {\r\n      \"name\": \"Rite of Bloom\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Old flavours burst in novel ways. Consume a whisper when an ally imbibes one of your concoctions, and benefit from an aspect of theirs until the concoction has worn off.\"\r\n    },\r\n    {\r\n      \"name\": \"Potion of Youth\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"Your body doesn't look it but you are far older than you seem. You have learned many tricks to keep it so.\"\r\n    },\r\n    {\r\n      \"name\": \"Steeping Reality\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Tangible things steep and disperse their essence through the Physical Realm. Mark to know the past of an object.\"\r\n    },\r\n    {\r\n      \"name\": \"Not a Drop Wasted\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"A steep never spills. Once per journey, a crewmate may suffer your disaster to add a box and a word to a benefit you brewed. If there was no twist you may both alter a word in a whisper.\"\r\n    },\r\n    {\r\n      \"name\": \"Reading the Remains\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Whether leaves, grounds, draff or bones, all concoctions leave remnants. Consume a specimen to ask a question and read an omen in your remnants.\"\r\n    },\r\n    {\r\n      \"name\": \"Conduit to Flavour\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"You may elect to suffer the negative effects of a concoction instead of the one imbibing it.\"\r\n    },\r\n    {\r\n      \"name\": \"Coterie Drugget\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A place setting made of woven complexities. Allies may mark an aspect to benefit from one of your concoctions (with reduced impact).\"\r\n    },\r\n    {\r\n      \"name\": \"Ossein Kettles\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"This heirloom, eternities old, is used to create beverages that warm more than your body. Triumphs on rolls to concoct grant a Whisper.\"\r\n    },\r\n    {\r\n      \"name\": \"Salamini\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"Like a Salamax, just smaller. Their boiling spit is just the perfect temperature for a mull. Their scalding saliva deals CQ flame damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Flame\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Steam-Familiar\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"Warmth, wonder, and moisture are familiar to a Steep, and sometimes the spirits they call linger on to comfort others. Mark to neutralize the effects of bad air, spores, or cold.\"\r\n    },\r\n    {\r\n      \"name\": \"Zephyrous Stir-Spoon\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"The cooling breezes carried by this lengthy stir spoon always reach the bottom of the pot. It'll carry you, haltingly, too. Mark to poorly fly upon it for the duration of the scene.\"\r\n    },\r\n    {\r\n      \"name\": \"The Winning Wishbone\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Given the proper time and equipment, a steep can brew a hearty stock using this arm-length wishbone chunk. Triumphs on rolls made to brew heal one mark of damage for all crewmates who share in the result.\"\r\n    },\r\n    {\r\n      \"name\": \"Crezzagrean Kantharos\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"A vessel ancient even in the pre-Verdancy, used to infuse more than just flavour into a mull. While brewing with this vessel, cut 1 to add 1 rank of a skill or language you know as an additional boon to the benefit provided.\"\r\n    },\r\n    {\r\n      \"name\": \"Overwhelming Aromas\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 1,\r\n      \"description\": \"The fragrance of your brews and concoctions wafts through passageways and corridors like a pleasant dream. Any ship you crew is immune to bad air and drifting spores while delving.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"immunity\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"bad air\",\r\n          \"airborne spores\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Silver Split-Prong\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"An ordinary-looking fork, by all accounts. Deals CQ Spike damage. You can use a task to swap a tag from any one of your resources to any other resource you own (whether it's logical or not).\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Spike\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    }\r\n  ],\r\n  \"Surgeon\": [\r\n    {\r\n      \"name\": \"First Aid\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"When a nearby ally takes damage, hijack focus to immediately heal one point of that damage (once per scene).\"\r\n    },\r\n    {\r\n      \"name\": \"Evolving Techniques\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Increase impact when healing others in a safe environment.\"\r\n    },\r\n    {\r\n      \"name\": \"The Limits of the Crew\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to allow a crew-mate to benefit from a fullymarked trait or companion for the duration of a scene.\"\r\n    },\r\n    {\r\n      \"name\": \"Biological Maestro\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Choose a bloodline. When healing a member of that bloodline, treat conflict results as triumphs.\"\r\n    },\r\n    {\r\n      \"name\": \"In the Absence of Journals\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You receive a whisper whenever a crewmate fully heals from an injury.\"\r\n    },\r\n    {\r\n      \"name\": \"Wilds Theoreteician\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Sacrifice a whisper to discern the properties of a mysterious illness or injury.\"\r\n    },\r\n    {\r\n      \"name\": \"Vigilance\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"You scrub, clean and de-spore surfaces with regularity. Whenever you or one of your crew takes an injury, reduce the injury track by one box.\"\r\n    },\r\n    {\r\n      \"name\": \"Ceaseless Tending\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can use a task to work on healing up to three traits, injuries or companions at a time.\"\r\n    },\r\n    {\r\n      \"name\": \"Leviathan-Blood Infusion\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Hard to get hold of, but terrifyingly potent. Burn to give you or a crewmate resistance to all damage for the duration of a scene or increased impact on all attacks for the duration of a scene.\"\r\n    },\r\n    {\r\n      \"name\": \"Herbal Sealing-Wax\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"An odd-smelling unguent for spreading on a vessel's doorways, dispensed liberally as a matter of course. Increase your ship's Seals rating by one when you're aboard.\"\r\n    },\r\n    {\r\n      \"name\": \"Spice-Nosed Mask\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"You're immune to disease, and resist the effects of bad air and airborne spores.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"bad air\",\r\n          \"airborne spores\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Doctor's Trusty Satchel\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Mark to acquire one of three resources, Hungry Leeches, Soporific Draught or Medicinal Herbs.\"\r\n    },\r\n    {\r\n      \"name\": \"Surgical Spectacles\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to identify one of a target's weak points or weaknesses.\"\r\n    },\r\n    {\r\n      \"name\": \"Bonesaw\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Works just as well on foes as it does patients. Deals CQ serrated damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Serrated\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Whisperspit Leech\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"Mark mire to drain the falsehood out of a statement, hearing the truth behind it. You gain a whisper based on the excised lies.\"\r\n    },\r\n    {\r\n      \"name\": \"We Can't Keep Doing This\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Ignore any cut that would be added for difficulty or precision when attempting to tend to, treat, or heal a member of your own crew.\"\r\n    },\r\n    {\r\n      \"name\": \"Jar of Old Fears\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Deals LR Salt damage. In addition, you may use a task to heal a mark of mire from any member of the crew, and gain a whisper based on that mire's nature.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Salt\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    }\r\n  ],\r\n  \"Tempest\": [\r\n    {\r\n      \"name\": \"Storm-Stride\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to float for a brief time, electricity crackling around you as you do so.\"\r\n    },\r\n    {\r\n      \"name\": \"The Pulse\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can sense nearby electrical fields, such as those produced by living organisms\"\r\n    },\r\n    {\r\n      \"name\": \"Bolt-Switch\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to instantly switch places with a willing crewmate within sight, or burn to switch with them and hijack focus at the same time.\"\r\n    },\r\n    {\r\n      \"name\": \"Old Accord\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Use a task and mark to quiet or banish a storm, or use a task and burn to summon one.\"\r\n    },\r\n    {\r\n      \"name\": \"The Skies Agree\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Increase impact when dealing volt or blast damage during an electrical storm or heavy rainfall.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Volt\",\r\n          \"Blast\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Thunder's Tone\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can raise your voice to an ear-splitting shout, dealing CQ blast damage and being easily heard over long distances.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blast\"\r\n        ],\r\n        \"range\": \"CQ\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Lightning's Call\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You can direct bursts of voltaic energy through your palms or fingers, dealing LR volt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Volt\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Ground Zero Overload\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 1,\r\n      \"description\": \"Mark to deal volt damage to all nearby foes, or burn to increase it to massive volt damage.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Volt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Ironjaw Seven-String\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 5,\r\n      \"description\": \"A guitar-like instrument carved from the bones of an ironjaw ray. Produces a harsh, buzzing tone when played that seems to awaken the spirit of rebellion in some.\"\r\n    },\r\n    {\r\n      \"name\": \"Mesh Relay\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Deal volt damage to any creature that attacks you with their own body in close quarters (such as with tail or bite attacks).\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Volt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Voltomotive Interfacing\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"You can act as an additional (or main) engine for your ship, powering its bite with your mere presence. Increase your ship's Speed rating by one when you're aboard.\"\r\n    },\r\n    {\r\n      \"name\": \"Voltaic Lantern\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A simple light source that runs off of your own internal charge. Mark to deplete a nearby source of electricity, absorbing it into the lantern for a brighter glow.\"\r\n    },\r\n    {\r\n      \"name\": \"Singed Coat\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Frost, Flame, Salt, Blast, Volt.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Frost\",\r\n          \"Flame\",\r\n          \"Salt\",\r\n          \"Blast\",\r\n          \"Volt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Internal battery\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Mark to kickstart a machine, charge a depleted power source or temporarily increase the effectiveness of an engine.\"\r\n    },\r\n    {\r\n      \"name\": \"Squallkitten\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"A small, playful feline made of roiling stormclouds. Gives your entire crew resistance to volt damage\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Volt\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Sparking-Eel\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"Winds around limbs and under clothes, always moving. Mark to identify the nearest source of potent electricity, no matter the distance.\"\r\n    },\r\n    {\r\n      \"name\": \"The Gathering Storm\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"You gain the Float, Rush, Hover, and Soar styles, and treat disasters as conflicts when attacking with Volt damage, during stormy weather. Storms don't count as a negative atmospheric condition for you during flight.\"\r\n    },\r\n    {\r\n      \"name\": \"Petrichord\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A stringed instrument, somewhere between a sitar and a lyre, that sounds like fresh rain. The bearer's ship is immune to damage and negative effects from storms, including living storms, for as long as the petrichord is being played.\"\r\n    }\r\n  ],\r\n  \"Wordbearer\": [\r\n    {\r\n      \"name\": \"Respect Runs Deep\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Your clothes, your posture, your look - wordbearers are afforded a rare respect. Treat conflicts as triumphs when commanding authority in a settlement with a junction.\"\r\n    },\r\n    {\r\n      \"name\": \"The Words Always Know\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Once per scene you can gain a fragment of accurate information on the whereabouts of any individual you're trying to deliver to.\"\r\n    },\r\n    {\r\n      \"name\": \"The Safest Wrapping\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Use a task to convert a spoken or physical message of some kind into a whisper (if the message was a resource, you keep it in addition to gaining the whisper).\"\r\n    },\r\n    {\r\n      \"name\": \"Rightful Owner\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Increase impact when defending your deliveries, and when attempting to retrieve something stolen from yourself or your crew.\"\r\n    },\r\n    {\r\n      \"name\": \"Oathbound\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"You're immune to chemical, arconautic, and mesmeric effects designed to draw information from you.\",\r\n      \"damageTypes\": [\r\n        {\r\n          \"category\": \"immunity\",\r\n          \"selectionType\": \"fixed\",\r\n          \"options\": [\r\n            \"Chemical\",\r\n            \"Arconautic\",\r\n            \"Mesmeric\"\r\n          ]\r\n        }\r\n      ]\r\n    },\r\n    {\r\n      \"name\": \"Weatherbeaten\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blast, Acid, Toxin, Frost, Flame.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"resistance\",\r\n        \"selectionType\": \"choose\",\r\n        \"chooseCount\": 3,\r\n        \"options\": [\r\n          \"Blast\",\r\n          \"Acid\",\r\n          \"Toxin\",\r\n          \"Frost\",\r\n          \"Flame\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Promise-Twine\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"When a resource you're trying to deliver would be destroyed or lost it degrades instead, gaining a negative tag (if it already has a negative tag, it is consumed as normal).\"\r\n    },\r\n    {\r\n      \"name\": \"Courier's Cage\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Consume a specimen to call a nearby messenger creature to you safely, and retrieve both the creature and whatever message they're holding as resources\"\r\n    },\r\n    {\r\n      \"name\": \"Glyph Flares\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A set of chemical fireworks that burst in bright, recognisable glyph shapes.\"\r\n    },\r\n    {\r\n      \"name\": \"Pattern-Reader\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"A miniature gramophone for playing scribed cylinders of wax, ceramics, or cured bark. Mark to record a fragment of conversation or sound you can hear, to be played back at a later time.\"\r\n    },\r\n    {\r\n      \"name\": \"Undeliverables\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 5,\r\n      \"description\": \"Sometimes the oath is broken by the death of a receiver. You carry those undelivered letters and parcels around as a memorial, or possibly a penance.\"\r\n    },\r\n    {\r\n      \"name\": \"Canvas Sling\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"A simple but effective weapon. Deals LR Blunt damage, and increases impact on CQ actions made to trip or restrain a target\",\r\n      \"damageTypes\": {\r\n        \"category\": \"dealing\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"Blunt\"\r\n        ],\r\n        \"range\": \"LR\"\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Sortomaton\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"A wheezing machine used for the sorting and categorizing of mail. You count as fluent in all languages, but only when reading addresses, listening to directions, or commiting a sender's message to memory.\"\r\n    },\r\n    {\r\n      \"name\": \"Retired Courier Dragonfly\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"Still swift, but lacking stamina. Mark to gain a resource from your surroundings with some kind of text as a component, such as a chart or painted sign.\"\r\n    },\r\n    {\r\n      \"name\": \"Dead Letters\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Consume a resource to 'deliver it' to the Under-Eaves by throwing it over the side of a ship. Gain a whisper based on the delivery, with the Echoing tag\"\r\n    },\r\n    {\r\n      \"name\": \"Crawling Jar\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"Mark to add a resource to the crawling jar. This resource is impossible to find for any individual other than you, as to them the jar will appear empty. The crawling jar can hold any number of resources. Burn to pull a random resource from the jar that you never put in there (determined by the Firefly).\"\r\n    }\r\n  ],\r\n  \"Mesmer\": [\r\n    {\r\n      \"name\": \"Autohypnosis\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"You've learned to meditate rather than sleep, allowing you to stay far more aware while resting than most.\"\r\n    },\r\n    {\r\n      \"name\": \"Meditative Healing\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Using a task to meditate in a peaceful environment allows you to heal each of your damaged traits or each of your injury tracks by one.\"\r\n    },\r\n    {\r\n      \"name\": \"An Uncomfortable Understanding\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Burn to clear one of a crewmate's mire tracks entirely.\"\r\n    },\r\n    {\r\n      \"name\": \"Empty the Mind\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 4,\r\n      \"description\": \"Ignore cut from pain, hallucination and distractions while trying to act.\"\r\n    },\r\n    {\r\n      \"name\": \"Knowing The Unknown\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to identify a target's secret fear, or burn to accurately evaluate the truth of a statement.\"\r\n    },\r\n    {\r\n      \"name\": \"Parasite Thought\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"A living thought that's taken root in your mind, invisible but able to interact with the world. Allows you to hold and manipulate more objects than usual.\"\r\n    },\r\n    {\r\n      \"name\": \"Intricate Tattoos\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"You're immune to confusion and hallucinations that you don't invite or create yourself.\",\r\n      \"damageTypes\": {\r\n        \"category\": \"immunity\",\r\n        \"selectionType\": \"fixed\",\r\n        \"options\": [\r\n          \"hallucinations\"\r\n        ]\r\n      }\r\n    },\r\n    {\r\n      \"name\": \"Staredown\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 5,\r\n      \"description\": \"Locking eyes with an opponent allows you to assail their mind with unwanted sensation, manifesting as LR Salt damage. Only works on creatures with sight.\"\r\n    },\r\n    {\r\n      \"name\": \"Chameleon Veil\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Use a task to hold still and blend in with your surroundings, becoming almost impossible to notice until you move again.\"\r\n    },\r\n    {\r\n      \"name\": \"Shard of Dream-Soaked Amber\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Consume a specimen to experience a thought or memory from a nearby individual.\"\r\n    },\r\n    {\r\n      \"name\": \"Seven-Eye Scrawl\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Eyes are daubed across your body, each of them able to perceive the world in a different way. Mark to gain a specialized form of sight for a brief time (such as the ability to see ghosts, heat, or magnetism).\"\r\n    },\r\n    {\r\n      \"name\": \"Smoked-Glass Hookah\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Releases a steady stream of wispy smoke. Mark to control smoke or vapours.\"\r\n    },\r\n    {\r\n      \"name\": \"Chromiguana\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"Slow-moving and sleepy, usually found curled up around your shoulders or at the bottom of a bag. A surprisingly relaxing presence - treat conflicts as triumphs when trying to calm yourself or others.\"\r\n    },\r\n    {\r\n      \"name\": \"Pinned Butterfly\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 3,\r\n      \"description\": \"Mark to wake the butterfly for a brief time. While awake, the hypnotic patterns of the butterfly's wings induce drowsiness in those that catch sight of them.\"\r\n    },\r\n    {\r\n      \"name\": \"Amberglass Spectacles\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"Treat conflicts as triumphs when investigating mysteries or discerning truths while at least one watchful eye is marked or burned. If both watchful eyes are marked or burned, increase impact on therse actions as well.\"\r\n    },\r\n    {\r\n      \"name\": \"Guilewasps\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 4,\r\n      \"description\": \"Spectral, flickering, barely there at all. When one of your crewmates uses a whisper, mark to gain a twisted copy of that whisper as a resource (supplied by the Firefly).\"\r\n    }\r\n  ],\r\n  \"Agronaut\": [\r\n    {\r\n      \"name\": \"Dawn to Dusk to Dawn\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Immediately mark the first box on the Grow track of anything you plant under sunlight or moonlight (choose one when you take this trait).\"\r\n    },\r\n    {\r\n      \"name\": \"Constant Gardener\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"When a plot would be damaged or destroyed (or otherwise negatively affected by the environment), burn to avoid this effect.\"\r\n    },\r\n    {\r\n      \"name\": \"Perfectly Ripe\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"Crewmates treat disasters as conflicts when using specimens you've grown as part of a creation.\"\r\n    },\r\n    {\r\n      \"name\": \"Soothing Harvester\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Plants grown aboard your ship (or body) are immune to blight and sickness. Mark to improve the rarity of any plant-based specimen you acquire from plots.\"\r\n    },\r\n    {\r\n      \"name\": \"Delicate Step\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 2,\r\n      \"description\": \"You disturb no leaves and leave no footprints. You gain resistance to the hazardous effects of crezzerin, and increase impact on actions taken to move through densely forested areas.\"\r\n    },\r\n    {\r\n      \"name\": \"Green Mile\",\r\n      \"type\": \"Trait\",\r\n      \"track\": 3,\r\n      \"description\": \"Once per journey, replace the results of a watch roll with the Peace outcome. If you finish a journey without using this option, remove a negative tag from any one plant growing on your ship.\"\r\n    },\r\n    {\r\n      \"name\": \"Paradox Slug-Box\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"These slugs exude crezzer-neutralizing slime and resist all forms of alchemical experimentation. All plots you own are resistant to crezzerin-based damage or effects. Use a task to create a resource, Paradox Slime.\"\r\n    },\r\n    {\r\n      \"name\": \"Sumptuous Seed-Bag\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"For a combination of hard graft and showing off. Use a task to create a seed-based specimen based on any plant currently growing within a plot (on your ship or person).\"\r\n    },\r\n    {\r\n      \"name\": \"Misting Coppercan\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"You are almost impossible to detect for predatory plants of all kinds. In addition, whenever you would gain a plant specimen with a negative tag, you may mark mire to remove that tag entirely.\"\r\n    },\r\n    {\r\n      \"name\": \"Vespin Almanac\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 4,\r\n      \"description\": \"Filled with scrawlings on wildfruit theories and hazardous farming techniques. Consume a whisper to add a positive tag to a growing plant, or voluntarily clear three boxes on a Grow track to gain a related whisper.\"\r\n    },\r\n    {\r\n      \"name\": \"Portable Plot\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 3,\r\n      \"description\": \"You just have too many ideas for one deck to handle. You gain an extra plot, always attached to you, with 4/4 spaces for growing plants. You must add a growing medium to this plot for it to be effective.\"\r\n    },\r\n    {\r\n      \"name\": \"Brute-Shovel\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Deals CQ Hewing damage, and allows you to treat conflicts as triumphs when gathering plant-based specimens.\"\r\n    },\r\n    {\r\n      \"name\": \"Ireful Pitchfork\",\r\n      \"type\": \"Gear\",\r\n      \"track\": 2,\r\n      \"description\": \"Deals CQ Spike damage, and increases impact on actions taken to defend against or fend off hazards that would threaten the integrity of ship-borne plants.\"\r\n    },\r\n    {\r\n      \"name\": \"Sabre-Nosed Bat\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"A voracious leather-winged protector, eager to defend your growing-plots. Deals LR Keen damage, and all plots you own are resistant to insect-based damage or effects.\"\r\n    },\r\n    {\r\n      \"name\": \"Amblecotta Pot\",\r\n      \"type\": \"Companion\",\r\n      \"track\": 2,\r\n      \"description\": \"A tottering, stylized pot filled with simple soil. You gain an extra plot, always nearby to you, with 4/4 spaces for growing plants. This companion counts as a full solution, both plot and medium combined.\"\r\n    }\r\n  ]\r\n}"
          },
