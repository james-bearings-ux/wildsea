            "mimeType": "application/vnd.pgrst.object+json",
            "text": "{\"id\":\"39e2f674-78e6-4e52-bf43-a2b5c861dc5a\",\"session_id\":\"ba8b7220-b27f-4c8c-b89e-9dc5eac93970\",\"name\":\"Pollen\",\"mode\":\"play\",\"bloodline\":\"Ketra\",\"origin\":\"Rootless\",\"post\":\"Alchemist\",\"selected_aspects\":[{\"id\": \"Ketra-Gelatinous Form\", \"name\": \"Gelatinous Form\", \"type\": \"Trait\", \"track\": 5, \"source\": \"Ketra\", \"category\": \"Bloodline\", \"trackSize\": 5, \"damageTypes\": {\"options\": [\"Salt\"], \"category\": \"weakness\", \"selectionType\": \"fixed\"}, \"description\": \"You have an inherent weakness to salt damage, but can squeeze and compress your body enough to move through spaces much smaller than expected.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Alchemist-Ulcerous Alembic\", \"name\": \"Ulcerous Alembic\", \"type\": \"Trait\", \"track\": 4, \"source\": \"Alchemist\", \"category\": \"Post\", \"trackSize\": 4, \"description\": \"You can swallow two alchemical components, keeping them safely in your stomach. You can concoct them internally when you choose, benefitting immediately from the results or spitting the resulting solution out.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Alchemist-Dilution Agent\", \"name\": \"Dilution Agent\", \"type\": \"Gear\", \"track\": 2, \"source\": \"Alchemist\", \"category\": \"Post\", \"trackSize\": 2, \"description\": \"When you create a concoction, the entire crew can gain the benefit it offers as a one-track temporary aspect.\", \"damageStates\": [\"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ketra-Scrapper Enzymes\", \"name\": \"Scrapper Enzymes\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Ketra\", \"category\": \"Bloodline\", \"trackSize\": 3, \"description\": \"You can use salvage as a component when concocting a potion or chemical mixture, no matter its form.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Rattlehand-Salvage Kit\", \"name\": \"Salvage Kit\", \"type\": \"Gear\", \"track\": 3, \"source\": \"Rattlehand\", \"category\": \"Post\", \"trackSize\": 3, \"description\": \"Contains salvage useful for crafting. Mark to use the contents in place of a resource when crafting\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ketra-Old Ore Piercings\", \"name\": \"Old Ore Piercings\", \"type\": \"Gear\", \"track\": 1, \"source\": \"Ketra\", \"category\": \"Bloodline\", \"trackSize\": 1, \"damageTypes\": {\"options\": [\"crezzerin effects\"], \"category\": \"immunity\", \"selectionType\": \"fixed\"}, \"description\": \"You're immune to the usual effects of crezzerin. Concentrated sources of crezzerin heal rather than harm you.\", \"damageStates\": [\"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Agronaut-Sumptuous Seed-Bag\", \"name\": \"Sumptuous Seed-Bag\", \"type\": \"Gear\", \"track\": 3, \"source\": \"Agronaut\", \"category\": \"Post\", \"trackSize\": 3, \"description\": \"For a combination of hard graft and showing off. Use a task to create a seed-based specimen based on any plant currently growing within a plot (on your ship or person).\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}],\"selected_edges\":[\"Instinct\", \"Tides\", \"Sharps\"],\"skills\":{\"Hack\": 1, \"Tend\": 2, \"Sense\": 1, \"Outwit\": 1, \"Rattle\": 2, \"Concoct\": 2, \"Harvest\": 2, \"Scavenge\": 2, \"Wavewalk\": 1},\"languages\":{\"Low Sour\": 3, \"Raka Spit\": 1},\"drives\":[\"Divine the cure for a previously incurable ailment.\", \"Discover a previously unknown alchemical effect.\", \"Throw yourself into dire situations with vigour.\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\"],\"mires\":[{\"text\": \"My bellows element sometimes has a drive of its own.\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"Sad old secrets from messages past tug at your dreams.\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"You're the perfect test subject for your own work.\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\", \"checkbox1\": false, \"checkbox2\": false}],\"milestones\":[{\"id\": \"1761073342638\", \"name\": \"finishing mister haulins opus\\t\\t\\t\\t\\t\", \"used\": true, \"scale\": \"Major\"}, {\"id\": \"1761073352653\", \"name\": \"Tanderich Incisor's Run Triple Crown\\t\\t\\t\\t\\t\", \"used\": true, \"scale\": \"Major\"}, {\"id\": \"1761073363235\", \"name\": \"survived the mantid drake\\t\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Major\"}, {\"id\": \"1761073372955\", \"name\": \"good shopping and trading\\t\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Minor\"}, {\"id\": \"1761073379569\", \"name\": \"spectacular full ship salvage\\t\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Minor\"}, {\"id\": \"1761073383785\", \"name\": \"rescue villager in Tanderich\\t\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Minor\"}, {\"id\": \"1761073391203\", \"name\": \"Mustache Gun the Son of Teeth emerges!\\t\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Minor\"}],\"resources\":{\"charts\": [{\"id\": \"1761073278114\", \"name\": \"Honey-Stained Page\\t\\t\\t\\t\\t\"}, {\"id\": \"1761073289065\", \"name\": \"Punchcard Instructions\\t\\t\\t\\t\\t\"}], \"salvage\": [{\"id\": \"1761073315554\", \"name\": \"Sparking Strip\"}], \"whispers\": [{\"id\": \"1761073297037\", \"name\": \"Once Long Forgotten\\t\\t\\t\\t\\t\"}, {\"id\": \"1761073307366\", \"name\": \"A Hunger for Ships\\t\\t\\t\\t\\t\", \"used\": false}], \"specimens\": [{\"id\": \"1761000811947\", \"name\": \"Enriched tub of storm crezzerine\"}, {\"id\": \"1761073229537\", \"name\": \"3 bottles of Wild Musk Meade\"}, {\"id\": \"1761073255638\", \"name\": \"Lab Grade lichen, teal goop Transfer Mucus\"}, {\"id\": \"1761073328406\", \"name\": \"Old boot of soil\\t\\t\\t\\t\\t\"}, {\"id\": \"1762394360758\", \"name\": \"Creeping Shrapnado Leaf\", \"used\": false}]},\"created_at\":\"2025-10-20T17:29:05.800651+00:00\",\"updated_at\":\"2025-11-06T02:00:27.348+00:00\",\"tasks\":[{\"id\": \"1761136358508\", \"name\": \"Find fuses for N'off\", \"editing\": false, \"maxTicks\": 3, \"currentTicks\": 0}, {\"id\": \"1761785715819\", \"name\": \"Seeds to graft a \\\"toothsome\\\" Coconest seed\", \"editing\": false, \"maxTicks\": 3, \"currentTicks\": 2}],\"notes\":\"Guns on the ship have an interesting makers mark.\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\n\\\"kid in a candy store\\\"\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\nKnow 3 \\\"rattlehands\\\" in Tall Mauzer: Chit, Illsani, and N'Off\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\n3 random resources and 3 cargo for the ship/team - 5 round trip tickets to TM (trophy-\\\"ivory\\\")\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\nMechanism/time requirement for a \\\"Pollen refill\\\" - \\\"Short/Long Rest\\\" - Can be as long as a day has gone by, have returned to the ship after being away, or using Cresserin/resource do it with a reasonable short amount of time.\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\nCome up with a \\\"clock\\\" for tending plants/collecting Cresserin.\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\nC4PT - Ironbound corsair, ship registered here in Tall Mauzer. Crewed by Bellows Garls\\nTrain Ride: The Path Home 10/29 USED 2 MAJOR MILESTONES TO ADD SUMPTUOUS SEED ASPECT\",\"journey_role\":\"tend-the-garden\"}"
          },
