          "cookies": [],
          "content": {
            "size": 7694,
            "mimeType": "application/vnd.pgrst.object+json",
            "text": "{\"id\":\"ee0e8db0-abd4-4914-827c-5c283601e5ba\",\"session_id\":\"ba8b7220-b27f-4c8c-b89e-9dc5eac93970\",\"name\":\"The Arrhythmia\",\"mode\":\"play\",\"anticipated_crew_size\":4,\"additional_stakes\":13,\"rating_damage\":{\"Saws\": [\"default\"], \"Tilt\": [\"burned\", \"default\", \"default\", \"default\", \"default\"], \"Seals\": [\"default\", \"default\"], \"Speed\": [\"default\", \"default\", \"default\", \"default\", \"default\"], \"Armour\": [\"default\", \"default\", \"default\", \"default\", \"burned\"], \"Stealth\": [\"burned\", \"default\", null, \"default\"]},\"size\":{\"name\": \"Standard\", \"stakes\": 1, \"bonuses\": [{\"value\": 1, \"rating\": \"Armour\"}], \"description\": \"Comfortable for 5-10 people, but can hold double that number if necessary. The majority of ships out on the Wildsea are of standard size, hence the name.\"},\"frame\":{\"name\": \"Flexible\", \"stakes\": 1, \"bonuses\": [{\"value\": 1, \"rating\": \"Tilt\"}], \"description\": \"Built for adjustability and responsiveness, flexible frames are often multi-segmented or jointed in some way.\"},\"hull\":[{\"name\": \"Arachnesque\", \"stakes\": 2, \"bonuses\": [{\"value\": 1, \"rating\": \"Tilt\"}, {\"value\": 1, \"rating\": \"Stealth\"}], \"specials\": [], \"description\": \"Less of a hull and more of a giant insect grown to fit the specifications of your frame, usually something spider-like.\"}],\"bite\":[{\"name\": \"Navapede Limbs\", \"stakes\": 2, \"bonuses\": [{\"value\": 1, \"rating\": \"Tilt\"}, {\"value\": 1, \"rating\": \"Stealth\"}], \"specials\": [\"Deals massive CQ Spike damage\"], \"description\": \"Centipedal limbs lining the hull, letting a ship scuttle through the thrash. If such a vessel could truly now be called a ship, of course.\"}, {\"name\": \"Sharpened Prow\", \"stakes\": 0, \"bonuses\": [], \"specials\": [\"Provides a basic cutting edge, but no motive force. Just about works when paired with oars, but you really should choose something better.\", \"Deals massive CQ Keen damage... or it would, if you could get up enough speed.\"], \"description\": \"Simple and straightforward, a honed blade running the length of the ship's prow to cut through vegetation.\"}],\"engine\":[{\"name\": \"Leviathan Heart\", \"stakes\": 2, \"bonuses\": [{\"value\": 1, \"rating\": \"Speed\"}, {\"value\": 1, \"rating\": \"Tilt\"}], \"specials\": [\"Requires no fuel, but in a particularly ominous way.\"], \"description\": \"An actual leviathan heart, still beating reflexively, hooked up to the ship. Pumps viscous black fuel through pipes and valves.\"}, {\"name\": \"Solar Compressor\", \"stakes\": 2, \"bonuses\": [{\"value\": 1, \"rating\": \"Speed\"}, {\"value\": 1, \"rating\": \"Stealth\"}], \"specials\": [\"Naturally fueled on sunny days\"], \"description\": \"Made to store, liquefy, and pressurize sunlight.\"}, {\"name\": \"Tamed Hive\", \"stakes\": 2, \"bonuses\": [{\"value\": 1, \"rating\": \"Speed\"}, {\"value\": 1, \"rating\": \"Seals\"}], \"specials\": [\"Fueled with stolen flowers and unprocessed pollen.\", \"Crew can use a task while at sea to gain a resource, 'Fresh Engine-Honey', once per journey.\"], \"description\": \"A buzzing organic engine of honeycombs and crawling workers, their movements a complex dance.\"}],\"motifs\":[{\"name\": \"Salvaging\", \"stakes\": 2, \"specials\": [\"A scratched and dented appearance, making you look almost like a wreck yourself\", \"A modified cargo area with work benches and tools for disassembly\", \"A grappling crane built into the ship's structure for attaching to large wreckage, allowing it to be hauled onto the deck or towed behind the ship\"], \"description\": \"Useful for scrappers, dredgers, and wreck-wranglers, salvaging ships will likely have...\"}],\"general_additions\":[{\"name\": \"Chemical Spotlight\", \"stakes\": 1, \"specials\": [], \"description\": \"Illuminates surrounding areas with day-like clarity.\"}, {\"name\": \"Anchor System\", \"stakes\": 0, \"specials\": [], \"description\": \"Lengths of chain with heavy curved hooks, used to anchor ships to the branches of the Wildsea. Almost every ship comes with this as standard.\"}, {\"name\": \"Tethered Kitesail\", \"stakes\": 1, \"specials\": [], \"description\": \"A glider tethered to the deck with a long rope, allowing aerial exploration on windy days.\"}, {\"name\": \"Catapault Track\", \"stakes\": 1, \"description\": \"A spring-loaded section of deck used for catapulting outriders onto the waves at speed. Great for taking other ships by surprise, but the logistics of reloading an outrider for another launch are... tricky.\"}],\"bounteous_additions\":[{\"name\": \"Fruiting Tree\", \"stakes\": 1, \"specials\": [\"Automatically acquire a fruit-based specimen when you use a task to tend to the fruiting tree.\"], \"description\": \"An ancient tree rooted to your deck, laden with fast-growing fruit.\"}, {\"name\": \"Night Farm\", \"stakes\": 1, \"specials\": [\"Automatically acquire a mushroom-based specimen when you use a task to tend to the night farm.\"], \"description\": \"A dark, covered soilpit for growing mushrooms.\"}],\"rooms\":[{\"name\": \"Underthrash Platform\", \"stakes\": 1, \"specials\": [], \"description\": \"A sturdy door leading to an open platform at the base of the ship, usually at the rear, below the riding-line.\"}, {\"name\": \"Galley\", \"stakes\": 1, \"specials\": [], \"description\": \"A space for gathering, cooking, and eating, filled with pans, cookware, and usually a chemical stove.\"}],\"armaments\":[{\"name\": \"Son of Teeth\", \"stakes\": 2, \"bonuses\": [{\"value\": 3, \"rating\": \"Armour\"}], \"specials\": [\"Deals massive LR Salt damage\"], \"description\": \"A microwave cannon. Acts as an energy shield when not shooting. Each shot reduces available shield by 1, recharging 1/day.\"}, {\"name\": \"Badass Outrider\", \"stakes\": 3, \"specials\": [\"Ratings: Armor 2, Seals 1, Speed 4, Saws 2, Stealth 3, Tilt 2.\", \"Deals Massive LR Spike damage.\", \"A chemical battery for adding extra power to the engines. Used, hopefully, with great caution.\", \"Two personal modifications via workhorse (improved stealth, speed, and tilt).\"], \"description\": \"A workhorse with overburner and weapon housing. \"}],\"undercrew\":{\"gangs\": [{\"name\": \"Stargazers [3-Track]\", \"track\": 3, \"stakes\": 2, \"specials\": [\"Automatically acquire one normal whisper when you drop anchor\"], \"description\": \"Sky-watching tale-spinners.\"}], \"packs\": [{\"name\": \"Etterescu [3-Track]\", \"track\": 3, \"stakes\": 2, \"specials\": [\"Automatically acquire one normal whisper when you dock at port.\"], \"description\": \"Lurking centipedes that prefer darker places, listening to secrets and fragments of lore.\"}], \"officers\": [{\"name\": \"Skillful Officer [3-Track]\", \"track\": 3, \"stakes\": 1, \"specials\": [\"2 ranks in any skill\", \"1 rank in any other skill\"], \"description\": \"A seasoned wildsailor, likely on the verge of leaving the undercrew and setting out to find a main crew position of their own.\"}]},\"undercrew_damage\":{\"Etterescu [3-Track]\": [\"default\", \"default\", \"default\"], \"Stargazers [3-Track]\": [\"default\", \"default\"], \"Rig-Ferrets [3-Track]\": [\"default\"], \"Cartographers [3-Track]\": [\"burned\", \"default\"], \"Skillful Officer [3-Track]\": [\"burned\", \"burned\"], \"Well-Travelled Officer [3-Track]\": [\"burned\", \"default\"]},\"cargo\":[{\"id\": \"f3376491-283e-4e68-b095-282118f625c5\", \"name\": \"Mesmeric Gland\"}, {\"id\": \"fa88f0ca-ca74-4256-9042-4db2ab4fa4bd\", \"name\": \"Small Terrapex Egg\"}, {\"id\": \"37273f63-0f86-40c7-9e10-cad5fd3d0b12\", \"name\": \"Word-Scribed Tooth\"}, {\"id\": \"0b1a4557-f21a-4006-9a26-6fefc8dbfc51\", \"name\": \"Canting Spore Colony\"}, {\"id\": \"9cdcdd37-60df-46a1-9c09-f34fa7fc45c1\", \"name\": \"Tryphoradon Eggs (3)\"}, {\"id\": \"1761183205610\", \"name\": \"Crates of Bricks (3)\"}],\"passengers\":[{\"id\": \"1761254828411\", \"name\": \"Mendredms\"}],\"created_at\":\"2025-10-17T17:46:36.111313+00:00\",\"updated_at\":\"2025-11-06T02:37:44.974+00:00\",\"journey\":{\"name\": \"The Silent Bloom\", \"active\": true, \"clocks\": {\"riot\": {\"max\": 6, \"filled\": 1}, \"risk\": {\"max\": 3, \"filled\": 0}, \"progress\": {\"max\": 6, \"filled\": 2}, \"pathfinding\": {\"max\": 4, \"filled\": 0}}}}"
          },
