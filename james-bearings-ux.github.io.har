            "size": 3782,
            "mimeType": "application/vnd.pgrst.object+json",
            "text": "{\"id\":\"43bfa324-ae64-4776-818a-ef0554bea69d\",\"session_id\":\"ba8b7220-b27f-4c8c-b89e-9dc5eac93970\",\"name\":\"Patrone\",\"mode\":\"play\",\"bloodline\":\"Ektus\",\"origin\":\"Rootless\",\"post\":\"Navigator\",\"selected_aspects\":[{\"id\": \"Rootless-Slingshot\", \"name\": \"Slingshot\", \"type\": \"Gear\", \"track\": 3, \"source\": \"Rootless\", \"category\": \"Origin\", \"trackSize\": 2, \"customized\": true, \"damageTypes\": {\"range\": \"LR\", \"options\": [\"Keen\", \"Blast\"], \"category\": \"dealing\", \"chooseCount\": null, \"selectionType\": \"fixed\"}, \"description\": \"A simple slingshot, loaded with anything from stones to scrap to seeds. Deals LR keen or blast damage.\", \"damageStates\": [\"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ektus-Heliovore\", \"name\": \"Heliovore\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Ektus\", \"category\": \"Bloodline\", \"trackSize\": 3, \"description\": \"Heal a mark of damage on any one of your traits after spending a day in strong sunlight.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ektus-Desert Harness\", \"name\": \"Desert Harness\", \"type\": \"Gear\", \"track\": 3, \"source\": \"Ektus\", \"category\": \"Bloodline\", \"trackSize\": 3, \"damageTypes\": {\"options\": [\"Spike\", \"Hewing\", \"Serrated\", \"Frost\", \"Flame\"], \"category\": \"resistance\", \"chooseCount\": 3, \"selectionType\": \"choose\"}, \"description\": \"You're resistant to three damage types, chosen from the following list: Spike, Hewing, Serrated, Frost, Flame.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {\"resistance\": [\"Spike\", \"Hewing\", \"Serrated\"]}}, {\"id\": \"Navigator-Weatherbug\", \"name\": \"Weatherbug\", \"type\": \"Companion\", \"track\": 3, \"source\": \"Navigator\", \"category\": \"Post\", \"trackSize\": 3, \"description\": \"Mark to accurately predict the weather for the next few days.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Rootless-Fleetfamily Scarf\", \"name\": \"Fleetfamily Scarf\", \"type\": \"Gear\", \"track\": 3, \"source\": \"Rootless\", \"category\": \"Origin\", \"trackSize\": 3, \"damageTypes\": {\"options\": [\"bad air\", \"airborne spores\"], \"category\": \"immunity\", \"selectionType\": \"fixed\"}, \"description\": \"A beautifully made sporescarf passed from traveller to seasoned traveller. You're immune to the effects of bad air and airborne spores.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Navigator-At the Right Moment\", \"name\": \"At the Right Moment\", \"type\": \"Trait\", \"track\": 2, \"source\": \"Navigator\", \"category\": \"Post\", \"trackSize\": 2, \"description\": \"Whenever your crew take a montage during a journey, choose one crewmember to perform an extra task of their choice (you can't choose yourself).\", \"damageStates\": [\"default\", \"default\"], \"selectedDamageTypes\": {}}],\"selected_edges\":[\"Sharps\", \"Tides\", \"Instinct\"],\"skills\":{\"Brace\": 1, \"Sense\": 1, \"Study\": 1, \"Rattle\": 1, \"Wavewalk\": 1},\"languages\":{\"Saprekk\": 1, \"Low Sour\": 3, \"Old Hand\": 1, \"Signaling\": 1},\"drives\":[\"Serve as a loyal crewmate\", \"Get my own ship one day\", \"Befuddle Magnetron\"],\"mires\":[{\"text\": \"That damn egg\", \"checkbox1\": true, \"checkbox2\": false}, {\"text\": \"They’ve left me for good this time, haven’t they?\", \"checkbox1\": true, \"checkbox2\": false}, {\"text\": \"Dreams are where they get you\", \"checkbox1\": true, \"checkbox2\": false}],\"milestones\":[],\"resources\":{\"charts\": [], \"salvage\": [], \"whispers\": [{\"id\": \"1760750777365-whispers-1-2\", \"name\": \"Dawn Over New Waves\", \"used\": false}], \"specimens\": []},\"created_at\":\"2025-10-18T01:22:13.312311+00:00\",\"updated_at\":\"2025-11-06T21:52:46.279+00:00\",\"tasks\":[{\"id\": \"1761826694153\", \"name\": \"Generate night soil (1 tick per travel segment)\", \"editing\": false, \"maxTicks\": 4, \"currentTicks\": 2}],\"notes\":\"Spore coat\\nDashing tri-corner hat\",\"journey_role\":\"tend-the-engine\"}"
          },
