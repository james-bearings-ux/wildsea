          "content": {
            "size": 6536,
            "mimeType": "application/json",
            "text": "{\n  \"Ardent\": {\n    \"salvage\": [\"Stone Fragments\", \"Highwood Planks\"],\n    \"specimens\": [\"Caged Bird\", \"Milkweed\"],\n    \"whispers\": [\"Grove of Twisted Trees\"],\n    \"charts\": [\"A Copper-Coloured Chart\"]\n  },\n  \"Ektus\": {\n    \"salvage\": [\"Porous Stone\", \"Bronze Locket\"],\n    \"specimens\": [\"Scarab Shell\", \"Iron-Hard Needles\"],\n    \"whispers\": [\"A Desert Lost to Time\"],\n    \"charts\": [\"A Dusty Chart\"]\n  },\n  \"Gau\": {\n    \"salvage\": [\"Fluted Stone\", \"Fossilized Fungus\"],\n    \"specimens\": [\"Fat-Bodied Beetle\", \"Sourvine Extract\"],\n    \"whispers\": [\"Mycosanctum Rumblings\"],\n    \"charts\": [\"A Chart of Many Colours\"]\n  },\n  \"Ironbound\": {\n    \"salvage\": [\"Sawprow Teeth\", \"Defused Shells\"],\n    \"specimens\": [\"Crezzerin'd Leaves\", \"Rooted Fungus\"],\n    \"whispers\": [\"Woken to Thought\"],\n    \"charts\": [\"An Old Tradeway\"]\n  },\n  \"Ketra\": {\n    \"salvage\": [\"Ceremonial Dynamite\", \"Old Driftwood\"],\n    \"specimens\": [\"Luminescent Bone\", \"Curled Centipede\"],\n    \"whispers\": [\"The Comforting Dark\", \"All Tunnels End\"],\n    \"charts\": [\"A Faded Schematic\"]\n  },\n  \"Mothryn\": {\n    \"salvage\": [\"Bolt of Fabric\", \"Damaged Scrap-Flute\"],\n    \"specimens\": [\"Berry Pigment\", \"Raw Silk\"],\n    \"whispers\": [\"Rationing Ended\", \"Vibrant Riot\"],\n    \"charts\": [\"A Tapestry Map\", \"A Painted Wing-Scale\"]\n  },\n  \"Tzelicrae\": {\n    \"salvage\": [\"Frayed Ropes\", \"Patterned Canvas\"],\n    \"specimens\": [\"Spider Husks\", \"Venom Extract\"],\n    \"whispers\": [\"A Prison of Skin\"],\n    \"charts\": [\"A Port Manifest in Knock\"]\n  },\n  \"Amberclad\": {\n    \"salvage\": [\"Amber Chips\", \"Tarnished Memento\"],\n    \"specimens\": [\"Strong Coffee\", \"Gold-Winged Bee\"],\n    \"whispers\": [\"The Longest Sleep\", \"Clear Coffin\"],\n    \"charts\": [\"A Book-Block\", \"A Crisp Sketch-Page\"]\n  },\n  \"Anchored\": {\n    \"salvage\": [\"Old Memento\", \"Broken Locket\"],\n    \"specimens\": [\"Glowing Plasm\", \"Spectral Flower\"],\n    \"whispers\": [\"Back from Beyond\", \"Drowned and Not\"],\n    \"charts\": [\"A Sketch of Shadowed Paths\"]\n  },\n  \"Ridgeback\": {\n    \"salvage\": [\"Knucklebone Dice\", \"Sharpened Stones\"],\n    \"specimens\": [\"Giant Wolf Jaw\", \"Gorse Root\"],\n    \"whispers\": [\"Caves Beneath\"],\n    \"charts\": [\"A Faded Almanac\"]\n  },\n  \"Rootless\": {\n    \"salvage\": [\"Rusted Cogs\", \"Sailcloth\"],\n    \"specimens\": [\"Wormapple\", \"Firefly Bulbs\"],\n    \"whispers\": [\"A Welcoming Fleet\"],\n    \"charts\": [\"A Many-Folded Chart\"]\n  },\n  \"Shankling\": {\n    \"salvage\": [\"Ancient Stone\", \"Length of Chain\"],\n    \"specimens\": [\"Broadwood Branch\", \"Crowning Leaf\"],\n    \"whispers\": [\"Sunset Through Branches\"],\n    \"charts\": [\"An Etched Branch-Map\"]\n  },\n  \"Spit-Born\": {\n    \"salvage\": [\"Engine Piping\", \"Ancient Glass\"],\n    \"specimens\": [\"Hog Bones\", \"Chicken Feathers\"],\n    \"whispers\": [\"A Newly-Risen Spit\"],\n    \"charts\": [\"A Cryptic Map\"]\n  },\n  \"Alchemist\": {\n    \"salvage\": [\"Pouch of Vials\", \"Rust Extract\"],\n    \"specimens\": [\"Dried Locusts\", \"Draketongue Root\", \"Beast Blood\", \"Poison Glands\"],\n    \"whispers\": [\"A Stained Snapograph\"],\n    \"charts\": [\"A Tale of Choking Mists\"]\n  },\n  \"Char\": {\n    \"salvage\": [\"Boiling Casks\", \"Heating Element\"],\n    \"specimens\": [\"Medicinal Herbs\", \"Distant Sea-Spices\"],\n    \"whispers\": [\"That Delicate Taste\", \"Forbidden Food\"],\n    \"charts\": [\"An Annotated Cookbook\", \"A Spice-Stained Map\"]\n  },\n  \"Corsair\": {\n    \"salvage\": [\"Armour Shards\", \"Blackpowder Pouch\"],\n    \"specimens\": [\"Suspicious Finger\", \"Beast Bones\"],\n    \"whispers\": [\"A Sobbing Mawship\"],\n    \"charts\": [\"A Stolen Starchart\"]\n  },\n  \"Crash\": {\n    \"salvage\": [\"Fine Red Powder\", \"Slab of Masonry\"],\n    \"specimens\": [\"Flare Beetle Horn\", \"Vermillion Herbs\"],\n    \"whispers\": [\"A Creeping Seam\"],\n    \"charts\": [\"A Weathered Chart\"]\n  },\n  \"Dredger\": {\n    \"salvage\": [\"Copper Rings\", \"Ancient Engine\"],\n    \"specimens\": [\"Soporific Sap\", \"Leviathan Claw\"],\n    \"whispers\": [\"A Risen Wreck\"],\n    \"charts\": [\"An Ancient Shipping Manifest\"]\n  },\n  \"Hacker\": {\n    \"salvage\": [\"Wreck-Iron Plating\", \"Abandoned Scrap\"],\n    \"specimens\": [\"Wild Apricots\", \"Scorpions in a Jar\"],\n    \"whispers\": [\"An Ironroot Fallen\"],\n    \"charts\": [\"An Arboreal Diagram\"]\n  },\n  \"Horizoneer\": {\n    \"salvage\": [\"Drinking Horn\"],\n    \"specimens\": [\"Bark Wine\"],\n    \"whispers\": [\"New Horizons\", \"Over the Ridge\"],\n    \"charts\": [\"A Hasty Sketch\"]\n  },\n  \"Hunter\": {\n    \"salvage\": [\"Leather Cord\", \"Rusted Mantrap\"],\n    \"specimens\": [\"Scorpion Carapace\", \"Bait Worms\"],\n    \"whispers\": [\"Leviathan Breeding Grounds\"],\n    \"charts\": [\"A Chart of Old Hollows\"]\n  },\n  \"Mesmer\": {\n    \"salvage\": [\"Broken Pocketwatch\"],\n    \"specimens\": [\"Hallucinogenic Leaf\", \"Soporific Draught\"],\n    \"whispers\": [\"Beneath the Surface\"],\n    \"charts\": [\"A Dream-Drawn Sketch\"]\n  },\n  \"Navigator\": {\n    \"salvage\": [\"Torn Canvas\", \"Ship's Timber\"],\n    \"specimens\": [\"Glowing Mushrooms\", \"Ancient Amber\"],\n    \"whispers\": [\"A Spit On the Rise\", \"Dawn Over New Waves\"],\n    \"charts\": [\"A Leather-Bound Journal\", \"A Detailed Chart\"]\n  },\n  \"Rattlehand\": {\n    \"salvage\": [\"Ancient Wiring\", \"Ceramic Battery\"],\n    \"specimens\": [\"Crushed Beetle\", \"Giant Insect Mandible\"],\n    \"whispers\": [\"Locomotive Power\"],\n    \"charts\": [\"An Indecipherable Blueprint\"]\n  },\n  \"Screw\": {\n    \"salvage\": [\"Bundle of Rivets\", \"Iron Ore\"],\n    \"specimens\": [\"Rust-Beetle Chitin\"],\n    \"whispers\": [\"Unknown Forces\", \"The Floating Fortress\"],\n    \"charts\": [\"An Iron Scroll\", \"A Curious Compass\"]\n  },\n  \"Slinger\": {\n    \"salvage\": [\"Shell Casings\", \"Blackpowder Pouch\"],\n    \"specimens\": [\"Wormapple Cores\"],\n    \"whispers\": [\"Distant Thunder\"],\n    \"charts\": [\"An Old Drunkard's Log\"]\n  },\n  \"Steep\": {\n    \"salvage\": [\"Ancestral China\", \"Blackened Brew-Pot\"],\n    \"specimens\": [\"Hightower Tea-Leaves\", \"Drip-Crystal\"],\n    \"whispers\": [\"Circle of Friends\", \"Truth in Steam\"],\n    \"charts\": [\"A Tea-Stained Map\"]\n  },\n  \"Surgeon\": {\n    \"salvage\": [\"Pristine Bandages\", \"Iron Leg-Brace\"],\n    \"specimens\": [\"Medicinal Herbs\", \"Rubbing Alcohol\"],\n    \"whispers\": [\"How Bones Mend\", \"A Scar That Never Fades\"],\n    \"charts\": [\"Directions To a Surgery\"]\n  },\n  \"Tempest\": {\n    \"salvage\": [\"Ceramic Battery\"],\n    \"specimens\": [\"Phosphorescent Beetle\"],\n    \"whispers\": [\"The Calm Before\", \"In the Blood\"],\n    \"charts\": [\"A Sketched Lightning-Strike\"]\n  },\n  \"Wordbearer\": {\n    \"salvage\": [\"Packaging Twine\", \"Dented Birdcage\", \"Old Wax\"],\n    \"specimens\": [\"Inscribed Centipede\", \"Slug-Gum Sealant\"],\n    \"whispers\": [\"My Heart to Yours\", \"Safe and Secure\"],\n    \"charts\": [\"A Junction Network Book\", \"A Scrawled Envelope\", \"A Tattered Schedule\"]\n  }\n}"
