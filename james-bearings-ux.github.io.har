          ],
          "cookies": [],
          "content": {
            "size": 140914,
            "mimeType": "application/json",
            "text": "{\n  \"Ardent\": [\n    {\n      \"name\": \"Tough as Nails\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You're a natural survivor. Rolls made to treat or heal an injury you're suffering from treat conflicts as triumphs.\"\n    },\n    {\n      \"name\": \"Ghostsight\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can clearly see spirits and the spectral realm.\"\n    },\n    {\n      \"name\": \"Strong Stomach\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Reduce the impact of poisons, diseases and sickness.\"\n    },\n    {\n      \"name\": \"Ironclad Mind\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You are immune to hallucinations, mesmerics and mental compulsions.\",\n      \"damageTypes\": [\n        {\n          \"category\": \"immunity\",\n          \"selectionType\": \"fixed\",\n          \"options\": [\n            \"Hallucinations\",\n            \"Mesmerics\",\n            \"Mental compulsions\"\n          ]\n        }\n      ]\n    },\n    {\n      \"name\": \"Guide My Hands\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Burn to borrow a measure of an ancestor's competency, gaining two ranks in any skill for the duration of a scene, gaining two ranks in any skill for the duration of a scene.\"\n    },\n    {\n      \"name\": \"Sporescarf\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Thickly-woven fibres sealed with tar. Resist the effects of bad air and airborne spores.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"bad air\",\n          \"airborne spores\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Pre-Verdant Heirloom\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A vestige of the long-buried past. When you would mark mire you can choose to mark this instead.\"\n    },\n    {\n      \"name\": \"Segmented Torc\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Crafted from reclaimed wreckage, said to hold the luck that others lack. Whenever you gain a temporary benefit, increase that benefit's track by one box\"\n    },\n    {\n      \"name\": \"Ajna\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A stringed instrument designed to be played by a duo, one using a bow and one plucking with spectral fingers. Mark to allow all present to see spirits and the spectral realm for the duration of a song.\"\n    },\n    {\n      \"name\": \"Scimitar\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A curved blade that deals CQ keen damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Machete\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"A trusty blade used as a tool as often as it is a weapon. Deals CQ hewing damage. Increase impact when clearing vegetation with this gear.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Hewing\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Hand Crossbow\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A compact crossbow. Deals LR spike damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Ragged Longcoat\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Keen, Spike, Hewing, Serrated\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Blunt\",\n          \"Keen\",\n          \"Spike\",\n          \"Hewing\",\n          \"Serrated\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Ancestral Spirit\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"You're haunted by a benevolent spirit. Mark to learn a secret from the spectral realm (once per scene).\"\n    },\n    {\n      \"name\": \"Watch-Wolf\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A loyal lupine companion that will defend you to the death. Deals CQ spike damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Grizzled Ratter\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A sly ship-born feline, adept at pursuing tiny creatures. Mark to create a resource, Hunter's Offering.\"\n    },\n    {\n      \"name\": \"Haughty Grandling\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A possessive ancestor hunched spectrally on your shoulders. The interior of any ship you crew resists wandering spirits while you're on board.\"\n    }\n  ],\n  \"Ektus\": [\n    {\n      \"name\": \"Towering\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"You stand head and shoulders above most others.\"\n    },\n    {\n      \"name\": \"1000 Needles\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Deal spike damage to any creature that attacks you with their own body in close quarters (such as with tail or bite attacks).\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Iris Blossom\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"You can see heat the way others see colour.\"\n    },\n    {\n      \"name\": \"Heliovore\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Heal a mark of damage on any one of your traits after spending a day in strong sunlight.\"\n    },\n    {\n      \"name\": \"Cactus-Flesh Filtration\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Use a task to give any liquid resource the 'Pure' tag.\"\n    },\n    {\n      \"name\": \"Longspine\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Your body is covered in iron-hard spines that deal CQ spike damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Tar-Scrawl Tattoos\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Resist the effects of bad air and airborne spores.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"bad air\",\n          \"airborne spores\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Solid Footing\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Treat conflicts as triumphs when attempting to avoid being tripped, pushed or forcefully moved.\"\n    },\n    {\n      \"name\": \"Grafted Limb\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"An ancient seal of a trade and fealty. Burn to call attention to this trophy and request a favour from another nonhostile ektus - it should not be refused.\"\n    },\n    {\n      \"name\": \"Stone-Bound Histories\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A tattered tome of ancient stories handed down by the eldest ektus survivors of the pre-verdant days. Use a task to gain a sliver of Pre-V information.\"\n    },\n    {\n      \"name\": \"Zephyrskin Drums\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A set of hip-drums decorated with saprekk-influenced patterns. Zephyrskin drums heat the air around them when played.\"\n    },\n    {\n      \"name\": \"Tower Shield\",\n      \"type\": \"Gear\",\n      \"track\": 5,\n      \"description\": \"An immense shield of wood and iron, built to last.\"\n    },\n    {\n      \"name\": \"Wedge-Axe\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A long-handled axe that deals CQ hewing damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Hewing\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Heavy Chakram\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A set of weighty throwing blades, dealing LR keen or hewing damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\",\n          \"Hewing\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Desert Harness\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Spike, Hewing, Serrated, Frost, Flame.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Spike\",\n          \"Hewing\",\n          \"Serrated\",\n          \"Frost\",\n          \"Flame\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Catekora\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A quilled, fibrous feline with a penchant for firing spines when provoked. Deals LR spike damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Burrowing Bees\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"Flightless desert bees that crawl across your body. You are immune to damage and effects caused by swarms.\"\n    },\n    {\n      \"name\": \"Flexneedle\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Your spines flex in an endless dance. Mark to ascend or descend a difficult surface without rolling, at impressive speed, without using your limbs to climb.\"\n    }\n  ],\n  \"Gau\": [\n    {\n      \"name\": \"Luminous Patches\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You can shed light at will.\"\n    },\n    {\n      \"name\": \"Unfurling Flare\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"A flexing mantle of myconic flesh that unfurls to increase your physical size. Treat conflicts as triumphs when intimidating smaller targets.\"\n    },\n    {\n      \"name\": \"Camouflage Mottle\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Increase impact when using hiding or moving stealthily in either a natural or urban environment (choose which environment when you take this trait).\"\n    },\n    {\n      \"name\": \"Fungal Tendril\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You have an additional tendril-like limb, allowing you to hold and manipulate more objects than usual.\"\n    },\n    {\n      \"name\": \"Mycofiltration\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"You can see perfectly within sporeclouds, and you resist the effects of bad air and airborne spores.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"bad air\",\n          \"airborne spores\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Spore-Sacs\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to obscure your current area with a dense cloud of spores.\"\n    },\n    {\n      \"name\": \"Naturally Hallucinogenic\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Your sheddings have mild psychotropic properties. Mark to create a rare resource, Hallucinogenic Spores.\"\n    },\n    {\n      \"name\": \"Fungal Fortress\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Keen, Hewing, Toxin, Acid, Frost.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Keen\",\n          \"Hewing\",\n          \"Toxin\",\n          \"Acid\",\n          \"Frost\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Proliferation\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Burn to grant an ally a copy of any one of your aspects (other than this one) as a temporary benefit. The benefit's track is equal to the original aspect's track.\"\n    },\n    {\n      \"name\": \"Medicine Pouch\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Others rarely ask where the medicines are collected. Use a task to create a rare resource, Medicinal Herbs.\"\n    },\n    {\n      \"name\": \"Nurturing Pitch-Jar\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"A blackened glass jar that holds an eager colony of ironroot mold. Use a task to create a specimen copy of any piece of salvage you own, with the 'fungal' tag.\"\n    },\n    {\n      \"name\": \"Jag-Lash\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A leather cord studded with teeth or salvaged metal. Deals CQ serrated damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Serrated\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Spore-Slinger\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A sling-like contraption for lobbing spore-bombs, dealing LR toxin or blast damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Toxin\",\n          \"Blast\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Pangoshroom\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"A slow-moving but well-armoured fungal companion that wants nothing more than to keep you safe.\"\n    },\n    {\n      \"name\": \"Sporehund\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A loyal companion that deals CQ toxin damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Toxin\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Cordysect\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A slow-flying beetle riddled with fungal growths. Mark to gain a burst of dense sensory information from its surroundings, revealing oddities and secrets.\"\n    },\n    {\n      \"name\": \"Mycomelding\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can use a task to absorb spores from the air around you, gaining a single temporary rank in two different skills of your choice. These ranks last until you next use the Mycomelding aspect.\"\n    }\n  ],\n  \"Ironbound\": [\n    {\n      \"name\": \"Titanic\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"You're an imposing presence, a weight on the world.\"\n    },\n    {\n      \"name\": \"Ghost-Heart\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You count as fluent when communicating with ghosts, spirits and other ironbound, regardless of languages used.\"\n    },\n    {\n      \"name\": \"Monument to Travel\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Whenever you gain a chart, mark to gain a related whisper as well.\"\n    },\n    {\n      \"name\": \"Fruiting Limb\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Use a task to create a resource, Keel-Fruit.\"\n    },\n    {\n      \"name\": \"Attenuate\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Your animating spark can leave your body for a short time, becoming ghost-like and insubstantial but still capable of movement.\"\n    },\n    {\n      \"name\": \"Structural Integration\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Once per journey you may repair a mark of damage on your ship without rolling.\"\n    },\n    {\n      \"name\": \"Vocal Recovery\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can dredge up the voices of sailors long-lost, changing your pitch, tone and accent on a whim. Burn to speak the truth of a lost sailor.\"\n    },\n    {\n      \"name\": \"Spotlight Lantern\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Flameless, but terribly bright nonetheless. Consume a resource as fuel to allow your entire crew to see perfectly in darkness, sporeclouds and general murk.\"\n    },\n    {\n      \"name\": \"Ancient Tar-Seals\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"You're immune to the effects of crezzerin.\",\n      \"damageTypes\": {\n        \"category\": \"immunity\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"crezzerin effects\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Living Workshop\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Your own wreck-salvaged body contains an array of useful tools - your presence gives an automatic advantage on rolls taken to create temporary gear and machinery to all crewmates.\"\n    },\n    {\n      \"name\": \"Prowhammer\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A ship's prow, refashioned into a massive bludgeoning weapon. Deals CQ blunt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Ornate Cannon\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"A huge ships's cannon loaded with explosive shells. Deals LR blast damage. Increase impact when targeting a horde or swarm of targets.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blast\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Broadwood Carapace\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Keen, Serrated, Acid, Volt.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Blunt\",\n          \"Keen\",\n          \"Serrated\",\n          \"Acid\",\n          \"Volt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Reef-Iron Plating\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Spike, Hewing, Serrated, Frost, Flame.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Spike\",\n          \"Hewing\",\n          \"Serrated\",\n          \"Frost\",\n          \"Flame\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Shipside Symbiote\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"When your ship would take damage to any of its ratings you may mark boxes equal to that damage on this companion instead.\"\n    },\n    {\n      \"name\": \"Sailghast\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"A mass of living canvas capable of flight. Mark to have it tangle around a target, restricting their movement.\"\n    },\n    {\n      \"name\": \"Delver's Drill\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A huge drill, designed for boring through ironroot bark. You cut when attempting deft movements, but can deal high-impact CQ Serrated damage.\"\n    }\n  ],\n  \"Ketra\": [\n    {\n      \"name\": \"Gelatinous Form\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"You have an inherent weakness to salt damage, but can squeeze and compress your body enough to move through spaces much smaller than expected.\",\n      \"damageTypes\": {\n        \"category\": \"weakness\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Salt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Sensory Stalks\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"A rare mutation that hones your sight. You can see clearly without light.\"\n    },\n    {\n      \"name\": \"Crawling Pattern\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"The glowing patches on your flesh crawl at your command, even onto others nearby. Mark this track to create a dim but lasting light on you or a nearby target.\"\n    },\n    {\n      \"name\": \"Tunnel-Wise\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Treat conflicts as triumphs when navigating or moving through enclosed areas.\"\n    },\n    {\n      \"name\": \"Whispers in the Dark\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"While in a dimly lit or unlit area, mark to learn a secret from the darkness (once per scene).\"\n    },\n    {\n      \"name\": \"Scrapper Enzymes\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can use salvage as a component when concocting a potion or chemical mixture, no matter its form.\"\n    },\n    {\n      \"name\": \"Voltaic Mantle\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"The tendrils of your mantle crackle with lightning as they strike, dealing CQ volt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Volt\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Driftwood Core\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Spike, Toxin, Frost, Volt.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Blunt\",\n          \"Spike\",\n          \"Toxin\",\n          \"Frost\",\n          \"Volt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Rebreather Mask\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You have a short supply of clean air you can tap into when you need to, and you also resist the effects of bad air and airborne spores.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"bad air\",\n          \"airborne spores\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Climbing Hooks\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Attached to a harness or embedded in your gelatinous flesh. Ignore cut while climbing, as long as you're moving with care.\"\n    },\n    {\n      \"name\": \"Driving-Chain\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A rusted chain from a long-dead machine, now wielded as a weapon dealing blunt damage at CQ or LR.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\"\n        ],\n        \"range\": \"CQ/LR\"\n      }\n    },\n    {\n      \"name\": \"Scrap-Metal Skeleton\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"The internal structures you've collected can store biovoltaic energy. Use a task to create a resource, Scrap-Bone Battery.\"\n    },\n    {\n      \"name\": \"Old Ore Piercings\",\n      \"type\": \"Gear\",\n      \"track\": 1,\n      \"description\": \"You're immune to the usual effects of crezzerin. Concentrated sources of crezzerin heal rather than harm you.\",\n      \"damageTypes\": {\n        \"category\": \"immunity\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"crezzerin effects\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Oiljelly\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"A slick, symbiotic slime-like creature bonded with your body.\"\n    },\n    {\n      \"name\": \"Drone Attendant\",\n      \"type\": \"Companion\",\n      \"track\": 5,\n      \"description\": \"A simple punchcard-driven repair construct. Increase impact when repairing or tinkering with other machines.\"\n    },\n    {\n      \"name\": \"Plasmic Form\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Your flesh is malleable and regenerative, even by Ketra standards. Mark Mire to gain a rare resource, Living Protoplasmic Flesh.\"\n    }\n  ],\n  \"Mothryn\": [\n    {\n      \"name\": \"Dust and Paper\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"Your form is slim, light, and deceptively difficult to land a solid hit on.\"\n    },\n    {\n      \"name\": \"Elegant Wings\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Though most mothryn wings now serve as decoration, yours are uncommonly strong. You can glide with ease, or mark for a short burst of elegant flight\"\n    },\n    {\n      \"name\": \"Scatterscale\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Mark to create a cloud of fine dust that refracts light and distorts perception - your own senses are unaffected\"\n    },\n    {\n      \"name\": \"Thick Fur\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You're weak to Flame, but resist the effects of bad air and airborne spores.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"bad air\",\n          \"airborne spores\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Elaborate Beard-Braids\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Your beard is a rich, intertwining mass of fur and braids, perfect for concealing small objects. Burn to gain a new piece of salvage or specimen from within it (that you might conceivably have stashed there).\"\n    },\n    {\n      \"name\": \"Prismatic Antennae\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Dense clusters of sensory fronds grow from your antennae, letting you see clearly without light and through clouds of dust or spores.\"\n    },\n    {\n      \"name\": \"I Used to Know This\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can treat a conflict as a triumph when rolling for an action without a skill adding to your dice pool (once per scene).\"\n    },\n    {\n      \"name\": \"Chaos Dancing\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"A fighting style that makes use of wing-edges and scything kicks. Deals CQ keen or spike damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\",\n          \"Spike\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Ceremonial Patterning\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Your wings are a riot of colour and style. Mark to increase impact when trying to impress or convince.\"\n    },\n    {\n      \"name\": \"Marks of Where We've Been\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Chart-like decorations cover your wings and fur. Mark to use this aspect in place of a chart, but only when travelling through an area you've visited before.\"\n    },\n    {\n      \"name\": \"Flowing Fabrics\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Keen, Blast, Acid, Frost, Salt.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Keen\",\n          \"Blast\",\n          \"Acid\",\n          \"Frost\",\n          \"Salt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Wing-Studs\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Can be launched like shrapnel with a deft twist, dealing LR blunt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Silkspire Byx\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"A living golem of beautifully spun silks, usually in vaguely lupine shape.\"\n    },\n    {\n      \"name\": \"Tolycat\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"A domesticated felinesque insect that sheds medicinally potent scale-dust. Your entire crew has resistance against infections and diseases.\"\n    },\n    {\n      \"name\": \"Mutterdust\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Your wings vibrate softly, the air around you shimmering with natural dust. This cloud doesn't impede vision, but does allow any individuals within it to communicate silently in any language they know.\"\n    }\n  ],\n  \"Tzelicrae\": [\n    {\n      \"name\": \"Arachnid Mobility\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"You never cut for difficulty when climbing.\"\n    },\n    {\n      \"name\": \"The Lottery of Skin\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Choose either Ardent, Ektus or Gau. You can pass as a member of this species under casual inspection.\"\n    },\n    {\n      \"name\": \"Ersatz Limbs\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You have one or more additional arms, allowing you to hold and manipulate many objects at once.\"\n    },\n    {\n      \"name\": \"Tremorsense\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"You can feel even the smallest vibrations in the air and ground around you.\"\n    },\n    {\n      \"name\": \"Gossamercraft\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to produce a resource, Silk-Like Web (either dry or sticky).\"\n    },\n    {\n      \"name\": \"Manifold Linguist\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You count as fluent when communicating with intelligent insects, hive-minds and other tzelicrae, regardless of languages used.\"\n    },\n    {\n      \"name\": \"Spiderbite\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You have a set of fangs that can deal CQ toxin damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Toxin\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Shirk the Skin\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"Burn to leave your skin for a short period. When outside your skin you are a mass of moving spiders, and can easily move through small spaces and climb any surface.\"\n    },\n    {\n      \"name\": \"Shroom Hookah\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Keen, Spike, Serrated, Hewing, Toxin.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Keen\",\n          \"Spike\",\n          \"Serrated\",\n          \"Hewing\",\n          \"Toxin\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Motley Carapace\",\n      \"type\": \"Gear\",\n      \"track\": 5,\n      \"description\": \"You've incorporated an assortment of discarded armour pieces into your skin.\"\n    },\n    {\n      \"name\": \"Hush-Silk Garments\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Your clothes are woven of fine silk that naturally dampens sound, making even your dramatic movements almost entirely silent.\"\n    },\n    {\n      \"name\": \"Iron Satchel\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A secure, wearable lockbox that can only be opened by a single specific spider within you.\"\n    },\n    {\n      \"name\": \"Blade of Husks\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A ritual weapon made from the chitin of lost colonymembers. Deals CQ keen or salt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\",\n          \"Salt\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Swarm-Scout\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A single spider you can send ahead as a scout, allowing you to see and hear at a distance.\"\n    },\n    {\n      \"name\": \"Rogue Doomsayer\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"An unsettled fragment of personality. Mark to request a dark and unbidden (but likely pertinent) thought from the Firefly.\"\n    },\n    {\n      \"name\": \"Bidingweb\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Slim filaments surround you, almost impossible to see. When an event would take you by surprise, mark to hijack focus.\"\n    }\n  ],\n  \"Amberclad\": [\n    {\n      \"name\": \"Endless Golden Age\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"You didn't age throughout your imprisonment, and you don't seem to be aging now you're free either. A blessing, but a curious one.\"\n    },\n    {\n      \"name\": \"All So Familiar\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Muscle memory takes over. Treat conflicts as triumphs when interacting with newly uncovered pre-Verdant artefacts.\"\n    },\n    {\n      \"name\": \"Unbroken Family Line\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You may have been asleep for hundreds of years, but some of your kin have been thriving. Burn to tie an individual or settlement to your family in some way.\"\n    },\n    {\n      \"name\": \"Ambervein\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You're weak to Blunt damage, but immune to the harmful effects of crezzerin.\",\n      \"damageTypes\": {\n        \"category\": \"immunity\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"crezzerin effects\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Dream-Dredge\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"There are impressions of a forest-less world, but grasping them is like holding onto a dream. Use a task to gain a sliver of Pre-V information.\"\n    },\n    {\n      \"name\": \"Resokinesis\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to gain a measure of control over sap, resins, and amber.\"\n    },\n    {\n      \"name\": \"Just a Scratch\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to produce a resource, Warm Amber Shards or Dripping Resin.\"\n    },\n    {\n      \"name\": \"Shattered Eye\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Something you usually use to see is broken, ambered and still lingering in sleep. You can see glimpses of a person's recent dreams clinging to them if you concentrate.\"\n    },\n    {\n      \"name\": \"Fragmented Limb\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Cracked and floating just free of your body. When you take this gear, decide whether it deals CQ Blunt, Keen, or Spike damage (you can change this damage type by using a task).\"\n    },\n    {\n      \"name\": \"Heart of Resin\",\n      \"type\": \"Gear\",\n      \"track\": 1,\n      \"description\": \"Burn to create a perfect copy of yourself in living amber and drift into a deep sleep. You control the copy until it dies or you choose to destroy it, upon which time you wake with its memories and experiences as dreams.\"\n    },\n    {\n      \"name\": \"Half-Clogged Firearm\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A double-barreled pre-verdant shotgun, one of the firing chambers hopelessly clogged. Deals LR Blast damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blast\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Shard-Cloak\",\n      \"type\": \"Gear\",\n      \"track\": 5,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Keen, Spike, Serrated, Hewing, Salt.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Keen\",\n          \"Spike\",\n          \"Serrated\",\n          \"Hewing\",\n          \"Salt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Pre-V Pet\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"A faithful friend from the old times that was trapped, and freed, alongside you. Not particularly suited to the wild world, but most likely revelling in it.\"\n    },\n    {\n      \"name\": \"Closer to the Past\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Choose a skill you have zero ranks in. When under the effects of Pressure, this skill has ranks equal to the current Pressure Level (maximum three).\"\n    }\n  ],\n  \"Anchored\": [\n    {\n      \"name\": \"By a Thread\",\n      \"type\": \"Trait\",\n      \"track\": 1,\n      \"description\": \"Your grip on the world is tentative, but that does come with certain benefits. You are weak to salt and volt damage, but immune to blunt, keen and spike.\",\n      \"damageTypes\": [\n        {\n          \"category\": \"weakness\",\n          \"selectionType\": \"fixed\",\n          \"options\": [\n            \"Salt\",\n            \"Volt\"\n          ]\n        },\n        {\n          \"category\": \"immunity\",\n          \"selectionType\": \"fixed\",\n          \"options\": [\n            \"Blunt\",\n            \"Keen\",\n            \"Spike\"\n          ]\n        }\n      ]\n    },\n    {\n      \"name\": \"Spectral Variance\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to become insubstantial for a short time, allowing you to float and pass through solid objects.\"\n    },\n    {\n      \"name\": \"Mortal Needs\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Though you can do so if you choose, you have no real need to eat, drink, sleep or breathe.\"\n    },\n    {\n      \"name\": \"Ethereal Healing\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"When being healed or having your gear repaired, resources used are not consumed as normal - instead they degrade, giving them a negative tag (if they already have a negative tag, they're consumed as normal).\"\n    },\n    {\n      \"name\": \"Touch of the Beyond\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Once per scene, when your crew gains a resource, you can choose to give it the Spectral tag.\"\n    },\n    {\n      \"name\": \"Geist Hand\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can manipulate nearby objects without touching them, though the heavier they are the harder it is.\"\n    },\n    {\n      \"name\": \"Death Mask\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Some anchored prefer to hide their face, letting the memories of their time among the living fade. Treat conflicts as triumphs when attempting to unnerve or unsettle.\"\n    },\n    {\n      \"name\": \"Siphoning Fork\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Whenever your crew gains a piece of cargo, gain a whisper related to it (or its previous owners) for yourself.\"\n    },\n    {\n      \"name\": \"Phantom Blade\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"The ghost of a sword hovering at your hip. Deals CQ salt damage, and doesn't have to be held to be used.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Salt\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Anchor Fragment\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A smaller piece hewed from a greater whole. Burn to immediately and completely heal any one of your injuries.\"\n    },\n    {\n      \"name\": \"Resonant Tether\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Spirits and the spectral realm become more visible and tangible to your entire crew in your presence.\"\n    },\n    {\n      \"name\": \"Battered Ajna\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A stringed instrument meant to be played in tandem by the living and the dead, but you can play both parts. Empowers nearby spirits when played.\"\n    },\n    {\n      \"name\": \"Tempered Anchor\",\n      \"type\": \"Gear\",\n      \"track\": 5,\n      \"description\": \"Your anchor to the world is reinforced against damage and tampering, a wise move for a fleeting ghost.\"\n    },\n    {\n      \"name\": \"Faithful Spirit\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"Loyal to the grave, and beyond. Mark to ignore the effects of an active mire for the rest of the scene.\"\n    },\n    {\n      \"name\": \"Reavolver\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A six-shooter with permanently empty chambers, smelling of darkness and wandering ghosts. Deals LR Salt damage, and any spirit struck by this weapon is dragged into complete corporeality for a short time.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Salt\"\n        ],\n        \"range\": \"LR\"\n      }\n    }\n  ],\n  \"Ridgeback\": [\n    {\n      \"name\": \"Barrel-Chested\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"You may not be built fancy, but you are built sturdy.\"\n    },\n    {\n      \"name\": \"Stone Hearted\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Once per scene, increase impact on any successful action taken whilst on ancient ground.\"\n    },\n    {\n      \"name\": \"Search for Omens\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to ask a question and receive an omen to interpret in return (supplied by the Firefly).\"\n    },\n    {\n      \"name\": \"Thick Skin\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Toxin, Cold, Salt, Volt.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Blunt\",\n          \"Toxin\",\n          \"Salt\",\n          \"Volt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Crushing Blows\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Your fists and feet are the only weapons you need. They deal CQ blunt and salt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\",\n          \"Salt\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Fragments Like Gods\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Whenever you gain a stone-based resource, give it the Sacred tag.\"\n    },\n    {\n      \"name\": \"Archaeodermis\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Your skin (or whatever you have as an outer covering) mimics the mountain you were raised on. You're immune to keen damage, as well as bites and stings from small creatures.\",\n      \"damageTypes\": {\n        \"category\": \"immunity\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Chipping Tools\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Treat conflicts as triumphs when altering or working with stone or bone\"\n    },\n    {\n      \"name\": \"Leviathan Furs\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"You never mark mire when confronted with an unknown or terrifying beast, no matter the size.\"\n    },\n    {\n      \"name\": \"Ritual Mask\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You can clearly see spirits and the spectral realm.\"\n    },\n    {\n      \"name\": \"Whispering Charm\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Consume a whisper to learn a secret about a nearby individual (supplied by the Firefly).\"\n    },\n    {\n      \"name\": \"Hexed Tooth\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Mark to levitate and control exposed bone.\"\n    },\n    {\n      \"name\": \"Great Beast Horns\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"These might have deep ceremonial meaning, or just cut an impressive silhouette - either way these horns deal CQ spike damage, and you ignore cut when defending yourself against charging opponents.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Shamanic Idol\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Holds a sliver of power from a not-quite-god. Deals LR salt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Salt\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Swift Hawk\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"A surly, vicious bird that can deal LR keen damage. Once per scene, hijack to temporarily blind or distract an attacking opponent.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Mountain Snouter\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"An ill-tempered boar with cruel tusks. Deals CQ spike damage, and is large enough to ride.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Surface Stone\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Not somethign to be worshipped, but most definitely something to be remembered. Burn to reduce the Pressure Level by one.\"\n    }\n  ],\n  \"Rootless\": [\n    {\n      \"name\": \"Family Ties\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"When you make a discovery during a journey, mark to tie it to your family in some way (such as a blood relative, fleetfamily member or family friend).\"\n    },\n    {\n      \"name\": \"Hull Hearted\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Once per scene, increase impact on any successful action taken whilst aboard a ship you own or crew.\"\n    },\n    {\n      \"name\": \"Wild Words\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to remember a rumour or folktale pertinent to your situation (supplied by the Firefly).\"\n    },\n    {\n      \"name\": \"Needs Must\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You never mark mire for consuming food or drink, no matter the source or condition.\"\n    },\n    {\n      \"name\": \"Born to Sail\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You always know true North, and ignore cut on movement-related actions caused by adverse seas or damage to your ship.\"\n    },\n    {\n      \"name\": \"Sundew Senses\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can instantly identify the presence and potential dangers of nearby predatory plants, no matter how well they're camouflaged.\"\n    },\n    {\n      \"name\": \"Fleetfamily Scarf\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A beautifully made sporescarf passed from traveller to seasoned traveller. You're immune to the effects of bad air and airborne spores.\",\n      \"damageTypes\": {\n        \"category\": \"immunity\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"bad air\",\n          \"airborne spores\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Nomad's Phrasebook\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Whenever you take a montage you can study your phrasebook (in addition to your usual task), gaining a smattering of any one language until your next montage.\"\n    },\n    {\n      \"name\": \"Mechanical Limb\",\n      \"type\": \"Gear\",\n      \"track\": 5,\n      \"description\": \"A rusting prosthetic that feels no pain.\"\n    },\n    {\n      \"name\": \"Fishing Lure\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Add a positive tag to any living specimen you acquire while fishing.\"\n    },\n    {\n      \"name\": \"Patterned Sash\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Treat conflicts as triumphs when using social skills to affect animals.\"\n    },\n    {\n      \"name\": \"Shortspear\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Traditionally used for deckside defence. Deals CQ spike damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Slingshot\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A simple slingshot, loaded with anything from stones to scrap to seeds. Deals LR blunt or blast damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\",\n          \"Blast\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Tarscale Armour\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Resist the hazardous effects of crezzerin exposure (searing, hallucinations, mutation).\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"crezzerin effects\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Springfox\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A nimble wildsea vulpine known to dance in the wake of larger ships. Once per journey you may treat the outcome of a watch roll as Peace, no matter the result.\"\n    },\n    {\n      \"name\": \"Ring-Tailed Rabble-Rouser\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"A pugnacious lemur companion with a natural curiosity when it comes to the running of a wildsea vessel.\"\n    },\n    {\n      \"name\": \"Adaptive Ratter\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"A long-whiskered cat with a taste for chitin. The interior of any ship you crew resists insect incursions while you're on board, as does the deck (even without a pressure shell).\"\n    }\n  ],\n  \"Shankling\": [\n    {\n      \"name\": \"Head for Heights\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You're immune to vertigo, nausea and mire caused by heights and precarious positions.\"\n    },\n    {\n      \"name\": \"Skybridge Step\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"An elegant defensive dance that keeps you out of harm's way.\"\n    },\n    {\n      \"name\": \"High Ground\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Once per scene, increase impact on any successful action taken whilst you have the high ground.\"\n    },\n    {\n      \"name\": \"Rising Meteor\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to sprint up a surface that would usually require you to climb it, even if it's unstable.\"\n    },\n    {\n      \"name\": \"From Bough to Brain\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"Use a task to study a tree (of any size) and learn its secrets, age and condition (supplied by the Firefly).\"\n    },\n    {\n      \"name\": \"Hawksight\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You can see much further and in greater clarity than the typical wildsailor.\"\n    },\n    {\n      \"name\": \"Grappling Hook\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"When the hook is thrown and anchored it allows you to swing over chasms and climb sheer surfaces. Treat conflicts as triumphs when climbing or swinging.\"\n    },\n    {\n      \"name\": \"Glider's Cloak\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You can land safely after any prepared fall.\"\n    },\n    {\n      \"name\": \"Balancing Staff\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Both a weapon and an acrobatic aid. Deals CQ blunt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Raptor's Claw\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A talon-like gauntlet inspired by the hunting patterns of wingless birds. Deals CQ hewing damage, and can be used to make controlled descents down vertical surfaces.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Hewing\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Broadwood Bow\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Exquisitely crafted. Deals LR spike or toxin damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\",\n          \"Toxin\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Feathered Mantle\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Serrated, Toxin, Frost, Salt.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Blunt\",\n          \"Serrated\",\n          \"Toxin\",\n          \"Frost\",\n          \"Salt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Sentinel Skywing\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"A watchful bird, often used for scouting remote areas. Mark to learn a secret of the surrounding waves.\"\n    },\n    {\n      \"name\": \"Bark-Peeling Ferret\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"Expert at routing hidden bugs, even from the mighty ironroots. Mark or use a task to gain an insect specimen from a nearby branch or tree trunk.\"\n    },\n    {\n      \"name\": \"Feathered Raptor\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A beautifully-feathered lizard, the result of generations of careful breeding to engender a modicum of sociability (still not quite there yet). Deals CQ hewing damage, and is large enough to ride.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Hewing\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Flutter-Lamps\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A set of moth-lanterns on a string, carrying both light and cheer to fight the encroaching dark. Sheds a gentle glow, and nearby crew ignore any mire that would be marked due to darkness (living or otherwise).\"\n    }\n  ],\n  \"Spit-Born\": [\n    {\n      \"name\": \"Pit-Fight Survivor\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"You learnt how to take a beating and stay standing.\"\n    },\n    {\n      \"name\": \"Urban Exploration\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to discover a friendly lead on services or information when in a port or city.\"\n    },\n    {\n      \"name\": \"Cobble Hearted\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Once per scene, increase impact on any successful action taken whilst in a port or city.\"\n    },\n    {\n      \"name\": \"Every Street Tells a Story\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to learn a secret of a port or city you're docked at.\"\n    },\n    {\n      \"name\": \"Through the Throng\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Treat conflicts as successes when moving through crowds, herds and swarms.\"\n    },\n    {\n      \"name\": \"Shrewd Marketeer\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Treat conflict as triumphs when haggling over an exchange of cargo or resources.\"\n    },\n    {\n      \"name\": \"Spit & Polish\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Use a task to remove a negative tag (such as rusted or broken) from any piece of salvage.\"\n    },\n    {\n      \"name\": \"Life of Scraps\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"When gaining a benefit from a meal or alchemical concoction, ignore any associated negative effects.\"\n    },\n    {\n      \"name\": \"Scrutineer Eyepiece\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"You can tell a fake, forgery or counterfeit item at a glance.\"\n    },\n    {\n      \"name\": \"Acrid Long-Stem\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A spice-filled pipe made to burn its contents with acid rather than flame. Injury tracks you become subject to are one box shorter than normal.\"\n    },\n    {\n      \"name\": \"Docker Threads\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Resist the hazardous effects of crezzerin exposure (searing, hallucinations, mutation).\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"crezzerin effects\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Brass Knucle\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A brute but reliable weapon for street fights. Deals CQ blunt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Black-Market Pistol\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A firearm sourced from unsavoury types. Deals LR blast damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blast\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Trained Ratroach\",\n      \"type\": \"Companion\",\n      \"track\": 1,\n      \"description\": \"A gutter-scavenger by nature, now working on your behalf. Once per montage gain a small salvage or specimen resource with a negative tag (in addition to your usual task).\"\n    },\n    {\n      \"name\": \"Calico Slink\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A semi-spectral cat winds its way around your legs. You have the ability to see clearly without light.\"\n    },\n    {\n      \"name\": \"Pangopod\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"Half pangolin, half squid. Surprisingly cute.\"\n    },\n    {\n      \"name\": \"Pilferer\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Whenever your crew gains a piece of cargo, gain a resource related to it for yourself (either salvage or specimen, whichever is most appropriate).\"\n    }\n  ],\n  \"Alchemist\": [\n    {\n      \"name\": \"Component Scrounger\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"When one of your crewmates acquires an alchemically useful specimen, gain a copy of that specimen for yourself (once per scene).\"\n    },\n    {\n      \"name\": \"Alchemical Unearthing\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Whenever you discover a new location, choose a unique property (represented by a tag) to be easily found on specimens or salvage there.\"\n    },\n    {\n      \"name\": \"Ulcerous Alembic\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You can swallow two alchemical components, keeping them safely in your stomach. You can concoct them internally when you choose, benefitting immediately from the results or spitting the resulting solution out.\"\n    },\n    {\n      \"name\": \"The Old Ways\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Increase impact when concocting using only bone, organs or insect parts as components.\"\n    },\n    {\n      \"name\": \"Pestle-Pound\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Use a task to grind a specimen into a powder, changing its form to a dust or salt and giving it the 'Pure' tag.\"\n    },\n    {\n      \"name\": \"Baseline\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to briefly ignore any positive or negative effects stemming from a temporary benefit or injury. You are always immune to the negative effects of crezzerin.\",\n      \"damageTypes\": {\n        \"category\": \"immunity\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"crezzerin effects\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Heady Vapours\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Mark to ruminate on a question and receive a confusing yet accurate answer. Burn instead to receive instant clarity from that answer.\"\n    },\n    {\n      \"name\": \"Chemicokinesis\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to levitate and control impure liquids.\"\n    },\n    {\n      \"name\": \"Metabolize\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Consume a specimen to gain a brief burst of sensory information related to the specimen consumed (such as tremorsense by consuming a spider's web, for example).\"\n    },\n    {\n      \"name\": \"Catalyst Belt\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A heavy work-pack containing reagents and catalysts, tried and tested. Mark to use a chemical from the belt in place of a specimen when concocting.\"\n    },\n    {\n      \"name\": \"Explosive Vials\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Not an endless supply, but potent and disorienting. Mark to deal LR blast, salt, acid or toxin damage to multiple nearby foes.\"\n    },\n    {\n      \"name\": \"Dilution Agent\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"When you create a concoction, the entire crew can gain the benefit it offers as a one-track temporary aspect.\"\n    },\n    {\n      \"name\": \"Pressure-Sealed Linkage\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Treat conflicts as triumphs when using at least one liquid as a resource for a concoction.\"\n    },\n    {\n      \"name\": \"Accelerant Vial\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Consume an additional specimen to create a lasting concoction as an action (rather than the usual task).\"\n    },\n    {\n      \"name\": \"Living Liquid\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"Winds its way around your form, studded with broken glass. Deals CQ acid or keen damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Acid\",\n          \"Keen\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Syringiosquito\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"A diminutive alchemical construct designed to hold and drain fluids without being detected.\"\n    },\n    {\n      \"name\": \"Extraction Techniques\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Consume a crezzer-tainted specimen. In its place you gain two new specimens, the first a sample of Extracted Crezzerin, and the second based on the remains of the consumed resource.\"\n    },\n    {\n      \"name\": \"Broke-Mirror Mist\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Burn to spread a perception-altering clous through your current area for the duration of a scene that prevents cut results being counted for Scrutiny. Individuals in this cloud also gain resistance against precise incoming attacks, but cut when targeting their own attacks.\"\n    }\n  ],\n  \"Char\": [\n    {\n      \"name\": \"Only the Best\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Mark when gathering a specimen to give it the 'Pure' tag.\"\n    },\n    {\n      \"name\": \"Ingredient Scrounger\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"When one of your crewmates acquires a potentially delicious specimen, gain a copy of that specimen for yourself (once per scene).\"\n    },\n    {\n      \"name\": \"Golden Nose\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to identify a rare ingredient in your vicinity by scent alone.\"\n    },\n    {\n      \"name\": \"Bountiful Discovery\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Whenever you discover a new location, choose a single specimen type to be easily found there.\"\n    },\n    {\n      \"name\": \"Deep in the Barrel\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Increase impact when cooking with rotten or otherwise tainted ingredients. Meals made with these ingredients won't sicken your crew.\"\n    },\n    {\n      \"name\": \"Enough for Everybody\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"When you create a lasting meal the entire crew can gain the benefit it offers as a one-track temporary aspect.\"\n    },\n    {\n      \"name\": \"Taste Test\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You're immune to poisons, and can determine their presence and characteristics by taste alone.\",\n      \"damageTypes\": {\n        \"category\": \"immunity\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"poisons\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Acid-Etched Cookpot\",\n      \"type\": \"Gear\",\n      \"track\": 5,\n      \"description\": \"A hefty pot of near-unbreakable construction, used to prepare and store food or hide under in a tense situation.\"\n    },\n    {\n      \"name\": \"Mechanical Grinder\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Consume an additional specimen to create a lasting meal as an action (rather than the usual task).\"\n    },\n    {\n      \"name\": \"Flavour Engineer\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can treat salvage as specimens when creating meals. The results are still oddly edible.\"\n    },\n    {\n      \"name\": \"Spice Bandoleer\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A bandoleer containing your own secret blend of spices that never seems to run dry. Mark to create a rare resource, either Wilds Pepper, Hangman's Blend or Smouldergrit.\"\n    },\n    {\n      \"name\": \"Trademark Herbs\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"The right seasoning can make anything taste good. Mark to treat conflict results as triumphs while cooking..\"\n    },\n    {\n      \"name\": \"Seasoned Cleaver\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"As useful on the battlefield as it is in the galley. Deals CQ hewing damage. Increase impact when acquiring dangerous or disruptive specimens.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Hewing\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Reef-Iron Pan\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A colossal implement. Deals CQ blunt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Husk-Leather Apron\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Toxin, Acid, Blast, Salt, Flame.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Toxin\",\n          \"Acid\",\n          \"Blast\",\n          \"Salt\",\n          \"Flame\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Sous Squirrel\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"A red-furred bundle of activity. Once per montage gain a common insect specimen appropriate to the region (in addition to your usual task).\"\n    },\n    {\n      \"name\": \"The Only Knife\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Shaped, honed, perfectly balanced. Deals CQ Keen damage, and lets you increase impact when creating a dish using raw meat. Raw meat dishes prepared in this way never sicken you or your crewmembers.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\"\n        ],\n        \"range\": \"CQ\"\n      }\n    }\n  ],\n  \"Corsair\": [\n    {\n      \"name\": \"Steel-Step Dance\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"The key to survival is mobility. They can't hurt you if they can't hit you.\"\n    },\n    {\n      \"name\": \"Stamp-Down Samba\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"The key to survival is solidity. You can take whatever they throw your way and stay standing.\"\n    },\n    {\n      \"name\": \"Dirty Fighter\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Treat conflicts as triumphs when attempting to trip, knock down, blind or stun opponents.\"\n    },\n    {\n      \"name\": \"Surgical Strike\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can target attacks precisely (such as when aiming for a weak point) without cutting for difficulty.\"\n    },\n    {\n      \"name\": \"Prowess\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to increase impact when attacking at close quarters.\"\n    },\n    {\n      \"name\": \"Dangersense\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to hijack focus from a trap or ambush as it triggers.\"\n    },\n    {\n      \"name\": \"Chain Attack\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You can deal damage to multiple nearby opponents with a successful CQ attack.\"\n    },\n    {\n      \"name\": \"Scars That Tell Stories\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to gain a whisper based on damage or an injury you've just taken, supplied by the Firefly\"\n    },\n    {\n      \"name\": \"Protective Beacon\",\n      \"type\": \"Gear\",\n      \"track\": 5,\n      \"description\": \"Treat conflicts as triumphs when attempting to prevent harm being done to a member of the undercrew.\"\n    },\n    {\n      \"name\": \"Berserker\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You're immune to mire while in combat, or any mire that would be caused by witnessing violence.\"\n    },\n    {\n      \"name\": \"Flashpowder Pouches\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Shake gently to produce temporary torchlight, or mark to produce a blinding flash.\"\n    },\n    {\n      \"name\": \"Corsair's Sabre\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A classic wildsea blade. Deals CQ keen damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Boarding Axe\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"A savage weapon used to chop through foes. Deals CQ hewing damage. Increase impact when attacking ships, objects and structures.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Hewing\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Slinghammer\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A versatile weighted hammer with a fabric tether. Deals blunt damage at CQ or LR.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\"\n        ],\n        \"range\": \"CQ/LR\"\n      }\n    },\n    {\n      \"name\": \"Throwing Knives\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Perfectly weighted. Deals LR keen or spike damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\",\n          \"Spike\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Dragonfly Mantle\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Keen, Spike, Hewing, Blast.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Blunt\",\n          \"Keen\",\n          \"Spike\",\n          \"Hewing\",\n          \"Blast\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Hooded Crow\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A loyal bird trained to distract opponents in close-range combat. Mark to hijack focus from a nearby enemy as they attempt to attack, once per scene.\"\n    },\n    {\n      \"name\": \"Metzaka Feathers\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A feathered charm made from the remains of a spectral crow. When wrapped around the hilt of a CQ weapon, it allows that weapon to deal LR damage instead. It can also deal damage without being physically held, freeing your hands for other tasks.\"\n    },\n    {\n      \"name\": \"Comet-Forged Sabre\",\n      \"type\": \"Gear\",\n      \"track\": 1,\n      \"description\": \"A fragile blade made for precise, debilitating strikes. Deals CQ Keen damage. When attacking, a triumph allows you to reduce a slashed target's immunity or resistance to a single type of damage by one step.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\"\n        ],\n        \"range\": \"CQ\"\n      }\n    }\n  ],\n  \"Crash\": [\n    {\n      \"name\": \"Thick Skin\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"A history of breaking yourself while breaking other things has toughened you up.\"\n    },\n    {\n      \"name\": \"Zero Days\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Once per scene, ignore any damage to yourself that comes as a result of your own destructive actions.\"\n    },\n    {\n      \"name\": \"The Seam Bear Secrets\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Ancient buildings remember. Receive a whisper when you destroy an ancient structure.\"\n    },\n    {\n      \"name\": \"Load-Bearing Wall\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Use a task to identify hidden elements essential to the integrity of a structure.\"\n    },\n    {\n      \"name\": \"Cannonball Dreams\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You jump headfirst into destruction. Literally. You can use your own body as a projectile, dealing LR Blunt damage. You end up wherever you land.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Padded Boilersuit\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Spike, Hewing, Blast, Volt.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Blunt\",\n          \"Spike\",\n          \"Hewing\",\n          \"Blast\",\n          \"Volt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Broken Points\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Increase impact when you break something as a show of strength or intimidation.\"\n    },\n    {\n      \"name\": \"Crude Tools\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Your solutions may not be clever, but they work. You may use the Break skill to construct simple tools.\"\n    },\n    {\n      \"name\": \"Canis Box Detonator\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A simple detonator used to set off explosives from a (presumably) safe distance.\"\n    },\n    {\n      \"name\": \"Crash Mask\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"A mask favoured by those who work in dusty environments. You can see clearly through dust and smoke, and resist the effects of spores and bad air.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"airborne spores\",\n          \"bad air\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Baby Bombs\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Handheld explosives waiting to be thrown. Deals LR Blast damage to multiple nearby targets at once.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blast\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Demolisher\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"An over-sized weapon, usually a hammer or pickaxe. Deals CQ Blunt or Spike damage. Increase impact when destroying architecture.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\",\n          \"Spike\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Wrecker's Globe\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A large, heavy ball on the end of a chain. Deals CQ Blunt damage. Useful for knocking foes back.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Torteaver\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"A small creature with a hard shell known for gnawing through wood and stone.\"\n    },\n    {\n      \"name\": \"Burrowhip Colony\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"A small colony of burrowing insects. Mark to weaken a structure without destroying it.\"\n    },\n    {\n      \"name\": \"Blitceros\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A quadruped large enough to be ridden. Tends to bring down barriers by charging into them horn-first.\"\n    },\n    {\n      \"name\": \"The Joy of Direct Paths\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Whenever your ship rams or cuts through a particularly difficult obstacle using a ratings roll, you gain a piece of salvage or specimen with the Broken tag related to the obstacle.\"\n    },\n    {\n      \"name\": \"Torpedo Mallet\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Yes, this was once an armament for a submersible. No, there really aren't many safety precautions in place. Deals CQ Blunt or Blast damage, or burn to deal Massive CQ Blast damage to multiple nearby targets (including yourself).\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\",\n          \"Blast\"\n        ],\n        \"range\": \"CQ\"\n      }\n    }\n  ],\n  \"Dredger\": [\n    {\n      \"name\": \"Seared Skin\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Resist the hazardous effects of crezzerin exposure (searing, hallucinations, mutation).\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"crezzerin effects\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Master Salvager\",\n      \"type\": \"Trait\",\n      \"track\": 1,\n      \"description\": \"Add a positive tag of your choice to any salvage you acquire from wrecks, reefs and ruins.\"\n    },\n    {\n      \"name\": \"Mental Catalogue\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to discern the use or history of something ancient.\"\n    },\n    {\n      \"name\": \"Lurid Cartography\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can use charts to find shipwrecks and disasters as well as the usual islands and oddities.\"\n    },\n    {\n      \"name\": \"Devil May Care\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Treat conflicts as triumphs when avoiding traps and environmental hazards.\"\n    },\n    {\n      \"name\": \"Arborafathometer\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A complex depth-gauge for measuring your precise distance from the Darkness-Under-Eaves. Increase your ship's Tilt rating by one when you're aboard\"\n    },\n    {\n      \"name\": \"Scrounge\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Whenever your crew gains a piece of cargo, gain a resource (likely salvage, but perhaps a specimen or whisper) related to that cargo for yourself.\"\n    },\n    {\n      \"name\": \"Cramped Conditioning\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"Ignore cut that would be imposed for taking actions in enclosed or architecturally unstable spaces.\"\n    },\n    {\n      \"name\": \"Silkwire Coil\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A near-unbreakable coil of thick wire that is somehow soft to the touch. Can be re-coiled with a simple flick after being unwound.\"\n    },\n    {\n      \"name\": \"Amber Lenses\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Goggles that allow you to see perfectly through smoke, mists and sporeclouds.\"\n    },\n    {\n      \"name\": \"Moth Lantern\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Uses luminous moths to illuminate a small area around you.\"\n    },\n    {\n      \"name\": \"Springheel Boots\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Mark to make a prodigious leap and land safely without having to roll.\"\n    },\n    {\n      \"name\": \"Tomb Hammer\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"As much a tool as it is a weapon. Deals CQ blunt damage. Increase impact when smashing stonework and structures.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Key-Tail Scorpion\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"A curious little beast with a skeleton-key stinger. Once per scene you may open any mundane lock.\"\n    },\n    {\n      \"name\": \"Sanctipede\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"Drawn to history and forgotten things. Consume a chart to identify and retrieve a piece of ancient and valuable salvage in your vicinity if possible.\"\n    },\n    {\n      \"name\": \"Tickerclick\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"A punchcard intelligence in a noisy construct body, the whirring and clanking of this mouse-like companion is useful for drawing attention away from your position.\"\n    },\n    {\n      \"name\": \"Arc Lamp\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A bright source of directed light. Mark to overcharge the lamp, allowing it to deal LR Salt damage for the duration of a scene.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Salt\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Roving Shadow\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"Something intangible from the depths treats your shadow as a home. Burn to detach your shadow, sending it ahead to explore for you for a brief time. Your shadow has no weight or thickness, but can't stand bright light.\"\n    }\n  ],\n  \"Hacker\": [\n    {\n      \"name\": \"Scars Remember\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"The wildsea teaches harsh, but useful, lessons.\"\n    },\n    {\n      \"name\": \"Trailblazer\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Increase impact when finding routes and clearing paths through vegetation.\"\n    },\n    {\n      \"name\": \"Living Antidote\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Use a task to create a rare resource, Pure Spit or Pure Sweat.\"\n    },\n    {\n      \"name\": \"Wild Harvest\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Treat conflicts as triumphs when attacking or defending against plant-type hazards.\"\n    },\n    {\n      \"name\": \"Crezzercomo\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to become undetectable to plant-type hazards and creatures for the duration of a scene.\"\n    },\n    {\n      \"name\": \"Hard-Won Instincts\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can tell which branches will break and which will hold at a glance. Increase your ship's Saws rating by one when you're aboard.\"\n    },\n    {\n      \"name\": \"Petalcrusher\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You ignore mire caused by plant-based hazards and horrors, and are resistant to acids, toxins and hallucinatory effects caused by predatory plants\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Acid\",\n          \"Toxin\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Rusting-Leaf Ale\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Becomes more flavourful the more it gets jostled and shaken. Whenever you gain a benefit from a concoction or meal, increase its track by two boxes.\"\n    },\n    {\n      \"name\": \"Grappling Chain\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Designed to find quick purchase in bark and boughs. treat conflicts as triumphs when traversing the sea.\"\n    },\n    {\n      \"name\": \"Chemical Censer\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Mark to create a small area of smoke that repels insects and lowers visibility.\"\n    },\n    {\n      \"name\": \"Wavestrider Jacket\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Resist the hazardous effects of crezzerin exposure, insect bites and poisons.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"crezzerin effects\",\n          \"bites and stings\",\n          \"poisons\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Jagserry\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"The archetypal hacker weapon, a sawtooth sabre that deals CQ hewing or serrated damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Hewing\",\n          \"Serrated\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Sawtooth Chakram\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A set of sharpened circular blades made for throwing, dealing LR keen or serrated damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\",\n          \"Serrated\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Defoliant Grenades\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Explosive packets that burst when lobbed with force. Deals LR acid or salt damage\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Acid\",\n          \"Salt\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Gyrewing Moths\",\n      \"type\": \"Companion\",\n      \"track\": 5,\n      \"description\": \"A trained swarm of ragged insects. Burn to neutralize the effects of bad air and airborne spores for your crew for the rest of a scene.\"\n    },\n    {\n      \"name\": \"Prow-Nose Porcupine\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"Not the easiest creature to pet, but you learn to live with it. Ignore cut caused by pain or discomfort.\"\n    },\n    {\n      \"name\": \"Mockserry\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"A blade that looks like a normal jagserry, until it unfolds with an insectile shudder. Deals CQ Serrated damage, and allows the wielder to detect the smallest vibrations in the ground and air around them.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Serrated\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Gnashing Sawskull\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"For the hands-off hacker, this grisly spectral relic of some unnamed undercanopy predator has teeth strong enough to turn wood to splinters. Deals CQ Hewing damage, with increased impact while under Pressure.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Hewing\"\n        ],\n        \"range\": \"CQ\"\n      }\n    }\n  ],\n  \"Horizoneer\": [\n    {\n      \"name\": \"First Impressions\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Increase impact when communicating with an individual for the first time.\"\n    },\n    {\n      \"name\": \"Silver Tongue\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"When communicating with a friendly individual in their natural language treat conflict results as triumphs.\"\n    },\n    {\n      \"name\": \"Hyperadaptive\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to learn a smattering of any language you hear and have no ranks in. This knowledge remains until you choose to mark and replace it with a new language.\"\n    },\n    {\n      \"name\": \"Wealth of Knowledge\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Consume a whisper to learn a secret of the sea.\"\n    },\n    {\n      \"name\": \"Nothing Stays Buried\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to identify a hidden or forgotten space in your vicinity by gut feeling alone.\"\n    },\n    {\n      \"name\": \"Bait Bandoleer\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Intoxicating to certain species. Treat conflicts as triumphs when trying to distract, divert or drive off a wildsea creature.\"\n    },\n    {\n      \"name\": \"Open Hands, Open Hearts\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Whenever you or your crew successfully defuse a situation that was heading toward a fight, clear a mark of mire.\"\n    },\n    {\n      \"name\": \"Exports Tell Stories\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Whenever your crew gains a piece of cargo, gain a whisper related to that cargo for yourself.\"\n    },\n    {\n      \"name\": \"Watch and Learn\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Use a task to tag along with one of your crewmates, gaining a temporary rank in any skill they display. This rank lasts until you next use watch and learn.\"\n    },\n    {\n      \"name\": \"Spike Wine\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"An ektus delicacy that sharpens the palette. Whenever you or a crewmate gains a benefit from a meal or beverage, increase the track for tha benefit by one box.\"\n    },\n    {\n      \"name\": \"Tuning Fork\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Once per scene increase impact when engaged in a performance of some kind.\"\n    },\n    {\n      \"name\": \"Padded Gauntlet\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Used to help train the wild creatures of the sea. You're resistant to bite attacks, no matter the damage type.\"\n    },\n    {\n      \"name\": \"Sheaf of a Hundred Stories\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Gain a whisper whenever you encounter a spectacle, horror or new port during a journey\"\n    },\n    {\n      \"name\": \"Bundled Correspondence\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"When you enter a new port, mark to find a friendly contact you've exchanged letters with in the past\"\n    },\n    {\n      \"name\": \"Sturdy Instrument\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Anything from a guitar to maracas, a hip drum to an accordion, a sitar to an ocarina. Can be played, but also acts as a CQ blunt weapon in a pinch\"\n    },\n    {\n      \"name\": \"Worth Telling Twice\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"When a crewmate or opponent uses a whisper, take a single word from it and start a 3-box Project track, marking the first box. If you already have an existing project track from this trait, add the chosen word and mark another box. When all three boxes are marked, gain the three collected words as a new whisper.\"\n    },\n    {\n      \"name\": \"Wavecutter's Ravito\",\n      \"type\": \"Gear\",\n      \"track\": 1,\n      \"description\": \"A beautiful long-necked instrument, the tones of which bring to mind calming memories of the rustling waves. Burn to reduce the Pressure level by one, or to clear a mark or burn from a watchful eye.\"\n    }\n  ],\n  \"Hunter\": [\n    {\n      \"name\": \"Ghost of the Wilds\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Choose either wild or urban areas. You leave barely any trace, and are almost impossible to track, when moving through your chosen area.\"\n    },\n    {\n      \"name\": \"From Nowhere\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Increase impact when attacking from a hidden position, or attacking an unaware target.\"\n    },\n    {\n      \"name\": \"Whisper on the Wind\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Consume a whisper to gain cryptic information on a target's whereabouts and actions.\"\n    },\n    {\n      \"name\": \"Bloodhound\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Your sense of smell is highly developed, allowing you to hunt and track by scent alone.\"\n    },\n    {\n      \"name\": \"Running Quiet\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Your guidance allows your vessel to keep a lower profile, disturbing fewer creatures and leaving less of a tell-tale trail. Increase your ship's Stealth rating by one when you're aboard.\"\n    },\n    {\n      \"name\": \"Rare Musk\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Collected from sleeping leviathans, apparently. Burn to drive a beast or insect of the waves into an intense instictual behaviour (such as fear, hunger or frenzy).\"\n    },\n    {\n      \"name\": \"Slacker's Line\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"A fishing rod designed to be left unattended. Once per journey gain a live specimen appropriate to the area you're travelling through.\"\n    },\n    {\n      \"name\": \"Butchery Kit\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You can butcher dangerous specimens without risk or cutting for difficulty, and increase impact when gathering resources from a creature you've hunted.\"\n    },\n    {\n      \"name\": \"Snare Set\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Count conflicts as triumphs when readying traps, snares or ambushes.\"\n    },\n    {\n      \"name\": \"Venomous Trophy\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Use a task to create a resource, Paralyzing Venom.\"\n    },\n    {\n      \"name\": \"Masterwork Leathers\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"When you take this trait choose either beasts, plants or insects. You're resistant to all damage from your chosen source.\"\n    },\n    {\n      \"name\": \"Boat-Knife\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Deal keen damage to any creature that attacks you with their own body in close quarters (such as with tail or bite attacks).\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Jawspear\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A long-bladed spear with cruelly curving teeth. Deals CQ serrated damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Serrated\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Manifold Bow\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"finely-crafted bow paired with an expansive quiver. Can deal LR damage of three types chosen from the following list: Spike, Toxin, Blast, Volt, Salt\"\n    },\n    {\n      \"name\": \"Target Dragonfly\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"Every moment of its life is a hunt. Mark to identify a weak point or weakness of a creature you can see.\"\n    },\n    {\n      \"name\": \"Bloodscrawl Markings\",\n      \"type\": \"Trait\",\n      \"track\": 1,\n      \"description\": \"These patterns are a hard-won warning to lesser game that it should steer clear. Any ship you crew is immune to insect incursions and wandering spirits while delving.\"\n    },\n    {\n      \"name\": \"Necklace of Claws\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Treat disasters as conflicts when attacking or defending against a creature that you have bested before.\"\n    }\n  ],\n  \"Navigator\": [\n    {\n      \"name\": \"In the Firefly's Glow\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You know the secret paths of the fireflies. Mark to discover a location without using a chart (once per scene).\"\n    },\n    {\n      \"name\": \"Years at Sea\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to request an omen of the future (supplied by the Firefly).\"\n    },\n    {\n      \"name\": \"Wildlung\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Resist the effects of bad air and airborne spores.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"bad air\",\n          \"airborne spores\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Revelatory\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"When you discover a new route or location, uncover a secret about that area as well.\"\n    },\n    {\n      \"name\": \"Hullsight\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"While aboard your ship you can see as though you had eyes at any point across the outer hull.\"\n    },\n    {\n      \"name\": \"At the Right Moment\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Whenever your crew take a montage during a journey, choose one crewmember to perform an extra task of their choice (you can't choose yourself).\"\n    },\n    {\n      \"name\": \"Journeys Unfinished\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to learn the never-reached destination or port of origin for any wreck you come across. Burn to learn it for a ship still travelling.\"\n    },\n    {\n      \"name\": \"Skoinesis\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"You have uncanny control over nearby ropes and rigging, which twist and move according to your will.\"\n    },\n    {\n      \"name\": \"Gale Flute\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A simple musical instrument at first glance, playing the gale flute has the curious property of bringing favourable winds your way.\"\n    },\n    {\n      \"name\": \"Cartographika\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A map-maker's ordinator. Use a task to create a rare resource, Chart of the Rustling Waves.\"\n    },\n    {\n      \"name\": \"Bundled Charts\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"When you uncover a new route or location you can mark this aspect. If you do so the Firefly will inform you of a second route or location at the same time.\"\n    },\n    {\n      \"name\": \"Ornate Spyglass\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A spyglass that allows you to see much further and in greater clarity than the average wildsailor. When you have a commanding view, mark to learn a secret of the surrounding waves.\"\n    },\n    {\n      \"name\": \"Flare Pistol\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"A small sidearm loaded with chemical flares. Deals LR acid damage. Can also be used to shed light over extremely large areas at will.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Acid\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Scout Falcon\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"Once per journey allows a crewmember to roll 2d6 when on watch, then pick the preferred result. Also deals LR keen damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Keen\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Weatherbug\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"Mark to accurately predict the weather for the next few days.\"\n    },\n    {\n      \"name\": \"Fractured Discipline\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Whenever a watchful eye is marked or burned, or the Pressure Level increases, gain a whisper related to one of your existing charts.\"\n    },\n    {\n      \"name\": \"Jyorachling Pair\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"Two feathered spiders that seem to despise each other. Use a task to gain two charts, one related to the skies above your position  and one related to the depths below.\"\n    }\n  ],\n  \"Rattlehand\": [\n    {\n      \"name\": \"Mastercraft\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Choose wood, metal or bone. Increase impact when crafting or repairing with your chosen material.\"\n    },\n    {\n      \"name\": \"Made to Last\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"When you craft, the resulting creation's track is three boxes longer than usual.\"\n    },\n    {\n      \"name\": \"Multitasker\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can use a task to work on repairing up to three pieces of gear or mechanical companions at a time.\"\n    },\n    {\n      \"name\": \"Surefire Smith\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Count conflicts as triumphs when repairing gear and mechanical companions.\"\n    },\n    {\n      \"name\": \"Deckside Engineer\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Tiny, incremental adjustments that you make without thinking keep your vessel's hull and superstructure in remarkable shape. Increase your ship's Armour rating by one when you're aboard.\"\n    },\n    {\n      \"name\": \"Breakdown Specialist\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"When a crafted benefit's track is fully marked, gain a piece of salvage related to it before removing the benefit\"\n    },\n    {\n      \"name\": \"Inkstamp Mechanism\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Consume a chart to quickly create a set of schematics for a machine or mechanism you can see (represented by new chart). All actions to create such a machine yourself gain increased impact while you have this new chart.\"\n    },\n    {\n      \"name\": \"Toolbelt\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Once per scene, swiftly craft a one-track creation without needing to roll.\"\n    },\n    {\n      \"name\": \"Salvage Kit\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Contains salvage useful for crafting. Mark to use the contents in place of a resource when crafting\"\n    },\n    {\n      \"name\": \"Multi-Lens Goggles\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You gain ferrosight, the ability to see electric and magnetic fields.\"\n    },\n    {\n      \"name\": \"Wolf-Skin Gloves\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"You never cut for difficulty when including specimens in your crafting, no matter how grisly or unpalatable the process is.\"\n    },\n    {\n      \"name\": \"Volt-Rail\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"An insulated grip around a crackling, rudimentary cattleprod. Deals CQ volt damage, and you're immune to volt damage yourself.\",\n      \"damageTypes\": {\n        \"category\": \"immunity\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Volt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Hazard Suit\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Spike, Acid, Blast, Volt, Flame.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Spike\",\n          \"Acid\",\n          \"Blast\",\n          \"Volt\",\n          \"Flame\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Artillery Spider\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A self-made automaton designed to offer fire support. Deals LR blast damage\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blast\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Autocrawler\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"A nimble little scavenging construct. Once per scene, add a positive tag of your choice onto any piece of salvage you acquire.\"\n    },\n    {\n      \"name\": \"Steam-Scarab\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"A self-made automaton, large enough to ride.\"\n    },\n    {\n      \"name\": \"Emergency Repairs\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"When your ship's lift system, baffler, pressure shell, or scrubber would take structural damage, consume two pieces of salvage to prevent it.\"\n    },\n    {\n      \"name\": \"Rewiring Reality\",\n      \"type\": \"Trait\",\n      \"track\": 1,\n      \"description\": \"Consume a whisper to fundamentally change the function of a single mechanism you can see to directly benefit you (with the aid of the Firefly for specifics).\"\n    }\n  ],\n  \"Screw\": [\n    {\n      \"name\": \"Ferrokinesis\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to control or reshape exposed metal.\"\n    },\n    {\n      \"name\": \"Heart of Ore\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Choose a single type of metal (such as iron or copper). Increase impact when repairing, crafting or using arconautics with your metal of choice.\"\n    },\n    {\n      \"name\": \"Ironsight\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can sense nearby metals, see magnetic fields and always know the direction of true north.\"\n    },\n    {\n      \"name\": \"Smart Repulsion\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Treat conflicts as triumphs when dodging or blocking attacks from constructs or metal weapons.\"\n    },\n    {\n      \"name\": \"Magnetic Levitation\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can manipulate your own magnetic field, allowing you to fly for short periods when close to dense masses of metal (such as a ship's hull or kinetic anchor).\"\n    },\n    {\n      \"name\": \"Reactive Riveter\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Deal spike damage to any creature that attacks you with their own body in close quarters (such as with tail or bite attacks).\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Field Charge\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Once per scene give any piece of salvage you acquire the Magnetic tag.\"\n    },\n    {\n      \"name\": \"Pre-V Ingot\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Worn as a simple decoration, but holds incredible magnetic potential. Burn to briefly move a massive amount of metal, up to the size of a ship\"\n    },\n    {\n      \"name\": \"Deconstructor\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Ignore cut when attempting to damage, break or deconstruct a machine or mechanism made of metal.\"\n    },\n    {\n      \"name\": \"Iron-Ring Jacket\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blunt, Spike, Serrated, Toxin, Volt.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Blunt\",\n          \"Spike\",\n          \"Serrated\",\n          \"Toxin\",\n          \"Volt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Chaff Pouch\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Mark to produce a cloud of metal fragments, obscuring vision around you.\"\n    },\n    {\n      \"name\": \"Kinetic Anchor\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A large mass of metal shaped to make it easy to carry, often used to enable ferrokinesis in places otherwise empty of metal. Deals CQ blunt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Rivet Swarm\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"A cloud of floating debris you can direct with a flick of the wrist. Deals LR spike or keen damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\",\n          \"Keen\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Distant Repulsion\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Your arconautic abilities seep into any vessel you call home. Any ship you crew gains the Hover style, in addition to any existing styles offered by its lift systems.\"\n    },\n    {\n      \"name\": \"Crisis Bolts\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Deal Blast damage to any creature that attacks you with their own body in close quarters (such as with tail or bite attacks).\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blast\"\n        ]\n      }\n    }\n  ],\n  \"Slinger\": [\n    {\n      \"name\": \"Gunslinger's Poise\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"You're hard to shake, no matter what comes your way.\"\n    },\n    {\n      \"name\": \"Trigger Discipline\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"When attacking at long range, mark to count a conflict result as a triumph.\"\n    },\n    {\n      \"name\": \"Deadeye\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can target attacks precisely (such as when aiming for a weak point) without cutting for difficulty.\"\n    },\n    {\n      \"name\": \"From On High\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Increase impact when attacking from an elevated position.\"\n    },\n    {\n      \"name\": \"Thunder\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to increase impact when attacking at long range.\"\n    },\n    {\n      \"name\": \"Trick Shot\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"Burn to attack a target you can't see or don't have line of sight to.\"\n    },\n    {\n      \"name\": \"Amateur Gunsmith\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Extend the track of any temporary LR weapon you craft for yourself by two boxes.\"\n    },\n    {\n      \"name\": \"Toe to Toe\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You can use LR weapons in close quarters combat and tight engagements without cutting for difficulty.\"\n    },\n    {\n      \"name\": \"Essence Grinder\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Consume a specimen to add a thematically appropriate damage type to one of your existing LR weapons. This added damage type persists until you use essence grinder again.\"\n    },\n    {\n      \"name\": \"Precision Denial\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Once per scene you may instantly hijack focus when targeted by a ranged attack.\"\n    },\n    {\n      \"name\": \"Barrage\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You can deal damage to multiple distant opponents with a successful LR attack.\"\n    },\n    {\n      \"name\": \"Smoke Bombs\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Mark to produce a cloud of smoke, obscuring vision in your area for others, but not for you.\"\n    },\n    {\n      \"name\": \"Hammerpin Revolver\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A heavy revolver with a rotating cylinder. Deals LR blunt or blast damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\",\n          \"Blast\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Bolt-Action Rifle\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"A long-barrelled rifle with an amber-lensed scope. Deals LR blast damage. Increase impact when attacking from a hidden position.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blast\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Copper Sawn-Off\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A sawn-off shotgun that can be loaded with shrapnel or salt rounds. Deals LR blast or salt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blast\",\n          \"Salt\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Experimental Accelerator\",\n      \"type\": \"Gear\",\n      \"track\": 1,\n      \"description\": \"Deals LR Spike damage. With each shot, decide if you want to increase your impact without cutting or affect multiple nearby targets at once.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Yardtongue Anteater\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"Trained over long years to whip missed shots out of the air before they disappear into the waves. Treat disasters as conflicts when using LR attackes against a nearby target.\"\n    }\n  ],\n  \"Steep\": [\n    {\n      \"name\": \"Anima Presence\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Spirits can always see and hear you, just as you can see and hear them\"\n    },\n    {\n      \"name\": \"Rite of Bloom\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Old flavours burst in novel ways. Consume a whisper when an ally imbibes one of your concoctions, and benefit from an aspect of theirs until the concoction has worn off.\"\n    },\n    {\n      \"name\": \"Potion of Youth\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"Your body doesn't look it but you are far older than you seem. You have learned many tricks to keep it so.\"\n    },\n    {\n      \"name\": \"Steeping Reality\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Tangible things steep and disperse their essence through the Physical Realm. Mark to know the past of an object.\"\n    },\n    {\n      \"name\": \"Not a Drop Wasted\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"A steep never spills. Once per journey, a crewmate may suffer your disaster to add a box and a word to a benefit you brewed. If there was no twist you may both alter a word in a whisper.\"\n    },\n    {\n      \"name\": \"Reading the Remains\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Whether leaves, grounds, draff or bones, all concoctions leave remnants. Consume a specimen to ask a question and read an omen in your remnants.\"\n    },\n    {\n      \"name\": \"Conduit to Flavour\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"You may elect to suffer the negative effects of a concoction instead of the one imbibing it.\"\n    },\n    {\n      \"name\": \"Coterie Drugget\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A place setting made of woven complexities. Allies may mark an aspect to benefit from one of your concoctions (with reduced impact).\"\n    },\n    {\n      \"name\": \"Ossein Kettles\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"This heirloom, eternities old, is used to create beverages that warm more than your body. Triumphs on rolls to concoct grant a Whisper.\"\n    },\n    {\n      \"name\": \"Salamini\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"Like a Salamax, just smaller. Their boiling spit is just the perfect temperature for a mull. Their scalding saliva deals CQ flame damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Flame\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Steam-Familiar\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"Warmth, wonder, and moisture are familiar to a Steep, and sometimes the spirits they call linger on to comfort others. Mark to neutralize the effects of bad air, spores, or cold.\"\n    },\n    {\n      \"name\": \"Zephyrous Stir-Spoon\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"The cooling breezes carried by this lengthy stir spoon always reach the bottom of the pot. It'll carry you, haltingly, too. Mark to poorly fly upon it for the duration of the scene.\"\n    },\n    {\n      \"name\": \"The Winning Wishbone\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Given the proper time and equipment, a steep can brew a hearty stock using this arm-length wishbone chunk. Triumphs on rolls made to brew heal one mark of damage for all crewmates who share in the result.\"\n    },\n    {\n      \"name\": \"Crezzagrean Kantharos\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"A vessel ancient even in the pre-Verdancy, used to infuse more than just flavour into a mull. While brewing with this vessel, cut 1 to add 1 rank of a skill or language you know as an additional boon to the benefit provided.\"\n    },\n    {\n      \"name\": \"Overwhelming Aromas\",\n      \"type\": \"Gear\",\n      \"track\": 1,\n      \"description\": \"The fragrance of your brews and concoctions wafts through passageways and corridors like a pleasant dream. Any ship you crew is immune to bad air and drifting spores while delving.\",\n      \"damageTypes\": {\n        \"category\": \"immunity\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"bad air\",\n          \"airborne spores\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Silver Split-Prong\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"An ordinary-looking fork, by all accounts. Deals CQ Spike damage. You can use a task to swap a tag from any one of your resources to any other resource you own (whether it's logical or not).\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Spike\"\n        ],\n        \"range\": \"CQ\"\n      }\n    }\n  ],\n  \"Surgeon\": [\n    {\n      \"name\": \"First Aid\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"When a nearby ally takes damage, hijack focus to immediately heal one point of that damage (once per scene).\"\n    },\n    {\n      \"name\": \"Evolving Techniques\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Increase impact when healing others in a safe environment.\"\n    },\n    {\n      \"name\": \"The Limits of the Crew\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to allow a crew-mate to benefit from a fullymarked trait or companion for the duration of a scene.\"\n    },\n    {\n      \"name\": \"Biological Maestro\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Choose a bloodline. When healing a member of that bloodline, treat conflict results as triumphs.\"\n    },\n    {\n      \"name\": \"In the Absence of Journals\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You receive a whisper whenever a crewmate fully heals from an injury.\"\n    },\n    {\n      \"name\": \"Wilds Theoreteician\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Sacrifice a whisper to discern the properties of a mysterious illness or injury.\"\n    },\n    {\n      \"name\": \"Vigilance\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"You scrub, clean and de-spore surfaces with regularity. Whenever you or one of your crew takes an injury, reduce the injury track by one box.\"\n    },\n    {\n      \"name\": \"Ceaseless Tending\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can use a task to work on healing up to three traits, injuries or companions at a time.\"\n    },\n    {\n      \"name\": \"Leviathan-Blood Infusion\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Hard to get hold of, but terrifyingly potent. Burn to give you or a crewmate resistance to all damage for the duration of a scene or increased impact on all attacks for the duration of a scene.\"\n    },\n    {\n      \"name\": \"Herbal Sealing-Wax\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"An odd-smelling unguent for spreading on a vessel's doorways, dispensed liberally as a matter of course. Increase your ship's Seals rating by one when you're aboard.\"\n    },\n    {\n      \"name\": \"Spice-Nosed Mask\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"You're immune to disease, and resist the effects of bad air and airborne spores.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"bad air\",\n          \"airborne spores\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Doctor's Trusty Satchel\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Mark to acquire one of three resources, Hungry Leeches, Soporific Draught or Medicinal Herbs.\"\n    },\n    {\n      \"name\": \"Surgical Spectacles\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Mark to identify one of a target's weak points or weaknesses.\"\n    },\n    {\n      \"name\": \"Bonesaw\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Works just as well on foes as it does patients. Deals CQ serrated damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Serrated\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Whisperspit Leech\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"Mark mire to drain the falsehood out of a statement, hearing the truth behind it. You gain a whisper based on the excised lies.\"\n    },\n    {\n      \"name\": \"We Can't Keep Doing This\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Ignore any cut that would be added for difficulty or precision when attempting to tend to, treat, or heal a member of your own crew.\"\n    },\n    {\n      \"name\": \"Jar of Old Fears\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Deals LR Salt damage. In addition, you may use a task to heal a mark of mire from any member of the crew, and gain a whisper based on that mire's nature.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Salt\"\n        ],\n        \"range\": \"LR\"\n      }\n    }\n  ],\n  \"Tempest\": [\n    {\n      \"name\": \"Storm-Stride\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Mark to float for a brief time, electricity crackling around you as you do so.\"\n    },\n    {\n      \"name\": \"The Pulse\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can sense nearby electrical fields, such as those produced by living organisms\"\n    },\n    {\n      \"name\": \"Bolt-Switch\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to instantly switch places with a willing crewmate within sight, or burn to switch with them and hijack focus at the same time.\"\n    },\n    {\n      \"name\": \"Old Accord\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Use a task and mark to quiet or banish a storm, or use a task and burn to summon one.\"\n    },\n    {\n      \"name\": \"The Skies Agree\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Increase impact when dealing volt or blast damage during an electrical storm or heavy rainfall.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Volt\",\n          \"Blast\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Thunder's Tone\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can raise your voice to an ear-splitting shout, dealing CQ blast damage and being easily heard over long distances.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blast\"\n        ],\n        \"range\": \"CQ\"\n      }\n    },\n    {\n      \"name\": \"Lightning's Call\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You can direct bursts of voltaic energy through your palms or fingers, dealing LR volt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Volt\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Ground Zero Overload\",\n      \"type\": \"Trait\",\n      \"track\": 1,\n      \"description\": \"Mark to deal volt damage to all nearby foes, or burn to increase it to massive volt damage.\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Volt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Ironjaw Seven-String\",\n      \"type\": \"Gear\",\n      \"track\": 5,\n      \"description\": \"A guitar-like instrument carved from the bones of an ironjaw ray. Produces a harsh, buzzing tone when played that seems to awaken the spirit of rebellion in some.\"\n    },\n    {\n      \"name\": \"Mesh Relay\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Deal volt damage to any creature that attacks you with their own body in close quarters (such as with tail or bite attacks).\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Volt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Voltomotive Interfacing\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"You can act as an additional (or main) engine for your ship, powering its bite with your mere presence. Increase your ship's Speed rating by one when you're aboard.\"\n    },\n    {\n      \"name\": \"Voltaic Lantern\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A simple light source that runs off of your own internal charge. Mark to deplete a nearby source of electricity, absorbing it into the lantern for a brighter glow.\"\n    },\n    {\n      \"name\": \"Singed Coat\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Frost, Flame, Salt, Blast, Volt.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Frost\",\n          \"Flame\",\n          \"Salt\",\n          \"Blast\",\n          \"Volt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Internal battery\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Mark to kickstart a machine, charge a depleted power source or temporarily increase the effectiveness of an engine.\"\n    },\n    {\n      \"name\": \"Squallkitten\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"A small, playful feline made of roiling stormclouds. Gives your entire crew resistance to volt damage\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Volt\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Sparking-Eel\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"Winds around limbs and under clothes, always moving. Mark to identify the nearest source of potent electricity, no matter the distance.\"\n    },\n    {\n      \"name\": \"The Gathering Storm\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"You gain the Float, Rush, Hover, and Soar styles, and treat disasters as conflicts when attacking with Volt damage, during stormy weather. Storms don't count as a negative atmospheric condition for you during flight.\"\n    },\n    {\n      \"name\": \"Petrichord\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A stringed instrument, somewhere between a sitar and a lyre, that sounds like fresh rain. The bearer's ship is immune to damage and negative effects from storms, including living storms, for as long as the petrichord is being played.\"\n    }\n  ],\n  \"Wordbearer\": [\n    {\n      \"name\": \"Respect Runs Deep\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Your clothes, your posture, your look - wordbearers are afforded a rare respect. Treat conflicts as triumphs when commanding authority in a settlement with a junction.\"\n    },\n    {\n      \"name\": \"The Words Always Know\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Once per scene you can gain a fragment of accurate information on the whereabouts of any individual you're trying to deliver to.\"\n    },\n    {\n      \"name\": \"The Safest Wrapping\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Use a task to convert a spoken or physical message of some kind into a whisper (if the message was a resource, you keep it in addition to gaining the whisper).\"\n    },\n    {\n      \"name\": \"Rightful Owner\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Increase impact when defending your deliveries, and when attempting to retrieve something stolen from yourself or your crew.\"\n    },\n    {\n      \"name\": \"Oathbound\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"You're immune to chemical, arconautic, and mesmeric effects designed to draw information from you.\",\n      \"damageTypes\": [\n        {\n          \"category\": \"immunity\",\n          \"selectionType\": \"fixed\",\n          \"options\": [\n            \"Chemical\",\n            \"Arconautic\",\n            \"Mesmeric\"\n          ]\n        }\n      ]\n    },\n    {\n      \"name\": \"Weatherbeaten\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You're resistant to three damage types, chosen from the following list: Blast, Acid, Toxin, Frost, Flame.\",\n      \"damageTypes\": {\n        \"category\": \"resistance\",\n        \"selectionType\": \"choose\",\n        \"chooseCount\": 3,\n        \"options\": [\n          \"Blast\",\n          \"Acid\",\n          \"Toxin\",\n          \"Frost\",\n          \"Flame\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Promise-Twine\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"When a resource you're trying to deliver would be destroyed or lost it degrades instead, gaining a negative tag (if it already has a negative tag, it is consumed as normal).\"\n    },\n    {\n      \"name\": \"Courier's Cage\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Consume a specimen to call a nearby messenger creature to you safely, and retrieve both the creature and whatever message they're holding as resources\"\n    },\n    {\n      \"name\": \"Glyph Flares\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A set of chemical fireworks that burst in bright, recognisable glyph shapes.\"\n    },\n    {\n      \"name\": \"Pattern-Reader\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"A miniature gramophone for playing scribed cylinders of wax, ceramics, or cured bark. Mark to record a fragment of conversation or sound you can hear, to be played back at a later time.\"\n    },\n    {\n      \"name\": \"Undeliverables\",\n      \"type\": \"Gear\",\n      \"track\": 5,\n      \"description\": \"Sometimes the oath is broken by the death of a receiver. You carry those undelivered letters and parcels around as a memorial, or possibly a penance.\"\n    },\n    {\n      \"name\": \"Canvas Sling\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"A simple but effective weapon. Deals LR Blunt damage, and increases impact on CQ actions made to trip or restrain a target\",\n      \"damageTypes\": {\n        \"category\": \"dealing\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"Blunt\"\n        ],\n        \"range\": \"LR\"\n      }\n    },\n    {\n      \"name\": \"Sortomaton\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"A wheezing machine used for the sorting and categorizing of mail. You count as fluent in all languages, but only when reading addresses, listening to directions, or commiting a sender's message to memory.\"\n    },\n    {\n      \"name\": \"Retired Courier Dragonfly\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"Still swift, but lacking stamina. Mark to gain a resource from your surroundings with some kind of text as a component, such as a chart or painted sign.\"\n    },\n    {\n      \"name\": \"Dead Letters\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Consume a resource to 'deliver it' to the Under-Eaves by throwing it over the side of a ship. Gain a whisper based on the delivery, with the Echoing tag\"\n    },\n    {\n      \"name\": \"Crawling Jar\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"Mark to add a resource to the crawling jar. This resource is impossible to find for any individual other than you, as to them the jar will appear empty. The crawling jar can hold any number of resources. Burn to pull a random resource from the jar that you never put in there (determined by the Firefly).\"\n    }\n  ],\n  \"Mesmer\": [\n    {\n      \"name\": \"Autohypnosis\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"You've learned to meditate rather than sleep, allowing you to stay far more aware while resting than most.\"\n    },\n    {\n      \"name\": \"Meditative Healing\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Using a task to meditate in a peaceful environment allows you to heal each of your damaged traits or each of your injury tracks by one.\"\n    },\n    {\n      \"name\": \"An Uncomfortable Understanding\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Burn to clear one of a crewmate's mire tracks entirely.\"\n    },\n    {\n      \"name\": \"Empty the Mind\",\n      \"type\": \"Trait\",\n      \"track\": 4,\n      \"description\": \"Ignore cut from pain, hallucination and distractions while trying to act.\"\n    },\n    {\n      \"name\": \"Knowing The Unknown\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Mark to identify a target's secret fear, or burn to accurately evaluate the truth of a statement.\"\n    },\n    {\n      \"name\": \"Parasite Thought\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"A living thought that's taken root in your mind, invisible but able to interact with the world. Allows you to hold and manipulate more objects than usual.\"\n    },\n    {\n      \"name\": \"Intricate Tattoos\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"You're immune to confusion and hallucinations that you don't invite or create yourself.\",\n      \"damageTypes\": {\n        \"category\": \"immunity\",\n        \"selectionType\": \"fixed\",\n        \"options\": [\n          \"hallucinations\"\n        ]\n      }\n    },\n    {\n      \"name\": \"Staredown\",\n      \"type\": \"Trait\",\n      \"track\": 5,\n      \"description\": \"Locking eyes with an opponent allows you to assail their mind with unwanted sensation, manifesting as LR Salt damage. Only works on creatures with sight.\"\n    },\n    {\n      \"name\": \"Chameleon Veil\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Use a task to hold still and blend in with your surroundings, becoming almost impossible to notice until you move again.\"\n    },\n    {\n      \"name\": \"Shard of Dream-Soaked Amber\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Consume a specimen to experience a thought or memory from a nearby individual.\"\n    },\n    {\n      \"name\": \"Seven-Eye Scrawl\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Eyes are daubed across your body, each of them able to perceive the world in a different way. Mark to gain a specialized form of sight for a brief time (such as the ability to see ghosts, heat, or magnetism).\"\n    },\n    {\n      \"name\": \"Smoked-Glass Hookah\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Releases a steady stream of wispy smoke. Mark to control smoke or vapours.\"\n    },\n    {\n      \"name\": \"Chromiguana\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"Slow-moving and sleepy, usually found curled up around your shoulders or at the bottom of a bag. A surprisingly relaxing presence - treat conflicts as triumphs when trying to calm yourself or others.\"\n    },\n    {\n      \"name\": \"Pinned Butterfly\",\n      \"type\": \"Companion\",\n      \"track\": 3,\n      \"description\": \"Mark to wake the butterfly for a brief time. While awake, the hypnotic patterns of the butterfly's wings induce drowsiness in those that catch sight of them.\"\n    },\n    {\n      \"name\": \"Amberglass Spectacles\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"Treat conflicts as triumphs when investigating mysteries or discerning truths while at least one watchful eye is marked or burned. If both watchful eyes are marked or burned, increase impact on therse actions as well.\"\n    },\n    {\n      \"name\": \"Guilewasps\",\n      \"type\": \"Companion\",\n      \"track\": 4,\n      \"description\": \"Spectral, flickering, barely there at all. When one of your crewmates uses a whisper, mark to gain a twisted copy of that whisper as a resource (supplied by the Firefly).\"\n    }\n  ],\n  \"Agronaut\": [\n    {\n      \"name\": \"Dawn to Dusk to Dawn\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Immediately mark the first box on the Grow track of anything you plant under sunlight or moonlight (choose one when you take this trait).\"\n    },\n    {\n      \"name\": \"Constant Gardener\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"When a plot would be damaged or destroyed (or otherwise negatively affected by the environment), burn to avoid this effect.\"\n    },\n    {\n      \"name\": \"Perfectly Ripe\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"Crewmates treat disasters as conflicts when using specimens you've grown as part of a creation.\"\n    },\n    {\n      \"name\": \"Soothing Harvester\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Plants grown aboard your ship (or body) are immune to blight and sickness. Mark to improve the rarity of any plant-based specimen you acquire from plots.\"\n    },\n    {\n      \"name\": \"Delicate Step\",\n      \"type\": \"Trait\",\n      \"track\": 2,\n      \"description\": \"You disturb no leaves and leave no footprints. You gain resistance to the hazardous effects of crezzerin, and increase impact on actions taken to move through densely forested areas.\"\n    },\n    {\n      \"name\": \"Green Mile\",\n      \"type\": \"Trait\",\n      \"track\": 3,\n      \"description\": \"Once per journey, replace the results of a watch roll with the Peace outcome. If you finish a journey without using this option, remove a negative tag from any one plant growing on your ship.\"\n    },\n    {\n      \"name\": \"Paradox Slug-Box\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"These slugs exude crezzer-neutralizing slime and resist all forms of alchemical experimentation. All plots you own are resistant to crezzerin-based damage or effects. Use a task to create a resource, Paradox Slime.\"\n    },\n    {\n      \"name\": \"Sumptuous Seed-Bag\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"For a combination of hard graft and showing off. Use a task to create a seed-based specimen based on any plant currently growing within a plot (on your ship or person).\"\n    },\n    {\n      \"name\": \"Misting Coppercan\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"You are almost impossible to detect for predatory plants of all kinds. In addition, whenever you would gain a plant specimen with a negative tag, you may mark mire to remove that tag entirely.\"\n    },\n    {\n      \"name\": \"Vespin Almanac\",\n      \"type\": \"Gear\",\n      \"track\": 4,\n      \"description\": \"Filled with scrawlings on wildfruit theories and hazardous farming techniques. Consume a whisper to add a positive tag to a growing plant, or voluntarily clear three boxes on a Grow track to gain a related whisper.\"\n    },\n    {\n      \"name\": \"Portable Plot\",\n      \"type\": \"Gear\",\n      \"track\": 3,\n      \"description\": \"You just have too many ideas for one deck to handle. You gain an extra plot, always attached to you, with 4/4 spaces for growing plants. You must add a growing medium to this plot for it to be effective.\"\n    },\n    {\n      \"name\": \"Brute-Shovel\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Deals CQ Hewing damage, and allows you to treat conflicts as triumphs when gathering plant-based specimens.\"\n    },\n    {\n      \"name\": \"Ireful Pitchfork\",\n      \"type\": \"Gear\",\n      \"track\": 2,\n      \"description\": \"Deals CQ Spike damage, and increases impact on actions taken to defend against or fend off hazards that would threaten the integrity of ship-borne plants.\"\n    },\n    {\n      \"name\": \"Sabre-Nosed Bat\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"A voracious leather-winged protector, eager to defend your growing-plots. Deals LR Keen damage, and all plots you own are resistant to insect-based damage or effects.\"\n    },\n    {\n      \"name\": \"Amblecotta Pot\",\n      \"type\": \"Companion\",\n      \"track\": 2,\n      \"description\": \"A tottering, stylized pot filled with simple soil. You gain an extra plot, always nearby to you, with 4/4 spaces for growing plants. This companion counts as a full solution, both plot and medium combined.\"\n    }\n  ]\n}"
          },
