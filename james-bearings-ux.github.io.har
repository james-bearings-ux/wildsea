          "content": {
            "size": 6403,
            "mimeType": "application/vnd.pgrst.object+json",
            "text": "{\"id\":\"36abd2ab-ac2d-4389-abb2-033b88eea872\",\"session_id\":\"ba8b7220-b27f-4c8c-b89e-9dc5eac93970\",\"name\":\"Beowolf\",\"mode\":\"play\",\"bloodline\":\"Tzelicrae\",\"origin\":\"Anchored\",\"post\":\"Dredger\",\"selected_aspects\":[{\"id\": \"Dredger-Devil May Care\", \"name\": \"Devil May Care\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Dredger\", \"category\": \"Post\", \"trackSize\": 3, \"description\": \"Treat conflicts as triumphs when avoiding traps and environmental hazards.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Anchored-Death Mask\", \"name\": \"Matching Death Mask Set\", \"type\": \"Gear\", \"track\": 3, \"source\": \"Anchored\", \"category\": \"Origin\", \"trackSize\": 1, \"customized\": true, \"damageTypes\": {\"range\": \"CQ\", \"options\": [\"Volt\", \"Salt\"], \"category\": \"dealing\", \"chooseCount\": null, \"selectionType\": \"fixed\"}, \"description\": \"Some anchored prefer to hide their face, letting the memories of their time among the living fade. Treat conflicts as triumphs when attempting to unnerve or unsettle. Now with a matching sawnana blade tongue attachment weapon. Deals CQ Volt or Salt damage.\", \"damageStates\": [\"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Tzelicrae-Shirk the Skin\", \"name\": \"Shirk the Skin\", \"type\": \"Trait\", \"track\": 5, \"source\": \"Tzelicrae\", \"category\": \"Bloodline\", \"trackSize\": 5, \"description\": \"Burn to leave your skin for a short period. When outside your skin you are a mass of moving spiders, and can easily move through small spaces and climb any surface.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Tzelicrae-Manifold Linguist\", \"name\": \"Manifold Linguist\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Tzelicrae\", \"category\": \"Bloodline\", \"trackSize\": 3, \"description\": \"You count as fluent when communicating with intelligent insects, hive-minds and other tzelicrae, regardless of languages used.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Tzelicrae-Swarm-Scout\", \"name\": \"Swarm-Scout\", \"type\": \"Companion\", \"track\": 3, \"source\": \"Tzelicrae\", \"category\": \"Bloodline\", \"trackSize\": 3, \"customized\": true, \"damageTypes\": {\"options\": [\"Toxin\"], \"category\": \"resistance\", \"selectionType\": \"fixed\"}, \"description\": \"A single spider you can send ahead as a scout, allowing you to see and hear at a distance. ENHANCED: Owner is resistant to toxin damage.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Dredger-Lurid Cartography\", \"name\": \"Lurid Cartography\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Dredger\", \"category\": \"Post\", \"trackSize\": 3, \"description\": \"You can use charts to find shipwrecks and disasters as well as the usual islands and oddities.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Anchored-Resonant Tether\", \"name\": \"Resonant Tether\", \"type\": \"Gear\", \"track\": 2, \"source\": \"Anchored\", \"category\": \"Origin\", \"trackSize\": 2, \"description\": \"Spirits and the spectral realm become more visible and tangible to your entire crew in your presence.\", \"damageStates\": [\"default\", \"default\"], \"selectedDamageTypes\": {}}],\"selected_edges\":[\"Sharps\", \"Teeth\", \"Iron\"],\"skills\":{\"Brace\": 2, \"Delve\": 2, \"Sense\": 2, \"Vault\": 1, \"Outwit\": 1, \"Scavenge\": 2},\"languages\":{\"Gaudimm\": 1, \"Highvin\": 2, \"Saprekk\": 1, \"Low Sour\": 3, \"Old Hand\": 1},\"drives\":[\"Solve problems in tzelicrae settlements.\\tYou can just change them.\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\", \"Reconnect with your friends and family. But maybe this is out of date now?\\t\\t\\t\\t\\t\\t\\t\", \"Discover an untouched pre-verdent ruin.\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\"],\"mires\":[{\"text\": \"Your movements are staccato, disturbing.\\t\\t\\t\\t\\t\\t\\t\\t\\t\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"Visions of your past death are difficult to banish.\\t\\t\\t\\t\\t\\t\\t\\t\\t\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"Your movements cause wrecks to shift and creak.\\t\\t\\t\\t\\t\\t\\t\\t\\t\", \"checkbox1\": false, \"checkbox2\": false}],\"milestones\":[{\"id\": \"1761137819276\", \"name\": \"forged a bond with the bot\", \"used\": true, \"scale\": \"Minor\"}, {\"id\": \"1761137827008\", \"name\": \"captured a bot\", \"used\": false, \"scale\": \"Minor\"}, {\"id\": \"1761137830714\", \"name\": \"spectacular full ship salvage\\t\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Minor\"}, {\"id\": \"1761137834156\", \"name\": \"Back to spawn point\\t\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Minor\"}, {\"id\": \"1761137845647\", \"name\": \"GOOD SHOPPING AND TRADING\\t\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Minor\"}, {\"id\": \"1761137849809\", \"name\": \"Mustache gun, the son of teeth emerges\\t\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Minor\"}, {\"id\": \"1761137855464\", \"name\": \"escaped the stone\\t\\t\\t\\t\\t\", \"used\": true, \"scale\": \"Major\"}, {\"id\": \"1761137860662\", \"name\": \"Finishing Mr. Haulin's Opus Quest\\t\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Major\"}, {\"id\": \"1761137865964\", \"name\": \"BEOWOLF USES TEETH TO CLINCH THE (3rd place) WIN at Incisor's Run in Tandrich\\t\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Major\"}, {\"id\": \"1761137871439\", \"name\": \"MAJOR MILESTONE to be named later\", \"used\": false, \"scale\": \"Major\"}],\"resources\":{\"charts\": [{\"id\": \"1761137924383\", \"name\": \"A Port Manifest in Knock\"}, {\"id\": \"1761137932265\", \"name\": \"A Bird's-Eye Sketch\\t\\t\\t\\t\", \"used\": true}], \"salvage\": [{\"id\": \"1761137916838\", \"name\": \"Curious Compass (from magnetron for the home to roost whisper)\"}], \"whispers\": [{\"id\": \"1761137939758\", \"name\": \"Gathered Storm\\t\\t\\t\\t\\t\", \"used\": true}, {\"id\": \"1761137944333\", \"name\": \"Snow's Silence\"}], \"specimens\": []},\"created_at\":\"2025-10-22T12:50:17.548368+00:00\",\"updated_at\":\"2025-11-06T02:01:56.623+00:00\",\"tasks\":[{\"id\": \"1761138006232\", \"name\": \"improvements on the spiderbot/egg situation\", \"editing\": false, \"maxTicks\": 3, \"currentTicks\": 2}],\"notes\":\"Resistance to toxin damage, is a benefit from the steam familiar doubles on paper mache skin...\\nDid some paper mache, see notes for details on that.\\nSecond damage to skin is just normal damage though, can be healed next time.\\n\\n2 parts to a TRACK FOR A PROJECT TO DO SOME HOME IMPROVEMENTS ON THE SPIDER-BOT/EGG situation (see notes for details)\\nSome anchored prefer to hide their face, letting the memories of their time among the living fade. Treat conflicts as triumphs when attempting to unnerve or unsettle. Now with a matching sawnana blade tongue attachment weapon, dealing CQ Volt or Salt damage\",\"journey_role\":\"on-watch\"}"
