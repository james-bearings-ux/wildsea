          "content": {
            "size": 3458,
            "mimeType": "application/vnd.pgrst.object+json",
            "text": "{\"id\":\"6c111e18-2c91-43f8-961c-8c6ce0cb001d\",\"session_id\":\"ba8b7220-b27f-4c8c-b89e-9dc5eac93970\",\"name\":\"Dash\",\"mode\":\"play\",\"bloodline\":\"Ardent\",\"origin\":\"Amberclad\",\"post\":\"Crash\",\"selected_aspects\":[{\"id\": \"Crash-Zero Days\", \"name\": \"Zero Days\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Crash\", \"category\": \"Post\", \"trackSize\": 3, \"description\": \"Once per scene, ignore any damage to yourself that comes as a result of your own destructive actions.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Crash-Load-Bearing Wall\", \"name\": \"Load-Bearing Wall\", \"type\": \"Trait\", \"track\": 4, \"source\": \"Crash\", \"category\": \"Post\", \"trackSize\": 4, \"description\": \"Use a task to identify hidden elements essential to the integrity of a structure.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Amberclad-Endless Golden Age\", \"name\": \"Endless Golden Age\", \"type\": \"Trait\", \"track\": 5, \"source\": \"Amberclad\", \"category\": \"Origin\", \"trackSize\": 5, \"description\": \"You didn't age throughout your imprisonment, and you don't seem to be aging now you're free either. A blessing, but a curious one.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ardent-Strong Stomach\", \"name\": \"Strong Stomach\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Ardent\", \"category\": \"Bloodline\", \"trackSize\": 3, \"description\": \"Reduce the impact of poisons, diseases and sickness.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ardent-Sporescarf\", \"name\": \"Sporescarf\", \"type\": \"Gear\", \"track\": 4, \"source\": \"Ardent\", \"category\": \"Bloodline\", \"trackSize\": 4, \"damageTypes\": {\"options\": [\"bad air\", \"airborne spores\"], \"category\": \"resistance\", \"selectionType\": \"fixed\"}, \"description\": \"Thickly-woven fibres sealed with tar. Resist the effects of bad air and airborne spores.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ardent-Ironclad Mind\", \"name\": \"Ironclad Mind\", \"type\": \"Trait\", \"track\": 4, \"source\": \"Ardent\", \"category\": \"Bloodline\", \"trackSize\": 4, \"damageTypes\": [{\"options\": [\"Hallucinations\", \"Mesmerics\", \"Mental compulsions\"], \"category\": \"immunity\", \"selectionType\": \"fixed\"}], \"description\": \"You are immune to hallucinations, mesmerics and mental compulsions.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Crash-Crude Tools\", \"name\": \"Crude Tools\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Crash\", \"category\": \"Post\", \"trackSize\": 3, \"description\": \"Your solutions may not be clever, but they work. You may use the Break skill to construct simple tools.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}],\"selected_edges\":[\"Veils\", \"Instinct\", \"Iron\"],\"skills\":{\"Hack\": 1, \"Sway\": 2, \"Brace\": 2, \"Break\": 2, \"Delve\": 1, \"Study\": 1, \"Vault\": 2, \"Outwit\": 2, \"Wavewalk\": 1},\"languages\":{\"Highvin\": 1, \"Chthonic\": 3, \"Low Sour\": 3},\"drives\":[\"\", \"\", \"\"],\"mires\":[{\"text\": \"\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"\", \"checkbox1\": false, \"checkbox2\": false}],\"milestones\":[],\"resources\":{\"charts\": [], \"salvage\": [], \"whispers\": [], \"specimens\": []},\"created_at\":\"2025-11-06T11:32:53.408089+00:00\",\"updated_at\":\"2025-11-06T11:37:46.826+00:00\",\"tasks\":[],\"notes\":\"\",\"journey_role\":\"\"}"
