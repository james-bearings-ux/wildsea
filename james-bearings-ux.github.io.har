          "content": {
            "size": 6276,
            "mimeType": "application/vnd.pgrst.object+json",
            "text": "{\"id\":\"be0171ca-b62c-4df2-9ea9-2062f1a3ca82\",\"session_id\":\"ba8b7220-b27f-4c8c-b89e-9dc5eac93970\",\"name\":\"Magnetron\",\"mode\":\"play\",\"bloodline\":\"Ironbound\",\"origin\":\"Anchored\",\"post\":\"Screw\",\"selected_aspects\":[{\"id\": \"Screw-Ferrokinesis\", \"name\": \"Ferrokinesis\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Screw\", \"category\": \"Post\", \"trackSize\": 3, \"description\": \"Mark to control or reshape exposed metal.\", \"damageStates\": [\"marked\", \"marked\", \"marked\"], \"selectedDamageTypes\": {}}, {\"id\": \"Screw-Rivet Swarm\", \"name\": \"Rivet Swarm\", \"type\": \"Companion\", \"track\": 3, \"source\": \"Screw\", \"category\": \"Post\", \"trackSize\": 3, \"damageTypes\": {\"range\": \"LR\", \"options\": [\"Spike\", \"Keen\"], \"category\": \"dealing\", \"selectionType\": \"fixed\"}, \"description\": \"A cloud of floating debris you can direct with a flick of the wrist. Deals LR spike or keen damage.\", \"damageStates\": [\"marked\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ironbound-Prowhammer\", \"name\": \"Geist Hand-mmer\", \"type\": \"Gear\", \"track\": 4, \"source\": \"Ironbound\", \"category\": \"Bloodline\", \"trackSize\": 5, \"customized\": true, \"damageTypes\": [{\"range\": \"CQ\", \"options\": [\"Blunt\"], \"category\": \"dealing\", \"chooseCount\": null, \"selectionType\": \"fixed\"}], \"description\": \"A ship's prow, refashioned into a massive bludgeoning weapon.  Deals CQ blunt damage. Can manipulate nearby objects without touching them, though the heavier they are the harder it is.  Only one trait is available at a time. Grabbing someone with the geist hand can phase them into geistdom. Burning a square can phase them out permanently.\", \"damageStates\": [\"marked\", \"marked\", \"marked\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Anchored-Mortal Needs\", \"name\": \"Mortal Needs\", \"type\": \"Trait\", \"track\": 2, \"source\": \"Anchored\", \"category\": \"Origin\", \"trackSize\": 2, \"description\": \"Though you can do so if you choose, you have no real need to eat, drink, sleep or breathe.\", \"damageStates\": [\"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ironbound-Ornate Cannon\", \"name\": \"Ornate Cannon\", \"type\": \"Gear\", \"track\": 2, \"source\": \"Ironbound\", \"category\": \"Bloodline\", \"trackSize\": 4, \"damageTypes\": {\"range\": \"LR\", \"options\": [\"Blast\"], \"category\": \"dealing\", \"selectionType\": \"fixed\"}, \"description\": \"A huge ships's cannon loaded with explosive shells. Deals LR blast damage. Increase impact when targeting a horde or swarm of targets.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Mothryn-Elaborate Beard-Braids\", \"name\": \"Elaborate Beard-Braids\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Mothryn\", \"category\": \"Bloodline\", \"trackSize\": 3, \"description\": \"Your beard is a rich, intertwining mass of fur and braids, perfect for concealing small objects. Burn to gain a new piece of salvage or specimen from within it (that you might conceivably have stashed there).\", \"damageStates\": [\"marked\", \"marked\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Anchored-By a Thread\", \"name\": \"By a Thread\", \"type\": \"Trait\", \"track\": 1, \"source\": \"Anchored\", \"category\": \"Origin\", \"trackSize\": 1, \"damageTypes\": [{\"options\": [\"Salt\", \"Volt\"], \"category\": \"weakness\", \"selectionType\": \"fixed\"}, {\"options\": [\"Blunt\", \"Keen\", \"Spike\"], \"category\": \"immunity\", \"selectionType\": \"fixed\"}], \"description\": \"Your grip on the world is tentative, but that does come with certain benefits. You are weak to salt and volt damage, but immune to blunt, keen and spike.\", \"damageStates\": [\"default\"], \"selectedDamageTypes\": {}}],\"selected_edges\":[\"Iron\", \"Instinct\", \"Teeth\"],\"skills\":{\"Brace\": 2, \"Break\": 2, \"Delve\": 2, \"Sense\": 3, \"Vault\": 2, \"Rattle\": 2, \"Wavewalk\": 1},\"languages\":{\"Low Sour\": 3, \"Raka Spit\": 1, \"Signaling\": 2},\"drives\":[\"Discover a source of pure metal.\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\", \"Free a shackled-ship construct.\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\", \"Chart new highports, connecting distant cultures\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\"],\"mires\":[{\"text\": \"Magnetic forces in your surrounding area are unpredictable.\\t\\t\\t\\t\\t\\t\\t\\t\\t\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"Your body cracks and splits, weakness spreading.\\t\\t\\t\\t\\t\\t\\t\\t\\t\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"The waves call for you to travel deeper than is safe.\\t\\t\\t\\t\\t\\t\\t\\t\\t\", \"checkbox1\": false, \"checkbox2\": false}],\"milestones\":[{\"id\": \"1761139544087\", \"name\": \"Wanna buy a watch?\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Minor\"}, {\"id\": \"1761139550650\", \"name\": \"Good shopping and trading\\t\\t\\t\\t\", \"used\": false, \"scale\": \"Minor\"}, {\"id\": \"1761139556057\", \"name\": \"Killed carniverous vines\", \"used\": false, \"scale\": \"Minor\"}, {\"id\": \"1761139689582\", \"name\": \"Mustache Gun the Son of Teeth emerges!\", \"used\": false, \"scale\": \"Minor\"}],\"resources\":{\"charts\": [{\"id\": \"1761139602963\", \"name\": \"corroded iron scroll of fire\\t\\t\\t\\t\\t\"}, {\"id\": \"1761139606984\", \"name\": \"Mournful Wordbearer Divination Sticks\\t\\t\\t\\t\\t\"}], \"salvage\": [{\"id\": \"1761139615557\", \"name\": \"Broken Pocketwatch\"}, {\"id\": \"1761139620431\", \"name\": \"coil of rope\"}, {\"id\": \"1761139629604\", \"name\": \"Happy Slapper - Bundle of rivits in a stocking\\t\\t\\t\\t\"}, {\"id\": \"1761139635559\", \"name\": \"Knucklebone Dice\\t\\t\\t\\t\"}, {\"id\": \"1761139639864\", \"name\": \"240lb grandfather clock - 7ft tall\\t\\t\\t\\t\"}, {\"id\": \"1761784175738\", \"name\": \"Crazy Badass Swords\\t\\t\\t\\t\\t\", \"used\": false}], \"whispers\": [{\"id\": \"1761139644559\", \"name\": \"Home to roost\\t\\t\\t\\t\"}, {\"id\": \"1761139649127\", \"name\": \"Ice's Clarity\\t\\t\\t\\t\"}, {\"id\": \"1761139654745\", \"name\": \"Which ghost farted? (trick question 'cause we know)\\t\\t\\t\\t\"}], \"specimens\": [{\"id\": \"1761139672790\", \"name\": \"eyime piece\\t\\t\\t\\t\\t\"}, {\"id\": \"1761139676555\", \"name\": \"Chitin Dice\\t\\t\\t\\t\\t\"}]},\"created_at\":\"2025-10-22T13:13:54.500649+00:00\",\"updated_at\":\"2025-11-06T21:51:53.618+00:00\",\"tasks\":[{\"id\": \"1761826487246\", \"name\": \"Magnetron looking to learn to eat and stop being vulnerable to Salt\", \"editing\": false, \"maxTicks\": 2, \"currentTicks\": 1}],\"notes\":\"Prow hammer is partially phased out as spirit\\nCan put two salvage or specimens in to un burn a beard braid box\\nMournful Wordbearer divination sticks count as the \\\"void scroll\\\"\\nIvory Majong Tiles - Bird, #6, Water with a boat\\nPristine Leaky Drinking Boot (gear, not salvage)\",\"journey_role\":\"at-the-helm\"}"
          },
