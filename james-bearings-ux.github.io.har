          "content": {
            "size": 3300,
            "mimeType": "application/vnd.pgrst.object+json",
            "text": "{\"id\":\"fa59e0de-883a-43c1-9a45-3b7f56a74836\",\"session_id\":\"ba8b7220-b27f-4c8c-b89e-9dc5eac93970\",\"name\":\"Pacific\",\"mode\":\"play\",\"bloodline\":\"Ironbound\",\"origin\":\"Anchored\",\"post\":\"Wordbearer\",\"selected_aspects\":[{\"id\": \"Ironbound-Titanic\", \"name\": \"Titanic\", \"type\": \"Trait\", \"track\": 5, \"source\": \"Ironbound\", \"category\": \"Bloodline\", \"trackSize\": 5, \"description\": \"You're an imposing presence, a weight on the world.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Anchored-Mortal Needs\", \"name\": \"Mortal Needs\", \"type\": \"Trait\", \"track\": 2, \"source\": \"Anchored\", \"category\": \"Origin\", \"trackSize\": 2, \"description\": \"Though you can do so if you choose, you have no real need to eat, drink, sleep or breathe.\", \"damageStates\": [\"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Wordbearer-Respect Runs Deep\", \"name\": \"Respect Runs Deep\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Wordbearer\", \"category\": \"Post\", \"trackSize\": 3, \"description\": \"Your clothes, your posture, your look - wordbearers are afforded a rare respect. Treat conflicts as triumphs when commanding authority in a settlement with a junction.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ironbound-Living Workshop\", \"name\": \"Living Workshop\", \"type\": \"Gear\", \"track\": 4, \"source\": \"Ironbound\", \"category\": \"Bloodline\", \"trackSize\": 4, \"description\": \"Your own wreck-salvaged body contains an array of useful tools - your presence gives an automatic advantage on rolls taken to create temporary gear and machinery to all crewmates.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Wordbearer-Weatherbeaten\", \"name\": \"Weatherbeaten\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Wordbearer\", \"category\": \"Post\", \"trackSize\": 3, \"damageTypes\": {\"options\": [\"Blast\", \"Acid\", \"Toxin\", \"Frost\", \"Flame\"], \"category\": \"resistance\", \"chooseCount\": 3, \"selectionType\": \"choose\"}, \"description\": \"You're resistant to three damage types, chosen from the following list: Blast, Acid, Toxin, Frost, Flame.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {\"resistance\": [\"Blast\", \"Acid\", \"Flame\"]}}],\"selected_edges\":[\"Iron\", \"Teeth\", \"Tides\"],\"skills\":{\"Hack\": 1, \"Sway\": 1, \"Brace\": 2, \"Break\": 1, \"Sense\": 1, \"Rattle\": 2},\"languages\":{\"Low Sour\": 3},\"drives\":[\"Deliver a fragile package or missive to a distant receiver\", \"Reconnect with your friends and family\", \"Rescue an abandoned ship\"],\"mires\":[{\"text\": \"Sad old secrets from messages past tug at your dreams\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"The world away from the waves is quiet, distant\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"Sleep pulls at your mind, an old and dangerous friend\", \"checkbox1\": false, \"checkbox2\": false}],\"milestones\":[],\"resources\":{\"charts\": [{\"id\": \"4058f6f4-352b-4a6e-9d48-e5f244affc28\", \"name\": \"A robins-egg blue envelope\", \"used\": false}, {\"id\": \"29e06476-c206-4ca0-a38c-f8021f1919eb\", \"name\": \"A tattered schedule\", \"used\": false}], \"salvage\": [], \"whispers\": [], \"specimens\": []},\"created_at\":\"2025-11-06T11:38:57.854022+00:00\",\"updated_at\":\"2025-11-06T13:29:28.969+00:00\",\"tasks\":[],\"notes\":\"\",\"journey_role\":\"watch-the-weather\"}"
