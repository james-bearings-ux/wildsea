          "cookies": [],
          "content": {
            "size": 59746,
            "mimeType": "application/json",
            "text": "{\n  \"ratings\": [\n    {\n      \"name\": \"Armour\",\n      \"description\": \"A measure of your ship's resistance to damage. You'll likely roll your armour rating when a larger creature attacks your ship, when you're fired on by pirates, or when you brute-force the ship through a hazardous area of the sea.\"\n    },\n    {\n      \"name\": \"Seals\",\n      \"description\": \"A measure of how well your ship keeps the wildsea out while travelling. You'll likely roll your seals rating when there's a sporestorm, insect swarm, or other potentially invasive presence.\"\n    },\n    {\n      \"name\": \"Speed\",\n      \"description\": \"The speed of your ship when the engines are running smoothly. You'll likely roll your speed rating when attempting to outrun a pursuer or weather pattern, or if you somehow find yourself in a race.\"\n    },\n    {\n      \"name\": \"Saws\",\n      \"description\": \"How good your ship is at cutting through the denser parts of the sea. You'll likely roll your saws rating when cutting through thicker areas of the sea or trying to ram other ships.\"\n    },\n    {\n      \"name\": \"Stealth\",\n      \"description\": \"Your ship's ability to run low, sleek, and undetected. You'll likely roll your stealth rating when trying to minimize the noise of your engine or the trail you leave, or when trying to avoid the notice of distant threats.\"\n    },\n    {\n      \"name\": \"Tilt\",\n      \"description\": \"A measure of manoeuvrability, and how well your ship can tackle the sharper dips and rises of the waves. You'll likely roll your tilt rating when tackling one of the larger treetop waves, when diving down into the tangle to evade a pursuer, or when trying to keep steady during a rootquake or storm.\"\n    }\n  ],\n  \"sizes\": [\n    {\n      \"name\": \"Nano\",\n      \"stakes\": 1,\n      \"description\": \"Suited for a single sailor and maybe a passenger or two. Perfect for the lone wildsailor, possessed of excess bravery (or a deathwish).\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 1\n        }\n      ]\n    },\n    {\n      \"name\": \"Small\",\n      \"stakes\": 1,\n      \"description\": \"Suited for 2-4 people, cramped but serviceable for double that. Ideal for a first ship.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        }\n      ]\n    },\n    {\n      \"name\": \"Standard\",\n      \"stakes\": 1,\n      \"description\": \"Comfortable for 5-10 people, but can hold double that number if necessary. The majority of ships out on the Wildsea are of standard size, hence the name.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        }\n      ]\n    },\n    {\n      \"name\": \"Large\",\n      \"stakes\": 1,\n      \"description\": \"Can house 10-20 crew with room to spare, many more if necessary, depending on the internal designs and additional fittings. Large ships are most often used to patrol trade-routes around more lawful areas, or to transport settlers and research teams for large factions.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Stealth\",\n          \"value\": -1\n        }\n      ]\n    }\n  ],\n  \"frames\": [\n    {\n      \"name\": \"Sturdy\",\n      \"stakes\": 1,\n      \"description\": \"Built to last in a place of temporary things, a sturdy frame helps weather the strongest assaults.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        }\n      ]\n    },\n    {\n      \"name\": \"Moulded\",\n      \"stakes\": 1,\n      \"description\": \"A single unbroken structure running through the ship - quite a feat of safety-conscious engineering.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Seals\",\n          \"value\": 1\n        }\n      ]\n    },\n    {\n      \"name\": \"Light\",\n      \"stakes\": 1,\n      \"description\": \"Made with the lightest possible materials in the smallest possible amounts.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        }\n      ]\n    },\n    {\n      \"name\": \"Scything\",\n      \"stakes\": 1,\n      \"description\": \"Often wedge or blade-shaped, scything frames are constructed specifically to cut as efficiently as possible through the waves.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Saws\",\n          \"value\": 1\n        }\n      ]\n    },\n    {\n      \"name\": \"Sleek\",\n      \"stakes\": 1,\n      \"description\": \"Quiet is hard to come by on the wildsea, but a sleek frame ensures that no matter how noisy your bite and engine might be, you'll always be low to the waves.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 1\n        }\n      ]\n    },\n    {\n      \"name\": \"Flexible\",\n      \"stakes\": 1,\n      \"description\": \"Built for adjustability and responsiveness, flexible frames are often multi-segmented or jointed in some way.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 1\n        }\n      ]\n    }\n  ],\n  \"hulls\": [\n    {\n      \"name\": \"Reef-Iron\",\n      \"stakes\": 1,\n      \"description\": \"Metal plating from decommissioned ships, reshaped for your frame. Durable and rust-resistant.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": []\n    },\n    {\n      \"name\": \"Leviathan Bone\",\n      \"stakes\": 1,\n      \"description\": \"A hull crafted from one or more pieces of leviathan skeleton. Solid, if a little morbid.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Seals\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": []\n    },\n    {\n      \"name\": \"Broadwood\",\n      \"stakes\": 1,\n      \"description\": \"Wooden planks cut from the more reliable trees of the wildsea. Strong and flexible.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": []\n    },\n    {\n      \"name\": \"Rough Bark\",\n      \"stakes\": 1,\n      \"description\": \"Harvested from the ironroots. Irregular and tough to maintain, but easy for others to overlook at distance across the waves.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": []\n    },\n    {\n      \"name\": \"Chitinous\",\n      \"stakes\": 1,\n      \"description\": \"Made from the collected shells of the wildsea's larger insects. Smooth, offering little in the way of friction or snags.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": []\n    },\n    {\n      \"name\": \"Razorscale\",\n      \"stakes\": 1,\n      \"description\": \"An exterior of interlocking scales sloughed or harvested from a wildsea beast, sharpened for effectiveness.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Saws\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": []\n    },\n    {\n      \"name\": \"Beastback\",\n      \"stakes\": 2,\n      \"description\": \"A half-living hull of flesh and bone, flexible and unsettlingly warm.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Seals\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": []\n    },\n    {\n      \"name\": \"Ceramic\",\n      \"stakes\": 2,\n      \"description\": \"A shell of heavy baked clay. Ostentatious and brittle unless *very* carefully maintained.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Seals\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": []\n    },\n    {\n      \"name\": \"Chrysalid\",\n      \"stakes\": 2,\n      \"description\": \"A hull adapted from the cast-off chrysalis of a massive insect, excellent protection against the sea's incursion.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Seals\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": []\n    },\n    {\n      \"name\": \"Ghost-Oak\",\n      \"stakes\": 2,\n      \"description\": \"Pale as death and remarkably flexible, ghost-oak is rarely found growing outside the lightless depths of the drown.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": []\n    },\n    {\n      \"name\": \"Arachnesque\",\n      \"stakes\": 2,\n      \"description\": \"Less of a hull and more of a giant insect grown to fit the specifications of your frame, usually something spider-like.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": []\n    },\n    {\n      \"name\": \"Exile's Copper\",\n      \"stakes\": 2,\n      \"description\": \"A rare metal that weighs far, far less than it has any right to, prized for racing-ship hulls.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": []\n    },\n    {\n      \"name\": \"Junk-Strung\",\n      \"stakes\": 0,\n      \"description\": \"The mark of a ship well-scarred and oft-repaired, a junk-strung hull is barely a hull at all... More a collection of scavenged metal, driftwood, and animal bones; unstable, rusting, and leaky.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Seals\",\n          \"value\": -1\n        }\n      ],\n      \"specials\": [\n        \"Mark your seals or armour rating to pull a piece of useful salvage from the hull.\"\n      ]\n    },\n    {\n      \"name\": \"Floraflage\",\n      \"stakes\": 2,\n      \"description\": \"A hull of living vegetation grown purposefully around your frame. Blends easily into the seascape.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 2\n        },\n        {\n          \"rating\": \"Armour\",\n          \"value\": -1\n        }\n      ],\n      \"specials\": [\n        \"A floraflage ship at rest is almost impossible to detect - increase impact when using stealth while motionless.\"\n      ]\n    },\n    {\n      \"name\": \"Monument\",\n      \"stakes\": 3,\n      \"description\": \"An absurd affectation in a world of flexible branches and endless depth, monument hulls are made of appallingly heavy mountain-stone.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 2\n        },\n        {\n          \"rating\": \"Seals\",\n          \"value\": 2\n        }\n      ],\n      \"specials\": [\n        \"A ship with a monument hull can't Forge Ahead during a journey.\"\n      ]\n    },\n    {\n      \"name\": \"Husk-Scale\",\n      \"stakes\": 2,\n      \"description\": \"A flexible, organic hull material made from alchemically altered fruits and mushrooms.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Seals\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Damage to a ship's Armour and Seals ratings can be repaired using garden-grown specimens, rather than the usual salvage required.\"\n      ]\n    },\n    {\n      \"name\": \"Parasite Planking\",\n      \"stakes\": 3,\n      \"description\": \"Wood carefully cut from long-used parasite farm branches, treated to resist incoming damage but natural enough that plants can still take root.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Gain two plots on your ship named 'planking rootbeds'. Parasite seeds sown within these plots don't gain the usual extra box on their Grow tracks.\"\n      ]\n    }\n  ],\n  \"bite\": [\n    {\n      \"name\": \"Sawprow\",\n      \"stakes\": 1,\n      \"description\": \"A wildsea favourite, the sawprow is a chainsaw edge that runs down the curve of the prow. Capable of cutting through most obstructions with ease.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Saws\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Deals massive CQ Serrated damage\"\n      ]\n    },\n    {\n      \"name\": \"Impellers\",\n      \"stakes\": 1,\n      \"description\": \"Large jet-like outboard engines that push the ship through the waves with brute force.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Deals massive CQ Blast damage\"\n      ]\n    },\n    {\n      \"name\": \"Crawler\",\n      \"stakes\": 1,\n      \"description\": \"Large finger-like mechanisms spread out around the front of the ship, allowing it to move through the waves with a crawling motion.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Deals massive CQ Blunt damage\"\n      ]\n    },\n    {\n      \"name\": \"Underscales\",\n      \"stakes\": 1,\n      \"description\": \"Thousands of flexing scales that worm the ship forward with a sly, sinuous motion.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Deals massive CQ Keen damage\"\n      ]\n    },\n    {\n      \"name\": \"Jag-Tracks\",\n      \"stakes\": 1,\n      \"description\": \"Motorised grapple tracks along the keel and hull-sides; a slow, solid, and reliable choice.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Deals massive CQ Hewing damage\"\n      ]\n    },\n    {\n      \"name\": \"Sluicejets\",\n      \"stakes\": 1,\n      \"description\": \"Pressurised sluice systems filled with phytophobic chemicals, for coating the hull and pushing the ship.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Seals\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Deals massive CQ Acid damage\"\n      ]\n    },\n    {\n      \"name\": \"Longjaw\",\n      \"stakes\": 2,\n      \"description\": \"An underslung chainsaw arrangement that extends from the front of the ship, chewing and pulling forward.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Saws\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Deals massive CQ Serrated damage\"\n      ]\n    },\n    {\n      \"name\": \"Propeller-Cage\",\n      \"stakes\": 2,\n      \"description\": \"A cage housing that holds large airboat-style propellers used to push the ship forward.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Deals massive CQ Blunt damage\"\n      ]\n    },\n    {\n      \"name\": \"Navapede Limbs\",\n      \"stakes\": 2,\n      \"description\": \"Centipedal limbs lining the hull, letting a ship scuttle through the thrash. If such a vessel could truly now be called a ship, of course.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Deals massive CQ Spike damage\"\n      ]\n    },\n    {\n      \"name\": \"Voltaic Runners\",\n      \"stakes\": 2,\n      \"description\": \"Crackling with barely contained lightning, these outboard contraptions let a ship float just above the churning branches of the sea.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Seals\",\n          \"value\": 2\n        }\n      ],\n      \"specials\": [\n        \"Deals massive CQ Volt damage\"\n      ]\n    },\n    {\n      \"name\": \"Mulcher\",\n      \"stakes\": 2,\n      \"description\": \"Grinding teeth in a lamprey-style mouth. Terribly noisy but dreadfully effective.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Saws\",\n          \"value\": 2\n        },\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Stealth\",\n          \"value\": -1\n        }\n      ],\n      \"specials\": [\n        \"Deals massive CQ Serrated damage\"\n      ]\n    },\n    {\n      \"name\": \"Tentaculari\",\n      \"stakes\": 2,\n      \"description\": \"A living cluster of tendrils or tentacles attached to the ship's hull, carrying it through and across the waves in an unsettlingly alien motion.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 2\n        }\n      ],\n      \"specials\": [\n        \"Deals massive CQ Salt damage\"\n      ]\n    },\n    {\n      \"name\": \"Square Sail\",\n      \"stakes\": 1,\n      \"description\": \"Taut canvas that relies on a strong breeze, this design harks back to an age of calm, clear waters.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Only effective in favourable winds\"\n      ]\n    },\n    {\n      \"name\": \"Sleek Sail\",\n      \"stakes\": 1,\n      \"description\": \"Triangular and manually angled, relying on an attentive crew to catch the right breezes.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Only effective in favourable winds\"\n      ]\n    },\n    {\n      \"name\": \"Sweat-Sails\",\n      \"stakes\": 1,\n      \"description\": \"Held low to the waves, unfurled canvases shaped to catch the rising under-canopy heat.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Only effective in warm weather\"\n      ]\n    },\n    {\n      \"name\": \"Tethered Kites\",\n      \"stakes\": 2,\n      \"description\": \"An array of kites that catch the stronger winds of the lower air.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 2\n        }\n      ],\n      \"specials\": [\n        \"Only effective in favourable winds\"\n      ]\n    },\n    {\n      \"name\": \"Gecko Sails\",\n      \"stakes\": 2,\n      \"description\": \"A reinforced multi-sail arrangement designed to tame even the wildest gusts.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Only effective in favourable winds\"\n      ]\n    },\n    {\n      \"name\": \"Sharpened Prow\",\n      \"stakes\": 0,\n      \"description\": \"Simple and straightforward, a honed blade running the length of the ship's prow to cut through vegetation.\",\n      \"bonuses\": [],\n      \"specials\": [\n        \"Provides a basic cutting edge, but no motive force. Just about works when paired with oars, but you really should choose something better.\",\n        \"Deals massive CQ Keen damage... or it would, if you could get up enough speed.\"\n      ]\n    },\n    {\n      \"name\": \"Beast-Reins\",\n      \"stakes\": 1,\n      \"description\": \"An arrangement similar to a leash or yoke, allowing well-trained beasts to pull the ship like a chariot.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"When you choose beast-reins, decide what kind of beasts they hold (giant centipedes are a solid choice).\",\n        \"A ship with beast-reins doesn't require an engine choice from the next section, but the beasts themselves do require care, feeding, and sleep.\"\n      ]\n    },\n    {\n      \"name\": \"Grappling Array\",\n      \"stakes\": 1,\n      \"description\": \"Prow-mounted grappling hooks that are fired out to catch on branches and then laboriously wound back in for slow, inexorable progress.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 2\n        },\n        {\n          \"rating\": \"Speed\",\n          \"value\": -1\n        }\n      ],\n      \"specials\": [\n        \"A ship running solely on a grappling array can't Forge Ahead during a journey.\",\n        \"Deals massive LR Spike damage.\"\n      ]\n    },\n    {\n      \"name\": \"Threshing Combine\",\n      \"stakes\": 2,\n      \"description\": \"Rotating blades at the font of the ship, with netting and gathering equipment at their rear.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Saws\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Whenever you Cut a Path, roll a d6. On a 6, you gain a Wild or Rampant seed specimen appropriate for the waves you're passing through.\"\n      ]\n    }\n  ],\n  \"engines\": [\n    {\n      \"name\": \"Chemical Compressor\",\n      \"stakes\": 1,\n      \"description\": \"The most common engine on the rustling waves, reliably unreliable but extremely easy to fuel.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Fuelled with crushed fruit and insect husks\"\n      ]\n    },\n    {\n      \"name\": \"Springwork\",\n      \"stakes\": 1,\n      \"description\": \"Wound exhaustively by hand, springwork engines store and release kinetic energy with surprising efficiency.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Saws\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Fuelled with sweat, labour, and time spent winding\"\n      ]\n    },\n    {\n      \"name\": \"Parasite Pitcher\",\n      \"stakes\": 1,\n      \"description\": \"A large pitcher plant coaxed into taking root in an engine housing, vines intermingling with the ship's systems.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Fuelled with organic material (preferably living)\"\n      ]\n    },\n    {\n      \"name\": \"Steam Piping\",\n      \"stakes\": 1,\n      \"description\": \"Hellish contraptions of tangled piping, rare chemicals, and scalding steam.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Seals\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Fuelled with water (the cleaner the better)\"\n      ]\n    },\n    {\n      \"name\": \"Ratwheel Exchange\",\n      \"stakes\": 1,\n      \"description\": \"Exactly what you might imagine, a pure transfer of kinetic energy from restless rats to wheel to bite. Ethical engineers tend to give their rats the run of the ship.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"The rats need feeding every now and then, but they're not fussy\"\n      ]\n    },\n    {\n      \"name\": \"Pulsing Cocoon\",\n      \"stakes\": 1,\n      \"description\": \"An unknown insect shifts inside, glutting on dreams and spinning them into an ebb of arconautic force. Crews report intensely vivid dreams.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Fueled with the dreams of the crew\"\n      ]\n    },\n    {\n      \"name\": \"Tamed Hive\",\n      \"stakes\": 2,\n      \"description\": \"A buzzing organic engine of honeycombs and crawling workers, their movements a complex dance.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Seals\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Fueled with stolen flowers and unprocessed pollen.\",\n        \"Crew can use a task while at sea to gain a resource, 'Fresh Engine-Honey', once per journey.\"\n      ]\n    },\n    {\n      \"name\": \"Reclaimed Burner\",\n      \"stakes\": 2,\n      \"description\": \"An ancient burner that runs on processed chemical fuel, salvaged from the innards of a pre-verdant ship. Requires excessive ventilation. Don't use this.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 3\n        },\n        {\n          \"rating\": \"Seals\",\n          \"value\": -1\n        }\n      ],\n      \"specials\": [\n        \"Runs on processed chemical fuel.\",\n        \"Liable to explode if seriously damaged.\"\n      ]\n    },\n    {\n      \"name\": \"Jawbox\",\n      \"stakes\": 1,\n      \"description\": \"Noisy, wood-fueled engines that create huge clouds of smoke and dust but with minimum chance of flame.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Saws\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Stealth\",\n          \"value\": -1\n        }\n      ],\n      \"specials\": [\n        \"Fueled with wildsea wood\"\n      ]\n    },\n    {\n      \"name\": \"Solar Compressor\",\n      \"stakes\": 2,\n      \"description\": \"Made to store, liquefy, and pressurize sunlight.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Naturally fueled on sunny days\"\n      ]\n    },\n    {\n      \"name\": \"Magnetic Coils\",\n      \"stakes\": 2,\n      \"description\": \"Spinning cylinders that, ideally, maintain a state of almost perpetual motion.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Fueled with magnetic scrap\"\n      ]\n    },\n    {\n      \"name\": \"Rope Golem\",\n      \"stakes\": 2,\n      \"description\": \"A semi-sentient mass of animated ropes running through the rooms and corridors of the ship.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Stealth\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Takes no fuel, but the ropes must be replaced when they begin to fray.\",\n        \"Rope golems have an unpredictable will of their own that may manifest at unexpected moments.\"\n      ]\n    },\n    {\n      \"name\": \"Leviathan Heart\",\n      \"stakes\": 2,\n      \"description\": \"An actual leviathan heart, still beating reflexively, hooked up to the ship. Pumps viscous black fuel through pipes and valves.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Requires no fuel, but in a particularly ominous way.\"\n      ]\n    },\n    {\n      \"name\": \"Ceramic Batteries\",\n      \"stakes\": 2,\n      \"description\": \"Volt-storing batteries rigged up to regulate and distribute power. Their crackling hum makes nearby insects (and superstitious undercrew) uneasy.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Saws\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Seals\",\n          \"value\": 1\n        }\n      ],\n      \"specials\": [\n        \"Fueled with lightning strikes\"\n      ]\n    },\n    {\n      \"name\": \"Acid Maw\",\n      \"stakes\": 2,\n      \"description\": \"An open chemical vat that melts down scrap metal, piping the resulting pressurised slurry around the ship. Potent and almost impossible to interrupt.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Saws\",\n          \"value\": 2\n        }\n      ],\n      \"specials\": [\n        \"Fueled with salvage and scrap\"\n      ]\n    },\n    {\n      \"name\": \"Press Piping\",\n      \"stakes\": 1,\n      \"description\": \"Hardly the most powerful engine around, but one that's extremely easy to fuel for a diligent crew.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Tilt\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Speed\",\n          \"value\": 1\n        },\n        {\n          \"rating\": \"Saws\",\n          \"value\": -1\n        }\n      ],\n      \"specials\": [\n        \"Fuelled with fruit rinds and vegetable skins.\"\n      ]\n    }\n  ],\n  \"motifs\": [\n    {\n      \"name\": \"Transport\",\n      \"stakes\": 2,\n      \"description\": \"No matter what is happening on the waves, no matter the problems or curiosities its denizens face, there will always be a space for those willing to move passengers from point A to point B. Ships themed around transport will likely have...\",\n      \"specials\": [\n        \"A clean and professional paint job to attract potential passengers\",\n        \"Built-in passenger quarters with varying levels of comfort\",\n        \"A sturdily constructed panic room, suitable for holding passengers unwilling to fight in the event the ship is attacked or boarded\"\n      ]\n    },\n    {\n      \"name\": \"Hauling\",\n      \"stakes\": 2,\n      \"description\": \"Just as essential as transporting passengers, the movement and trading of cargo is a reliable path to success for dependable types. These ships will likely have...\",\n      \"specials\": [\n        \"Gangplanks, winches, and bay doors for swift loading and unloading at port\",\n        \"An expanded cargo area with extra security and webbing for odd-shaped packages\",\n        \"A reliable cargo crane built into the ship's structure for holding and transporting particularly heavy crates and objects\"\n      ]\n    },\n    {\n      \"name\": \"Hunting\",\n      \"stakes\": 2,\n      \"description\": \"The oldest wildsea profession, a ship kitted out with a hunting motif will likely have...\",\n      \"specials\": [\n        \"Trophies of bone, fur, or chitin prominently displayed on the outer hull\",\n        \"A modified cargo area complete with animal pens\",\n        \"An array of hunting and butchery tools, allowing crew fighting on or below decks easy access to CQ Keen or Spike damage\"\n      ]\n    },\n    {\n      \"name\": \"Salvaging\",\n      \"stakes\": 2,\n      \"description\": \"Useful for scrappers, dredgers, and wreck-wranglers, salvaging ships will likely have...\",\n      \"specials\": [\n        \"A scratched and dented appearance, making you look almost like a wreck yourself\",\n        \"A modified cargo area with work benches and tools for disassembly\",\n        \"A grappling crane built into the ship's structure for attaching to large wreckage, allowing it to be hauled onto the deck or towed behind the ship\"\n      ]\n    },\n    {\n      \"name\": \"Pathfinding\",\n      \"stakes\": 2,\n      \"description\": \"Pathfinding ships are built with tenacious exploration in mind, and will likely have...\",\n      \"specials\": [\n        \"Trinkets and gewgaws from various contacted cultures affixed to the hull\",\n        \"A reinforced engine room with a secondary set of seals or bulkheads protecting it\",\n        \"An array of wilds-clearing tools, allowing crew fighting on or below decks easy access to Hewing or Serrated damage\"\n      ]\n    },\n    {\n      \"name\": \"Raiding\",\n      \"stakes\": 2,\n      \"description\": \"For wildsailors who take to the waves with violence in mind, for noble or not-so-noble reasons. Ships with a raiding motif will likely have...\",\n      \"specials\": [\n        \"Fortified deck-rails to give the crew cover while shooting (or being shot at)\",\n        \"Bulkhead doors that can be closed and locked to isolate boarding parties\",\n        \"An armoury lockbox containing weapons taken as spoils from previous encounters, allowing crew fighting on or below decks easy access to Blunt or Blast damage\"\n      ]\n    },\n    {\n      \"name\": \"Rescue\",\n      \"stakes\": 2,\n      \"description\": \"Yours is the kind of ship people call on when other ships don't make it back to port. Ships with a rescue motif will likely have...\",\n      \"specials\": [\n        \"Emergency medicine for some of the more common maladies of the waves\",\n        \"A photoscope for picking out glints of wreckage or distress flares at a great distance\",\n        \"An isolation room packed with soft amber resin, for keeping the crew insulated from and slowing the progress of illnesses during a journey\"\n      ]\n    },\n    {\n      \"name\": \"Research\",\n      \"stakes\": 2,\n      \"description\": \"The mysteries of the rustling waves are an egg waiting to hatch, and a research vessel is just the right sort of tool to crack them right open. Research ships will likely have...\",\n      \"specials\": [\n        \"A higher level of general technology on show than average\",\n        \"A library for recording new findings and delving into secrets and lore\",\n        \"A snapograph arrangement, a complex deck-mounted photography system for catching images of the waves and printing them on light-sensitive paper\"\n      ]\n    },\n    {\n      \"name\": \"Entertainment\",\n      \"stakes\": 2,\n      \"description\": \"For actors, musicians, performers, and travelling circuses, those that make their living by entrancing the public. Ships with an entertainment motif will likely have...\",\n      \"specials\": [\n        \"A gaudy appearance that catches the eye\",\n        \"A theatrical stage built into the main deck\",\n        \"Costuming supplies for the representation of various creeds and characters\"\n      ]\n    }\n  ],\n  \"generalAdditions\": [\n    {\n      \"name\": \"Anchor System\",\n      \"stakes\": 0,\n      \"description\": \"Lengths of chain with heavy curved hooks, used to anchor ships to the branches of the Wildsea. Almost every ship comes with this as standard.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Rig-Ropes\",\n      \"stakes\": 1,\n      \"description\": \"Ropes strung up above the deck for various purposes, often climbed, used as safety lines for trips over the edge of the ship, or hung with drying washing.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Firefly Lanterns\",\n      \"stakes\": 1,\n      \"description\": \"A network of lanterns, their glowing inhabitants woken or sent to sleep with a tap on the glass, ready to illuminate any part of the ship.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Luminous Blooms\",\n      \"stakes\": 1,\n      \"description\": \"Patches of moss or flowering plants that shed pale light in the darker hours.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Chemical Spotlight\",\n      \"stakes\": 1,\n      \"description\": \"Illuminates surrounding areas with day-like clarity.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Survival Station\",\n      \"stakes\": 1,\n      \"description\": \"Containing flares, flags, grapples, wraps, and emergency rations.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Cargo Crane\",\n      \"stakes\": 1,\n      \"description\": \"A sturdy crane for loading and unloading cargo, capable of carrying extremely heavy objects without overbalancing the ship.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Wrecker's Magnet\",\n      \"stakes\": 1,\n      \"description\": \"A curious electromagnetic crane, often used by salvagers. Controls on the crane can increase, decrease, or cut the magnetism entirely.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Signal Flares\",\n      \"stakes\": 1,\n      \"description\": \"Colour-coded flares meant to be fired up into the heavens to communicate findings, threats, and positioning. At least a smattering of the Signalling language is required to use or understand them effectively.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Shutter-Lamps\",\n      \"stakes\": 1,\n      \"description\": \"A bank of lights and shutters for blinking visual signals across vast distances. At least a smattering of the Signalling language is required to use or understand them effectively.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Steam Whistle\",\n      \"stakes\": 1,\n      \"description\": \"A shrill, piercing whistle used to announce your presence or scare the more skittish denizens of the sea.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Vox-Horn\",\n      \"stakes\": 1,\n      \"description\": \"A deep, blaring horn that can also be used as an effective voice amplifier.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Tethered Kitesail\",\n      \"stakes\": 1,\n      \"description\": \"A glider tethered to the deck with a long rope, allowing aerial exploration on windy days.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Trained Messengers\",\n      \"stakes\": 2,\n      \"description\": \"Flying creatures trained to seek out distant landmasses (or nearby ships), deliver messages to them, and return with replies. When choosing trained messengers, specify the type of creature you're using (such as dragonflies or crows).\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Fixed-Band Radio\",\n      \"stakes\": 2,\n      \"description\": \"A short-range radio system capable of sending and receiving static-laden signals, based on recently rediscovered pre-verdant technology. Allows instantaneous communication, but relies on fragile antennae affixed to the uppermost portion of the ship.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Irrigation Array\",\n      \"stakes\": 1,\n      \"description\": \"The observant might suggest that this is little more than a series of buckets and pipes jumbled together with leaf-rubber seals. And they'd be right.\",\n      \"specials\": [\n        \"Arid conditions don't negatively affect plant growth within the ship-garden (unless they last for multiple journeys in a row without access to water).\"\n      ]\n    },\n    {\n      \"name\": \"Windvane Rabir\",\n      \"stakes\": 2,\n      \"description\": \"Tailor-made to spin with the winds, producing a musical drone that keeps all but the most unusual garden pests at bay.\",\n      \"specials\": [\n        \"All plants within your plots have a resistance to insect predation and insect-borne diseases.\"\n      ]\n    },\n    {\n      \"name\": \"Catapault Track\",\n      \"stakes\": 1,\n      \"description\": \"A spring-loaded section of deck used for catapulting outriders onto the waves at speed. Great for taking other ships by surprise, but the logistics of reloading an outrider for another launch are... tricky.\"\n    },\n    {\n      \"name\": \"Wicker Baskets\",\n      \"stakes\": 1,\n      \"description\": \"Free-swinging containers that always seem to survive whatever might damage the rest of the ship.\",\n      \"specials\": [\n        \"All plants grown within the wicker baskets are immune to damage taken by the wider ship (but can still suffer negative effects aimed directly at them).\"\n      ]\n    }\n  ],\n  \"bounteousAdditions\": [\n    {\n      \"name\": \"Fruiting Tree\",\n      \"stakes\": 1,\n      \"description\": \"An ancient tree rooted to your deck, laden with fast-growing fruit.\",\n      \"specials\": [\n        \"Automatically acquire a fruit-based specimen when you use a task to tend to the fruiting tree.\"\n      ]\n    },\n    {\n      \"name\": \"Night Farm\",\n      \"stakes\": 1,\n      \"description\": \"A dark, covered soilpit for growing mushrooms.\",\n      \"specials\": [\n        \"Automatically acquire a mushroom-based specimen when you use a task to tend to the night farm.\"\n      ]\n    },\n    {\n      \"name\": \"Lightning Rod\",\n      \"stakes\": 1,\n      \"description\": \"A multi-pronged metal array for attracting lightning and storing it in ceramic batteries.\",\n      \"specials\": [\n        \"Automatically acquire a charged ceramic battery whenever your ship enters a lightning storm.\"\n      ]\n    },\n    {\n      \"name\": \"Water Purifier\",\n      \"stakes\": 2,\n      \"description\": \"A funnel filtration system.\",\n      \"specials\": [\n        \"Automatically acquire a barrel of fresh water with the 'Pure' tag whenever you drop anchor or cut a path in rainy conditions.\"\n      ]\n    },\n    {\n      \"name\": \"Trawler Nets\",\n      \"stakes\": 2,\n      \"description\": \"Reinforced nets meant to be draped over the sides of the ship during relaxed journeys, catching larger insects and small mammals before they're hauled back in.\",\n      \"specials\": [\n        \"Automatically acquire one normal specimen when you cut a path.\"\n      ]\n    }\n  ],\n  \"rooms\": [\n    {\n      \"name\": \"Galley\",\n      \"stakes\": 1,\n      \"description\": \"A space for gathering, cooking, and eating, filled with pans, cookware, and usually a chemical stove.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Medical Bay\",\n      \"stakes\": 1,\n      \"description\": \"A clean space with tables and soft beds for the wounded and their carers.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Workshop\",\n      \"stakes\": 1,\n      \"description\": \"A (probably cluttered) room with smithing and repair tools, as well as a mechanical workbench.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Navigational Suite\",\n      \"stakes\": 1,\n      \"description\": \"A room devoted to the storage and usage of maps, charts, and navigational equipment.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Butchery\",\n      \"stakes\": 1,\n      \"description\": \"A clean space for rendering and preserving specimens.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Tap-Room\",\n      \"stakes\": 1,\n      \"description\": \"For the creation, storage, and consumption of ales, mead, and spirits (the alcoholic kind). Usually furnished with comfortable seating, and maybe card tables.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Panic Room\",\n      \"stakes\": 1,\n      \"description\": \"A small room stocked with salted supplies and bedrolls, able to be triple-locked from the inside and extremely hard to break into.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Cooling Facility\",\n      \"stakes\": 1,\n      \"description\": \"An insulated room where breath mists in the air, perfect for storing perishables and escaping the sun's glare.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Luxury Quarters\",\n      \"stakes\": 1,\n      \"description\": \"Individual spaces for each crewmember to sleep, complete with soft furnishings and tasteful decoration.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Lens Room\",\n      \"stakes\": 1,\n      \"description\": \"A room of telescopes and ocular magnifiers offering a commanding view, a good interior alternative to an observation platform.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Brig\",\n      \"stakes\": 1,\n      \"description\": \"A hammock. A bucket. A lockable door and a set of iron bars. The cramped conditions of most ships rarely allow for much more.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Cargo Bay Extension\",\n      \"stakes\": 1,\n      \"description\": \"A larger space with cargo webbing, wall racks, and reinforced sections for more dangerous items.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Underdeck Gymnasium\",\n      \"stakes\": 1,\n      \"description\": \"A set of weights, ropes, and fitness equipment for keeping yourself in shape without braving the treetops.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Lounger's Tent\",\n      \"stakes\": 1,\n      \"description\": \"A rest area on the deck of the ship, the canvas providing shade and a break from the wind without being cooped up belowdecks.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Observation Platform\",\n      \"stakes\": 1,\n      \"description\": \"A strut-like protuberance giving an unparalleled view of the surrounding waves, usually with some kind of line of communication to the pilot's cabin.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Underthrash Platform\",\n      \"stakes\": 1,\n      \"description\": \"A sturdy door leading to an open platform at the base of the ship, usually at the rear, below the riding-line.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Cupola\",\n      \"stakes\": 1,\n      \"description\": \"A blister of glass or amber, usually at the side or rear of the ship, with a small seat inside.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Deckside Shed\",\n      \"stakes\": 1,\n      \"description\": \"Even more cluttered than the average workshop, sheds come stocked with a variety of simple tools used for the maintenance and preparation of ship-garden plots.\",\n      \"specials\": []\n    },\n    {\n      \"name\": \"Internal Seed Bank\",\n      \"stakes\": 2,\n      \"description\": \"A room not only dedicated to safely storing seeds, but to leeching them of crezzerin contamination through painfully slow but reliable methods used by generations of parasite farmers.\",\n      \"specials\": [\n        \"At the beginning of a journey, choose a single set of seeds with the Wild or Rampant tag. At the end of the journey, those seeds lose their original tag and gain the Parasite tag instead.\"\n      ]\n    }\n  ],\n  \"armaments\": [\n    {\n      \"name\": \"Trebuchet\",\n      \"stakes\": 2,\n      \"description\": \"Lobs stones, chunks of wood, or salvage clusters.\",\n      \"specials\": [\n        \"Deals massive LR Blunt damage\"\n      ]\n    },\n    {\n      \"name\": \"Harpoon Turret\",\n      \"stakes\": 2,\n      \"description\": \"Fires barbed spears for piercing the hulls of ships and the hides of larger creatures.\",\n      \"specials\": [\n        \"Deals massive LR Spike damage\"\n      ]\n    },\n    {\n      \"name\": \"Shrapnel Cannon\",\n      \"stakes\": 2,\n      \"description\": \"Fires clouds of tearing metal, usually just armfuls of scrap offcuts tossed into the barrel.\",\n      \"specials\": [\n        \"Deals massive LR Serrated damage\"\n      ]\n    },\n    {\n      \"name\": \"Viper's Tooth\",\n      \"stakes\": 2,\n      \"description\": \"An unstable weapon that fires corrosive liquid.\",\n      \"specials\": [\n        \"Deals massive LR Acid damage\"\n      ]\n    },\n    {\n      \"name\": \"Grand Blastbow\",\n      \"stakes\": 2,\n      \"description\": \"A crossbow-like emplacement that fires explosive bolts.\",\n      \"specials\": [\n        \"Deals massive LR Blast damage\"\n      ]\n    },\n    {\n      \"name\": \"Storm-Rail\",\n      \"stakes\": 2,\n      \"description\": \"Two huge brass rods wrapped with poorly shielded cables, attached to a voltaic generator.\",\n      \"specials\": [\n        \"Deals massive LR Volt damage\"\n      ]\n    },\n    {\n      \"name\": \"Winch-Claws\",\n      \"stakes\": 1,\n      \"description\": \"A bank of short-range grappling claws on the sides of your ship, used to draw enemy vessels close for boarding.\",\n      \"specials\": [\n        \"A tool to aid in close-range encounters rather than a weapon in its own right\"\n      ]\n    },\n    {\n      \"name\": \"Broadside Cannons\",\n      \"stakes\": 1,\n      \"description\": \"A blast from the half-forgotten past, these banks of cannons can only fire at targets to either side of you.\",\n      \"specials\": [\n        \"Deals massive LR Blunt or Blast damage\"\n      ]\n    },\n    {\n      \"name\": \"Ramming Prow\",\n      \"stakes\": 1,\n      \"description\": \"Allows you to ram creatures (and ships) without danger to your own hull.\",\n      \"specials\": [\n        \"Deals massive CQ Blunt damage\"\n      ]\n    },\n    {\n      \"name\": \"Spearing Prow\",\n      \"stakes\": 1,\n      \"description\": \"A set of reinforced spikes jutting from the front of your ship, for ramming others without danger to your own hull.\",\n      \"specials\": [\n        \"Deals massive CQ Spike damage\"\n      ]\n    },\n    {\n      \"name\": \"Bladed Prow\",\n      \"stakes\": 1,\n      \"description\": \"A wedge-like cutting edge for slicing into enemy ships without danger to your own hull.\",\n      \"specials\": [\n        \"Deals massive CQ Hewing damage\"\n      ]\n    },\n    {\n      \"name\": \"Ripsaw Prow\",\n      \"stakes\": 1,\n      \"description\": \"A serrated leading edge for cutting through enemy ships without danger to your own hull.\",\n      \"specials\": [\n        \"Deals massive CQ Serrated damage\"\n      ]\n    },\n    {\n      \"name\": \"Limited Armoury Rack\",\n      \"stakes\": 2,\n      \"description\": \"A rack stocked with simple weapons.\",\n      \"specials\": [\n        \"When leaving or defending the ship, crewmembers can take a temporary piece of gear with the LR or CQ tag and a single damage type (either Blunt, Keen or Spike). This temporary weapon comes with a two-track and can't be repaired.\"\n      ]\n    },\n    {\n      \"name\": \"Wrecker's Armoury Rack\",\n      \"stakes\": 2,\n      \"description\": \"A rack stocked with less straightforward weapons.\",\n      \"specials\": [\n        \"When leaving or defending the ship, crewmembers can take a temporary piece of gear with the LR or CQ tag and a single damage type (either Hewing, Serrated or Blast). This temporary weapon comes with a two-track and can't be repaired.\"\n      ]\n    },\n    {\n      \"name\": \"Son of Teeth\",\n      \"stakes\": 2,\n      \"description\": \"A microwave cannon. Acts as an energy shield when not shooting. Each shot reduces available shield by 1, recharging 1/day.\",\n      \"bonuses\": [\n        {\n          \"rating\": \"Armour\",\n          \"value\": 3\n        }\n      ],\n      \"specials\": [\n        \"Deals massive LR Salt damage\"\n      ]\n    },\n    {\n      \"name\": \"Crezzercannon\",\n      \"stakes\": 2,\n      \"description\": \"Trying to grow things the old fashioned way? May as well get some use out of all that excess crezzerin...\",\n      \"specials\": [\n        \"Deals massive LR Toxin damage\"\n      ]\n    },\n    {\n      \"name\": \"Badass Outrider\",\n      \"stakes\": 3,\n      \"description\": \"A workhorse with overburner and weapon housing. \",\n      \"specials\": [\n        \"Ratings: Armor 2, Seals 1, Speed 4, Saws 2, Stealth 3, Tilt 2.\",\n        \"Deals Massive LR Spike damage.\",\n        \"A chemical battery for adding extra power to the engines. Used, hopefully, with great caution.\",\n        \"Two personal modifications via workhorse (improved stealth, speed, and tilt).\"\n      ]\n    }\n  ],\n  \"undercrew\": {\n    \"officers\": [\n      {\n        \"name\": \"Skillful Officer [3-Track]\",\n        \"stakes\": 1,\n        \"description\": \"A seasoned wildsailor, likely on the verge of leaving the undercrew and setting out to find a main crew position of their own.\",\n        \"specials\": [\n          \"2 ranks in any skill\",\n          \"1 rank in any other skill\"\n        ]\n      },\n      {\n        \"name\": \"Well-Travelled Officer [3-Track]\",\n        \"stakes\": 1,\n        \"description\": \"An eager contributor to discussions and font of lore, wise in the ways of the wider waves.\",\n        \"specials\": [\n          \"2 ranks in any languages\",\n          \"1 rank in any other language\"\n        ]\n      },\n      {\n        \"name\": \"Experienced Officer [X-Track]\",\n        \"stakes\": 1,\n        \"description\": \"A seasoned wildsailor, likely on the verge of leaving the undercrew and setting out to find a full crew position of their own.\",\n        \"specials\": [\n          \"Any one aspect\",\n          \"An experienced officer's track is equal to the track of the aspect they have access to\"\n        ]\n      },\n      {\n        \"name\": \"Howling Scarecrow [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"It's amazing what you can do with old clothes, a stick, and some stuffing. And terrifying what you can achieve by adding a hungry whisper to the mix.\",\n        \"specials\": [\n          \"All of your plots have resistance to predation from beasts.\"\n        ]\n      }\n    ],\n    \"gangs\": [\n      {\n        \"name\": \"Spear-Fishers [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Tasked with plucking insects and small mammals from the sea as they travel.\",\n        \"specials\": [\n          \"Automatically acquire one normal specimen when you drop anchor\"\n        ]\n      },\n      {\n        \"name\": \"Magnet-Fishers [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Laconic scavengers that prefer the comfort of the deckside to the embrace of the waves.\",\n        \"specials\": [\n          \"Automatically acquire one normal piece of salvage when you drop anchor\"\n        ]\n      },\n      {\n        \"name\": \"Stargazers [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Sky-watching tale-spinners.\",\n        \"specials\": [\n          \"Automatically acquire one normal whisper when you drop anchor\"\n        ]\n      },\n      {\n        \"name\": \"Cartographers [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Navigator-adjuncts tasked with keeping a record of the ship's journeys and surroundings.\",\n        \"specials\": [\n          \"Automatically acquire one normal chart when you drop anchor\"\n        ]\n      },\n      {\n        \"name\": \"Deck Engineers [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Tasked with keeping the ship in working condition.\",\n        \"specials\": [\n          \"Automatically clear one mark from any damaged ship's rating when you drop anchor\"\n        ]\n      },\n      {\n        \"name\": \"Bonesaw Troupe [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Amateur surgeons eager to keep the crew in some semblance of good health.\",\n        \"specials\": [\n          \"A single crewmember can heal a mark from any damaged trait or injury when you drop anchor\"\n        ]\n      },\n      {\n        \"name\": \"Tinker Troupe [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Amateur metalworkers and clothiers, maintaining the crew's possessions as best they can.\",\n        \"specials\": [\n          \"A single crewmember can repair a mark from any gear when you drop anchor\"\n        ]\n      },\n      {\n        \"name\": \"Scholars [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Students working on unlocking the mysteries of the sea.\",\n        \"specials\": [\n          \"You learn a secret of the surrounding waves whenever you drop anchor, supplied by the Firefly\"\n        ]\n      },\n      {\n        \"name\": \"Marauders [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Rough sorts that take the protection of the ship (and the celebrations after a fight) extremely seriously.\",\n        \"specials\": [\n          \"They fight in close combat to defend the ship, gaining focus every now and then to deal CQ Blunt, Keen or Spike damage\"\n        ]\n      },\n      {\n        \"name\": \"Picaros [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Adventurous slingers armed with crossbows, pistols, and blunderbusses.\",\n        \"specials\": [\n          \"They fight at range to defend the ship, gaining focus every now and then to deal LR Blunt, Keen or Spike damage\"\n        ]\n      },\n      {\n        \"name\": \"Greenthumbs [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Apprentice agronauts taking their first steps on a journey of ship-based farming. They're not quite ready for more advanced methods, but they're a dab hand at planting.\",\n        \"specials\": [\n          \"Adding seeds to a ship-garden plot doesn't use a task.\"\n        ]\n      }\n    ],\n    \"packs\": [\n      {\n        \"name\": \"Lemur Pack [3-Track]\",\n        \"stakes\": 1,\n        \"description\": \"A group of nimble helpers that keep the ship clear of smaller insects.\",\n        \"specials\": []\n      },\n      {\n        \"name\": \"Spring-Foxes [3-Track]\",\n        \"stakes\": 1,\n        \"description\": \"A pod of spring-foxes that dance and leap through the waves around your ship as you travel. Their behaviour can warn of dangers from the deeper canopy.\",\n        \"specials\": []\n      },\n      {\n        \"name\": \"A Stretch of Slinks [3-Track]\",\n        \"stakes\": 1,\n        \"description\": \"Semi-spectral cats usually found in dockyards and spit-city alleyways, ship-born slinks spend most of their time hunting down rats and finding ways to get into the most absurdly awkward spaces.\",\n        \"specials\": []\n      },\n      {\n        \"name\": \"A Brace of Hounds [3-Track]\",\n        \"stakes\": 1,\n        \"description\": \"Perhaps not best friend material, these dogs are at least fiercely protective of their ship (despite having few other uses than comfort and the ability to play a great game of fetch).\",\n        \"specials\": []\n      },\n      {\n        \"name\": \"Rig-Ferrets [3-Track]\",\n        \"stakes\": 1,\n        \"description\": \"Used to tie and untie knots far above deck on ships that evoke the feeling of the old salt sea.\",\n        \"specials\": []\n      },\n      {\n        \"name\": \"Whirling Bats [3-Track]\",\n        \"stakes\": 1,\n        \"description\": \"Lend an appreciably gothic look to your ship from a distance, but are unexpectedly friendly up close.\",\n        \"specials\": []\n      },\n      {\n        \"name\": \"Frenzy-Parrot [3-Track]\",\n        \"stakes\": 1,\n        \"description\": \"Possessed of a shrill and annoying squawk, but tolerated as an early warning system for dangerous predators roaming nearby.\",\n        \"specials\": []\n      },\n      {\n        \"name\": \"Trained Pinwolf [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"One of the most dangerous predators of the wildsea, raised from birth to regard a ship as its home and the crew as its pack.\",\n        \"specials\": [\n          \"They fight in close combat to defend the ship, gaining focus every now and then to deal CQ Blunt, Keen or Spike damage\"\n        ]\n      },\n      {\n        \"name\": \"Squirrel Flingers [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Tiny but ferocious, a pack of squirrels armed with miniature slings.\",\n        \"specials\": [\n          \"They fight at range to defend the ship, gaining focus every now and then to deal LR Blunt, Keen or Spike damage\"\n        ]\n      },\n      {\n        \"name\": \"Geist Octopus [5-Track]\",\n        \"stakes\": 3,\n        \"description\": \"A little bit of everything in one cool cephalopackage.\",\n        \"specials\": [\n          \"Once per journey, the geist octopus allows a single crewmember to roll 6d6 in place of their usual dice pool on any task it could conceivably help with\"\n        ]\n      },\n      {\n        \"name\": \"Dragon-Tail Butterflies [5-Track]\",\n        \"stakes\": 1,\n        \"description\": \"Butterflies with beautiful, elongated wings. Don't do anything useful, but are regarded by many as a good-luck charm.\",\n        \"specials\": []\n      },\n      {\n        \"name\": \"Spider Colony [3-Track]\",\n        \"stakes\": 1,\n        \"description\": \"Once a tzelicrae, now barely holding it together, a spider colony can achieve little on a ship other than keeping insects and rodents away.\",\n        \"specials\": []\n      },\n      {\n        \"name\": \"Glass-Shell Snails [3-Track]\",\n        \"stakes\": 1,\n        \"description\": \"Crews with glass-shell snails on board learn to tread lightly, especially at night.\",\n        \"specials\": []\n      },\n      {\n        \"name\": \"Scorpion Set [3-Track]\",\n        \"stakes\": 1,\n        \"description\": \"Surly, patient, and venomous, often found sunning themselves on railings or hiding inside boots.\",\n        \"specials\": []\n      },\n      {\n        \"name\": \"Medical Mosquitoes [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"An annoyance for sure, but a useful one - carry a symptomless infection that increases a crew's resistance to other infections.\",\n        \"specials\": [\n          \"Infections and viruses don't naturally transfer from crewmember to crewmember\"\n        ]\n      },\n      {\n        \"name\": \"Glowbug Parade [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"A horde of fireflies that follow crewmembers around as they traverse decks and corridors.\",\n        \"specials\": [\n          \"Gives all crew members their own dim lantern-like light while they're on the ship (unless shooed away)\"\n        ]\n      },\n      {\n        \"name\": \"Mantis Sentries [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Stone-still sentries that let their prey come to them, waiting for the perfect moment to strike.\",\n        \"specials\": [\n          \"Automatically acquire one normal specimen when you dock at port.\"\n        ]\n      },\n      {\n        \"name\": \"Rust-Roaches [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Feeding off of rust and metallic impurities, these tenacious little things tend to root out forgotten pieces of scrap for their meals.\",\n        \"specials\": [\n          \"Automatically acquire one normal piece of salvage when you dock at port.\"\n        ]\n      },\n      {\n        \"name\": \"Etterescu [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Lurking centipedes that prefer darker places, listening to secrets and fragments of lore.\",\n        \"specials\": [\n          \"Automatically acquire one normal whisper when you dock at port.\"\n        ]\n      },\n      {\n        \"name\": \"Library Boatmen [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Spider-like creatures that have a habit of making their homes in discarded paper plucked from the waves.\",\n        \"specials\": [\n          \"Automatically acquire one normal chart when you dock at port.\"\n        ]\n      },\n      {\n        \"name\": \"Golden Ladybugs [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"Many years of trial and error have taught these hungry little things to target new-grown weeds above all else.\",\n        \"specials\": [\n          \"All of your plots have resistance to weeds.\"\n        ]\n      },\n      {\n        \"name\": \"Kleptothermic Dromats [3-Track]\",\n        \"stakes\": 2,\n        \"description\": \"A horde of thumb-sized bats with incredible control over their own body temperature, and the ability to store and expel water to keep their environment suitably stable for their young. Trained to nest within plots.\",\n        \"specials\": [\n          \"All of your plots have resistance to weather hazards.\"\n        ]\n      }\n    ]\n  }\n}"
          },
