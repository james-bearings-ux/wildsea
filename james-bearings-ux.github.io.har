          "content": {
            "size": 5501,
            "mimeType": "application/vnd.pgrst.object+json",
            "text": "{\"id\":\"9ef7cec6-42c7-42f1-b2fe-bf8d7d704f69\",\"session_id\":\"ba8b7220-b27f-4c8c-b89e-9dc5eac93970\",\"name\":\"Haiku Matcha\",\"mode\":\"play\",\"bloodline\":\"Ardent\",\"origin\":\"Ridgeback\",\"post\":\"Steep\",\"selected_aspects\":[{\"id\": \"Steep-Ossein Kettles\", \"name\": \"Ossein Kettles\", \"type\": \"Gear\", \"track\": 2, \"source\": \"Steep\", \"category\": \"Post\", \"trackSize\": 2, \"description\": \"This heirloom, eternities old, is used to create beverages that warm more than your body. Triumphs on rolls to concoct grant a Whisper.\", \"damageStates\": [\"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Steep-Anima Presence\", \"name\": \"Anima Presence\", \"type\": \"Trait\", \"track\": 2, \"source\": \"Steep\", \"category\": \"Post\", \"trackSize\": 2, \"description\": \"Spirits can always see and hear you, just as you can see and hear them\", \"damageStates\": [\"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ridgeback-Crushing Blows\", \"name\": \"Crushing Blows\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Ridgeback\", \"category\": \"Origin\", \"trackSize\": 4, \"damageTypes\": {\"range\": \"CQ\", \"options\": [\"Blunt\", \"Salt\"], \"category\": \"dealing\", \"selectionType\": \"fixed\"}, \"description\": \"Your fists and feet are the only weapons you need. They deal CQ blunt and salt damage.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ardent-Strong Stomach\", \"name\": \"Strong Stomach\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Ardent\", \"category\": \"Bloodline\", \"trackSize\": 3, \"description\": \"Reduce the impact of poisons, diseases and sickness.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Steep-Steam-Familiar\", \"name\": \"Steam-Familiar\", \"type\": \"Companion\", \"track\": 4, \"source\": \"Steep\", \"category\": \"Post\", \"trackSize\": 4, \"description\": \"Warmth, wonder, and moisture are familiar to a Steep, and sometimes the spirits they call linger on to comfort others. Mark to neutralize the effects of bad air, spores, or cold.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ridgeback-Archaeodermis\", \"name\": \"Archaeodermis\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Ridgeback\", \"category\": \"Origin\", \"trackSize\": 3, \"customized\": true, \"damageTypes\": [{\"options\": [\"Keen\"], \"category\": \"immunity\", \"selectionType\": \"fixed\"}], \"description\": \"Your skin (or whatever you have as an outer covering) mimics the mountain you were raised on. You're immune to keen damage, as well as bites and stings from small creatures.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ardent-Ironclad Mind\", \"name\": \"Ironclad Mind & Body\", \"type\": \"Trait\", \"track\": 4, \"source\": \"Ardent\", \"category\": \"Bloodline\", \"trackSize\": 4, \"customized\": true, \"damageTypes\": [{\"options\": [\"Hallucinations\", \"Mesmerics\", \"Mental compulsions\"], \"category\": \"immunity\", \"selectionType\": \"fixed\"}], \"description\": \"You are immune to hallucinations, mesmerics and mental compulsions. You’re a natural survivor. Rolls made to treat or heal an injury you're suffering from treat conflicts as triumphs.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}],\"selected_edges\":[\"Iron\", \"Grace\", \"Instinct\"],\"skills\":{\"Hunt\": 1, \"Tend\": 2, \"Brace\": 1, \"Break\": 1, \"Sense\": 2, \"Vault\": 1, \"Outwit\": 1, \"Concoct\": 3, \"Harvest\": 2, \"Scavenge\": 1},\"languages\":{\"Low Sour\": 3},\"drives\":[\"Solve problems in ardent settlements\", \"Climb the highest peaks\", \"Bring calm to others in the midst of turbulence\"],\"mires\":[{\"text\": \"Your mind turns to sacrifice in times of trouble\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"Paranoia engulfs you - has something taken root?\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"The call of the under-eaves is strong\", \"checkbox1\": false, \"checkbox2\": false}],\"milestones\":[{\"id\": \"1761073534742\", \"name\": \"Mustachios\", \"used\": true, \"scale\": \"Minor\"}, {\"id\": \"1761073544964\", \"name\": \"Incisor's Run\", \"used\": false, \"scale\": \"Major\"}, {\"id\": \"1761073552976\", \"name\": \"SandFlea\\t\\t\\t\\t\\t\", \"used\": true, \"scale\": \"Major\"}],\"resources\":{\"charts\": [], \"salvage\": [{\"id\": \"68e111bb-5164-4d32-b176-e70c60477eae\", \"name\": \"Olive Oil\", \"used\": false}, {\"id\": \"e072fd0a-1bb7-4c77-813f-cb031b4463c1\", \"name\": \"Coconado\", \"used\": false}, {\"id\": \"99a02d86-bb13-40c9-88a1-92fdbc774f00\", \"name\": \"Nostalgic Train Whistle\", \"used\": false}], \"whispers\": [{\"id\": \"13264966-846e-4a71-9e78-ae41e97e0a12\", \"name\": \"The Perfect Ambush\"}, {\"id\": \"0d858dba-ba50-4c6c-a62b-e0eb4611d315\", \"name\": \"The Comforting Dark\"}, {\"id\": \"90dd8e57-8ca1-414d-82ef-305014d09da7\", \"name\": \"A Monument to Travel\"}, {\"id\": \"1762393059680\", \"name\": \"Crowned and Proud\", \"used\": false}, {\"id\": \"1762393381622\", \"name\": \"Unsettling movement\", \"used\": false}], \"specimens\": [{\"id\": \"3e28b103-5233-4a0d-9b1b-ef9c3512cccb\", \"name\": \"1 Bottle of The Shining\"}, {\"id\": \"ceaf4437-8f0c-4e85-91bb-cb7ee47de280\", \"name\": \"1 Bottle of Wild Hunt Mead\", \"used\": true}, {\"id\": \"567a6552-cda8-4453-8cb0-e6336e4d9823\", \"name\": \"Fanglike Thorn\"}]},\"created_at\":\"2025-10-18T14:13:03.410994+00:00\",\"updated_at\":\"2025-11-06T02:14:45.664+00:00\",\"tasks\":[{\"id\": \"1761073523996\", \"name\": \"Add damage box to Crushing Blows (3 minor =1 Box / Add Damage costs 1 Box)\", \"editing\": false, \"maxTicks\": 3, \"currentTicks\": 3}, {\"id\": \"1762395262071\", \"name\": \"make \\\"wicker baskets\\\" 1 stake add-on\", \"editing\": false, \"maxTicks\": 4, \"currentTicks\": 0}],\"notes\":\"\",\"journey_role\":\"watch-the-weather\"}"
