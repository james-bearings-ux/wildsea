            "mimeType": "application/vnd.pgrst.object+json",
            "text": "{\"id\":\"486a0e61-4be1-470a-931d-382ab64239ac\",\"session_id\":\"ba8b7220-b27f-4c8c-b89e-9dc5eac93970\",\"name\":\"Ginger\",\"mode\":\"play\",\"bloodline\":\"Ardent\",\"origin\":\"Amberclad\",\"post\":\"Alchemist\",\"selected_aspects\":[{\"id\": \"Ardent-Ironclad Mind\", \"name\": \"Ironclad Mind\", \"type\": \"Trait\", \"track\": 4, \"source\": \"Ardent\", \"category\": \"Bloodline\", \"trackSize\": 4, \"damageTypes\": {\"options\": [\"hallucinations\"], \"category\": \"immunity\", \"selectionType\": \"fixed\"}, \"description\": \"You are immune to hallucinations, mesmerics and mental compulsions.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ardent-Sporescarf\", \"name\": \"Sporescarf\", \"type\": \"Gear\", \"track\": 4, \"source\": \"Ardent\", \"category\": \"Bloodline\", \"trackSize\": 4, \"damageTypes\": {\"options\": [\"bad air\", \"airborne spores\"], \"category\": \"resistance\", \"selectionType\": \"fixed\"}, \"description\": \"Thickly-woven fibres sealed with tar. Resist the effects of bad air and airborne spores.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Amberclad-Endless Golden Age\", \"name\": \"Endless Golden Age\", \"type\": \"Trait\", \"track\": 5, \"source\": \"Amberclad\", \"category\": \"Origin\", \"trackSize\": 5, \"description\": \"You didn't age throughout your imprisonment, and you don't seem to be aging now you're free either. A blessing, but a curious one.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Amberclad-Heart of Resin\", \"name\": \"Heart of Resin\", \"type\": \"Gear\", \"track\": 1, \"source\": \"Amberclad\", \"category\": \"Origin\", \"trackSize\": 1, \"description\": \"Burn to create a perfect copy of yourself in living amber and drift into a deep sleep. You control the copy until it dies or you choose to destroy it, upon which time you wake with its memories and experiences as dreams.\", \"damageStates\": [\"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ardent-Strong Stomach\", \"name\": \"Strong Stomach\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Ardent\", \"category\": \"Bloodline\", \"trackSize\": 3, \"description\": \"Reduce the impact of poisons, diseases and sickness.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}],\"selected_edges\":[\"Iron\", \"Veils\", \"Instinct\"],\"skills\":{\"Sway\": 2, \"Tend\": 2, \"Delve\": 1, \"Sense\": 3, \"Study\": 1, \"Outwit\": 1, \"Concoct\": 1, \"Flourish\": 2, \"Wavewalk\": 1},\"languages\":{\"Highvin\": 3, \"Chthonic\": 3, \"Low Sour\": 3},\"drives\":[\"\", \"\", \"\"],\"mires\":[{\"text\": \"\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"\", \"checkbox1\": false, \"checkbox2\": false}],\"milestones\":[],\"resources\":{\"charts\": [], \"salvage\": [], \"whispers\": [], \"specimens\": []},\"created_at\":\"2025-11-06T11:21:01.507971+00:00\",\"updated_at\":\"2025-11-06T11:32:49.528+00:00\",\"tasks\":[],\"notes\":\"\",\"journey_role\":\"\"}"
