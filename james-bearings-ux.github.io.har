            "mimeType": "application/vnd.pgrst.object+json",
            "text": "{\"id\":\"b9320ea5-6837-46b9-92a9-65f7c7e40a72\",\"session_id\":\"ba8b7220-b27f-4c8c-b89e-9dc5eac93970\",\"name\":\"Chicago\",\"mode\":\"play\",\"bloodline\":\"Ardent\",\"origin\":\"Amberclad\",\"post\":\"Agronaut\",\"selected_aspects\":[{\"id\": \"Amberclad-Endless Golden Age\", \"name\": \"Endless Golden Age\", \"type\": \"Trait\", \"track\": 5, \"source\": \"Amberclad\", \"category\": \"Origin\", \"trackSize\": 5, \"description\": \"You didn't age throughout your imprisonment, and you don't seem to be aging now you're free either. A blessing, but a curious one.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ardent-Ironclad Mind\", \"name\": \"Ironclad Mind\", \"type\": \"Trait\", \"track\": 4, \"source\": \"Ardent\", \"category\": \"Bloodline\", \"trackSize\": 4, \"damageTypes\": [{\"options\": [\"Hallucinations\", \"Mesmerics\", \"Mental compulsions\"], \"category\": \"immunity\", \"selectionType\": \"fixed\"}], \"description\": \"You are immune to hallucinations, mesmerics and mental compulsions.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ardent-Strong Stomach\", \"name\": \"Strong Stomach\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Ardent\", \"category\": \"Bloodline\", \"trackSize\": 3, \"description\": \"Reduce the impact of poisons, diseases and sickness.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Agronaut-Green Mile\", \"name\": \"Green Mile\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Agronaut\", \"category\": \"Post\", \"trackSize\": 3, \"description\": \"Once per journey, replace the results of a watch roll with the Peace outcome. If you finish a journey without using this option, remove a negative tag from any one plant growing on your ship.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Ardent-Sporescarf\", \"name\": \"Sporescarf\", \"type\": \"Gear\", \"track\": 4, \"source\": \"Ardent\", \"category\": \"Bloodline\", \"trackSize\": 4, \"damageTypes\": {\"options\": [\"bad air\", \"airborne spores\"], \"category\": \"resistance\", \"selectionType\": \"fixed\"}, \"description\": \"Thickly-woven fibres sealed with tar. Resist the effects of bad air and airborne spores.\", \"damageStates\": [\"default\", \"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Agronaut-Soothing Harvester\", \"name\": \"Soothing Harvester\", \"type\": \"Trait\", \"track\": 3, \"source\": \"Agronaut\", \"category\": \"Post\", \"trackSize\": 3, \"description\": \"Plants grown aboard your ship (or body) are immune to blight and sickness. Mark to improve the rarity of any plant-based specimen you acquire from plots.\", \"damageStates\": [\"default\", \"default\", \"default\"], \"selectedDamageTypes\": {}}, {\"id\": \"Agronaut-Delicate Step\", \"name\": \"Delicate Step\", \"type\": \"Trait\", \"track\": 2, \"source\": \"Agronaut\", \"category\": \"Post\", \"trackSize\": 2, \"description\": \"You disturb no leaves and leave no footprints. You gain resistance to the hazardous effects of crezzerin, and increase impact on actions taken to move through densely forested areas.\", \"damageStates\": [\"default\", \"default\"], \"selectedDamageTypes\": {}}],\"selected_edges\":[\"Sharps\", \"Instinct\", \"Tides\"],\"skills\":{\"Cook\": 1, \"Sway\": 1, \"Tend\": 2, \"Delve\": 1, \"Sense\": 1, \"Study\": 3, \"Outwit\": 1, \"Harvest\": 2, \"Flourish\": 1, \"Wavewalk\": 1},\"languages\":{\"Highvin\": 3, \"Chthonic\": 3, \"Low Sour\": 3},\"drives\":[\"\", \"\", \"\"],\"mires\":[{\"text\": \"\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"\", \"checkbox1\": false, \"checkbox2\": false}, {\"text\": \"\", \"checkbox1\": false, \"checkbox2\": false}],\"milestones\":[],\"resources\":{\"charts\": [], \"salvage\": [], \"